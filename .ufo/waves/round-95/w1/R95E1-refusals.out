$ python3 -I /fast/scratch/hyaku/tameshi-r95/R95E1/double-pin.py --conjuncts   # second pin line inserted before the __main__ guard, pin NOT recomputed
C1_SETUP self-pin-line-count
C1_R95_PASS=false
exit=2

$ python3 -I /fast/scratch/hyaku/tameshi-r95/R95E1/edit-one-byte.py --conjuncts   # one byte edited outside the pin line, pin NOT recomputed
C1_SETUP self-pin-mismatch
C1_R95_PASS=false
exit=2
