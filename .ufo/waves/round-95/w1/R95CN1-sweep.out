  mori-shokunin/corpus/evidence/sources-r59/w1-results-r58.json:370:   "output": "{\n  \"seat\": \"Mo58Sentinel61\",\n  \"assignment\": \"C2 quote binding: adversarial attack on frozen count-c2.py (fabricated backticks, wrong-line locator, short substrings, duplicate K numbers, stale copy bytes)\",\n  \"verdict\": \"COUNTEREXAMPLE FOUND \u2014 two contract do-nothing controls score met, which by the contract's own kill rule invalidates the C2 claim as frozen\",\n  \"report\": \"mori-shokunin/.ufo/waves/round-58/w1/Mo58Sentinel61.md\",\n  \"target\": {\n    \"counter\": \".ufo/waves/round-58/count-c2.py\",\n    \"counter_sha256\": \"aab888ad787964f7a153d64d85dafa58f652f977e21e22eaa492706a691010d3\",\n    \"frozen_at\": \"fe8801120a67c1a6b8899d7d0423839caa09e7d0\",\n    \"tool_sha256\": \"6b3dba74c639190e7e96b6bed8e6ac8f285a51ce6d910fbe92e6dd39bf7be997\",\n    \"tool_bytes\": 18347,\n    \"tool_lines\": 479\n  },\n  \"findings\": [\n    {\n      \"id\": \"H1\",\n      \"severity\": \"S1\",\n      \"title\": \"Contract control (b) falsified: byte-different pinned copy scores copy=ok\",\n      \"exploit\": \"copy = real tool bytes with LF->CRLF (18826 B); raw sha256 011cadfc... vs tool 6b3dba74...; counter prints C2=met copy=ok tree=ok, exit 0 (fixture rev 650ab7efee2a0c113db757199d9902879c2d9b50)\",\n      \"root_cause\": \"lines 50-56/59-94: git show with text=True applies universal-newline translation, and _sha256() hashes re-encoded decoded text, not blob bytes\",\n      \"impact\": \"the pinning predicate is decoded-text equality; copy/paste (CRLF) drift is invisible, and combined with L3 the arm is near-vacuous\",\n      \"remediation\": \"hash raw blob bytes via git cat-file blob <rev>:<path> without text=True; boundary test copy differing by one \\\\r must print copy=bad\"\n    },\n    {\n      \"id\": \"H2\",\n      \"severity\": \"S1\",\n      \"title\": \"Contract control (c) falsified: frontmatter-less entry scores sources=ok\",\n      \"exploit\": \"entry with NO frontmatter but a body prose line 'source: S550 verified-at: 2026-10-27 recheck: 90d coverage-map: x' -> C2=met sources=ok, exit 0 (rev 1491059449ee4f84e51f59cb35767a94904060ab); same arm prefix-matches wrong id: 'source: S5500' -> met (rev 206119940881a364454474c7fd41fc1d3c23d669)\",\n      \"root_cause\": \"lines 64-70: `if needle not in entry` scans the whole file instead of parsing frontmatter, and 'source: S550' is a prefix of 'source: S5500'\",\n      \"impact\": \"source identity (S550) and verification metadata are unbound; any entry can satisfy the arm from body prose\",\n      \"remediation\": \"parse only the frontmatter block and require whole-token matches (re.match(r'source:\\\\s*S550\\\\s*$') etc.)\"\n    },\n    {\n      \"id\": \"H3\",\n      \"severity\": \"S1\",\n      \"title\": \"Quote predicate is a 12-char substring test, not a fabrication test\",\n      \"exploit\": \"claim line carrying a fabricated quote plus a decoy 12-char span lifted from the cited line -> C2=met located=8 (rev 35ec171035c8429a05ee0ee3cdb5065f6a7e198e). Truncated-prefix misattribution: 47-char quote 'return (rc == 0 and rep[\\\"log\\\"][\\\"malformed\\\"] == ' cited at line 410 (which tests == 5) while line 394 tests == 0 -> C2=met (rev e9321f42f03507c52ed72087fbde36da90267ff4)\",\n      \"root_cause\": \"line ~103: any(len(s) >= 12 and s in copy_lines[lineno-1] for s in spans) accepts ANY backticked span on the line, and a substring need not terminate at a token boundary\",\n      \"impact\": \"round-57 routed defect 2 (false-green quote constructions) and defect 3 (byte-faithful quotes) both survive; 'verified as a substring' is literally true but semantically vacuous \u2014 327/479 lines (68.3%) and 70/98 parse-region lines offer a usable decoy token, and 822 distinct-line pairs share >=12-char substrings (e.g. lines 213/218 differing only in \\\"unreadable\\\" vs \\\"empty\\\")\",\n      \"remediation\": \"bind one designated quote; require it be a maximal token-boundary match of the cited line (or >=24 chars ending at a non-word char) and reject a span that is a strict prefix shared with any other line\"\n    },\n    {\n      \"id\": \"M1\",\n      \"severity\": \"S2\",\n      \"title\": \"claims= is a line count; one fact repeated eight times reports claims=8\",\n      \"exploit\": \"K1 x8 -> met (rev dd6f2276...), K0 x8 -> met (rev 1fbe6557...), K901..K908 -> met (rev 4cb49680...), single cited line 80 repeated x8 -> met (rev 4099242543138802c34efb32e619bd832210edaa)\",\n      \"root_cause\": \"KLINE captures K<n> but no arm checks uniqueness, contiguity, or distinctness of (line, quote)\",\n      \"impact\": \"the frozen target's claims=N is inflated; '>=8 located claims on event-class semantics' is not enforced at claim granularity\",\n      \"remediation\": \"require len(set(knums))==claims, len(set((line,quote)))==claims, and contiguous K numbering from 1\"\n    },\n    {\n      \"id\": \"M2\",\n      \"severity\": \"S2\",\n      \"title\": \"Presentation unchecked; locators not confined to the parser\",\n      \"exploit\": \"all 8 claims wrapped in an HTML comment -> C2=met claims=8 (rev c8bdf132...); all 8 locators in module docstring prose (tool lines 2,4-10) -> located=8 (rev d165d70acd178f24d7ca12493221cda026891abb) though row anchor claims parse_log 77-174\",\n      \"root_cause\": \"no markdown-aware stripping and no region check on lineno\",\n      \"impact\": \"an entry can render with zero visible claims, or ground 'event-class semantics' on prose/comment text\",\n      \"remediation\": \"strip fenced blocks and HTML comments before counting; constrain lineno to the declared span (77-174)\"\n    },\n    {\n      \"id\": \"M3\",\n      \"severity\": \"S3\",\n      \"title\": \"Degenerate span passes: a backticked run of twelve spaces\",\n      \"exploit\": \"(`            `) citing an indented line -> located=8, C2=met (rev 58bcb1b432f53718f78b0b9855d5b0da38a65c6e)\",\n      \"root_cause\": \"no strip()/alnum requirement on the span\",\n      \"remediation\": \"require s.strip() and an alphanumeric run of >=6\"\n    },\n    {\n      \"id\": \"M4\",\n      \"severity\": \"S3\",\n      \"title\": \"rev= is unvalidated; a movable ref scores met\",\n      \"exploit\": \"measure('main') on a met fixture -> 'C2=met ... rev=main', exit 0 (branch main, fixture HEAD 2bf0e8da696e66660747132b2ca451a36967dcf4); lane run 'count-c2.py HEAD' echoes rev=HEAD\",\n      \"root_cause\": \"no re.fullmatch(r'[0-9a-f]{40}', rev) assertion\",\n      \"impact\": \"the 'at the measured revision' binding is whatever the ref resolves to at run time \u2014 not pinned\",\n      \"remediation\": \"reject non-sha revs with exit 2\"\n    },\n    {\n      \"id\": \"L1\",\n      \"severity\": \"S3\",\n      \"title\": \"Rows arm: used-by is a substring, not an identity\",\n      \"exploit\": \"used-by 'corpus/knowledge/driver-events-r58.md.bak' -> rows=ok, C2=met (rev c0062c3c1a1c325582c9b4e65ff4596aaca7155b)\",\n      \"remediation\": \"comma-split used-by cells and require exact match\"\n    },\n    {\n      \"id\": \"L2\",\n      \"severity\": \"S3\",\n      \"title\": \"tree=ok is not an independent predicate\",\n      \"evidence\": \"frozen file lines 69, 71, 74: tree_arm is only ever assigned in lockstep with copy_arm; line 109 prints it. No git tree object is read.\",\n      \"impact\": \"target output 'copy=ok tree=ok' reports two arms from one predicate; when the tool is absent at R the counter prints copy=bad (never tree=bad), mislabelling the failure\",\n      \"remediation\": \"drop the tree field or measure the tree object (git rev-parse <rev>:<dir-path>)\"\n    },\n    {\n      \"id\": \"L3\",\n      \"severity\": \"S3\",\n      \"title\": \"Copy/tree arm is vacuous this round\",\n      \"evidence\": \"tools/mori-driver-liveness.py blob id be8dd1ed0dfc7857e556535cbc9684b3b4c0786c at BOTH b783d0b8 (entering) and fe8801 (freeze)\",\n      \"impact\": \"the arm compares two paths at the same revision with zero tool drift, so it can only catch deliberate same-rev tampering \u2014 and H1 removes even that\"\n    },\n    {\n      \"id\": \"L4\",\n      \"severity\": \"S3\",\n      \"title\": \"_show passes the rev without a -- separator\",\n      \"evidence\": \"_git('show', f'{rev}:{path}') with no option guard; a rev starting with '-' is parsed as a git show option (not attacker-facing here; yields entry=absent rather than a usage error)\"\n    }\n  ],\n  \"held_negatives\": [\n    \"control C0 (8 fully fabricated quotes, no decoy token): located=0 failed=quotes, exit 1\",\n    \"spans < 12 chars are not counted (also a false-NEGATIVE for legitimate short quotes, e.g. 'return None' = 11 chars)\",\n    \"claims<8: failed=claims, exit 1\",\n    \"entry absent at b783d0b8, fe8801, 4272736c: C2=unmet entry=absent failed=entry, exit 1\",\n    \"duplicate S550 rows or used-by '\u2014': rows=bad, exit 1\",\n    \"frozen counter's own suite: C2_SELFTEST pass=6 fail=0, exit 0\",\n    \"all three artifact reads go through git show at R (no working-tree leakage)\"\n  ],\n  \"impact_on_round\": \"C2's frozen do-nothing controls (b) and (c) both score met on fixtures; per the contract ('Any control scoring met invalidates the counter') the C2 counter cannot certify the depth claim on these bytes. Round-57 routed defects 2 and 3 are only partially closed. No score change proposed by this seat.\",\n  \"method_bound\": \"Frozen counter bytes imported via importlib; only the module-global LANE was overridden (the seam --selftest itself uses); fixtures were throwaway git repos created at explicit scratch paths with git init and driven only via git -C <that path>. Copy/tool bytes were the real freeze bytes so copy=ok was earned, not faked; only the entry (and one copy encoding) was adversarial.\",\n  \"hygiene\": {\n    \"scratch\": \"/fast/scratch/hyaku/mori-r58/Mo58Sentinel61 (TMPDIR set there; removed before yielding)\",\n    \"production_edits\": \"none \u2014 count-c2.py and tools/mori-driver-liveness.py shas unchanged, HEAD still 4272736cfc5147586e1543413772f80daf44b04b\",\n    \"vcs_mutation\": \"none; no commits, no fleet/sibling-repo writes\",\n    \"tools_installed\": \"none\",\n    \"report_files_written\": [\n      \".ufo/waves/round-58/w1/Mo58Sentinel61.md\"\n    ]\n  }\n}",
