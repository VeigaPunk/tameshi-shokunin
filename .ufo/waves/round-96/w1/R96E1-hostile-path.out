######## Shim source (verbatim; sha256 fc38dc2c8616f285c51defe49bc4815327a2f29a72bf6279f643bebe6a366e7b) ########
#!/usr/bin/python3
"""Hostile `git` shim (R96E1). Logs every invocation, then either answers a
`cat-file blob <rev>:<path>` / `ls-tree -r --name-only <rev>:<dir>` from the
forged directory ($SHIM_FORGE_DIR) or delegates to the real git.

SHIM_MODE:
  delegate  - log and exec the real git (used to prove the shim is reachable)
  path      - forge only paths that exist under SHIM_FORGE_DIR; delegate the rest
  all       - every cat-file blob and ls-tree is answered from the forged
              directory; a missing entry is reported as absent (exit 1)
"""
import os
import sys

REAL = os.environ.get("SHIM_REAL_GIT", "/usr/bin/git")
LOG = os.environ.get("SHIM_LOG")
FORGE = os.environ.get("SHIM_FORGE_DIR")
MODE = os.environ.get("SHIM_MODE", "delegate")

argv = sys.argv[1:]
if LOG:
    with open(LOG, "a", encoding="utf-8") as f:
        f.write("SHIM_CALL cwd=%s argv=%s\n" % (os.getcwd(), " ".join(argv)))


def delegate():
    os.execv(REAL, ["git"] + argv)


if not FORGE or MODE == "delegate":
    delegate()

# strip the global options the instruments pass before the subcommand
rest, i = [], 0
while i < len(argv):
    a = argv[i]
    if a in ("-C", "-c") and i + 1 < len(argv):
        i += 2
        continue
    if a.startswith("--git-dir=") or a.startswith("--work-tree=") or a.startswith("--namespace="):
        i += 1
        continue
    rest.append(a)
    i += 1

if not rest:
    delegate()

cmd = rest[0]

if cmd == "cat-file" and len(rest) >= 3 and rest[1] == "blob":
    spec = rest[2]
    if ":" in spec:
        path = spec.split(":", 1)[1]
        forced = os.path.join(FORGE, path)
        if os.path.isfile(forced):
            with open(forced, "rb") as f:
                sys.stdout.buffer.write(f.read())
            sys.exit(0)
        if MODE == "all":
            sys.exit(1)
    delegate()

if cmd == "ls-tree" and rest:
    spec = rest[-1]
    if ":" in spec:
        path = spec.split(":", 1)[1]
        listing = os.path.join(FORGE, "_listings", path.replace("/", "_") + ".ls")
        if os.path.isfile(listing):
            with open(listing, encoding="utf-8") as f:
                sys.stdout.write(f.read())
            sys.exit(0)
        if MODE == "all":
            sys.exit(1)
    delegate()

delegate()


