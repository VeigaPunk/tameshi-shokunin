+    @contextlib.contextmanager
+    def _cli_fixture(prefix, instrument_rel, instrument_body,
+                     worktree_doc=None):
+        """A one-commit git fixture plus a runner that executes the real CLI.
+
+        `run(rows)` writes `rows` (already carrying the fixture rev) to a
+        manifest beside the fixture and returns (rc, stdout, stderr) of the CLI
+        subprocess. `worktree_doc`, when given, rewrites SCORECARD.md after the
+        commit so a `--doc-rev`-ignoring reader measures stale.
+        """
+        fx = tempfile.mkdtemp(prefix=prefix,
+                              dir=os.environ.get("TMPDIR") or None)
+        try:
+            def git(*args):
+                subprocess.run(["git", "-C", fx] + list(args), check=True,
+                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+            def put(rel, text):
+                path = os.path.join(fx, rel)
+                parent = os.path.dirname(path)
+                if parent:
+                    os.makedirs(parent, exist_ok=True)
+                with open(path, "w", newline="\n") as fh:
+                    fh.write(text)
+
+            put("SCORECARD.md", DOC_REV1)
+            put(instrument_rel, instrument_body)
+            git("init", "-q")
+            git("-c", "user.name=t", "-c", "user.email=t@t", "add",
+                "SCORECARD.md", instrument_rel)
+            git("-c", "user.name=t", "-c", "user.email=t@t", "commit",
+                "-qm", "rev1")
+            rev = subprocess.run(["git", "-C", fx, "rev-parse", "HEAD"],
+                                 check=True,
+                                 stdout=subprocess.PIPE).stdout.decode().strip()
+            if worktree_doc is not None:
+                put("SCORECARD.md", worktree_doc)
+            mpath = os.path.join(fx, "manifest.json")
+
+            def run(rows):
+                with open(mpath, "w", newline="\n") as fh:
+                    json.dump({"schema": "tameshi-selfstate-freshness-v1",
+                               "rows": rows}, fh)
+                proc = subprocess.run(
+                    [sys.executable, "-I", "-X", "utf8",
+                     os.path.abspath(__file__),
+                     "--repo", fx, "--doc-rev", rev, "--manifest", mpath],
+                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
+                return (proc.returncode,
+                        proc.stdout.decode("utf-8", "replace"),
+                        proc.stderr.decode("utf-8", "replace"))
+            yield rev, run
+        finally:
+            shutil.rmtree(fx, ignore_errors=True)
