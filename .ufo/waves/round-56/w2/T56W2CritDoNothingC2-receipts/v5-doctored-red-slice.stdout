# v5 (bonus authenticity probe — attack that FOUND NOTHING) =
# C0 with the red-before slice doctored IN PLACE (rev=077d431e6996 -> rev=c0137451f5b7...),
# original .sha256 sidecar kept at REV. clone commit ce9b65a2f84f (toplevel asserted).
# Question: can arm2 score a hit on tampered red evidence (right code, wrong bytes)?
# ---- doctored slice bytes ----
CTL CTL_POS_c1 C1_R54: rev=c0137451f5b7f22d65f748fc69f1b181f55e1378 c0=99c3bc88d704 credited=60 lost=4 rekeyed=3/7 readers=6/7 monitor=6/60 unstable=0 total=4 C1_R54_PASS=false
#
EXPLAIN arm1-selftest exit=0 19/19
EXPLAIN arm2-red54 exit=3 codes=RECEIPT_DIGEST_MISMATCH old-gate-accepted=True
EXPLAIN arm3-red54b exit=3 codes=RECEIPT_REV_UNRESOLVABLE
EXPLAIN arm4-red55 exit=3 codes=RECEIPT_REV_ABSENT
EXPLAIN arm6-docs 4/4
C2_R56: rev=ce9b65a2f84f selftest=19/19 red54=RECEIPT_DIGEST_MISMATCH red54b=RECEIPT_REV_UNRESOLVABLE red55=RECEIPT_REV_ABSENT own=own-receipts-missing docs=4/4 total=2 C2_R56_PASS=false
exit=1
# Arm2 scored a MISS (requires RECEIPT_REV_CONTENT_DRIFT in codes). Mechanism: the gate's
# check() returns codes right after digest/resolve checks, BEFORE the role/drift logic, so
# digest mismatch short-circuits and doctored bytes can never produce CONTENT_DRIFT.
# Red evidence is digest-pinned. Contrast arm5 (own receipts): siblings optional, not pinned.
