#!/usr/bin/env python3
"""Round-54 C1 counter: the cold-read floor reads 64 of 64 credited sections.

Usage: c1/measure.py --lane LANE --rev REV --work EMPTY_DIR [--explain]

Arms (every read is of git objects at REV; the live working tree is never read;
scratch lives under --work and never under /tmp):

  1. precheck  the FROZEN round-48 precheck (bytes at REV) with FLOOR
               ef19d8e1e7baef7172e8a4fa667daf6d3e29daa4 and CAND=REV: exit 0 and a
               last line `... cand_credited=64 lost=0 ok`.
  2. monitor   the unchanged round-21 selector (bytes at REV) over the ledger at
               REV: `sections_covered == 64` and `calibration_restraint_score == 8`.
  3. rekey     exactly one round-54 re-key directory `.ufo/evidence/round-21/
               coldread/rekey-r54-<c0>` exists at REV (recursive listing — the
               round-53 counter's non-recursive pathspec was its R53.1 defect),
               <c0> resolves to a commit that is REV or an ancestor of REV, and
               for EVERY heading frozen in c1/lost-headings-at-base.json the
               ledger at REV carries an entry whose traces all lie under that
               directory, whose `read_rev` is <c0> (full 40-hex), with
               wrong_expectations 0 and blocking_gaps 0, and which passes the
               FROZEN round-18 credit algorithm at REV (no input drift, no
               missing trace).
  4. readers   for every frozen heading, a committed reader report
               `.ufo/waves/round-54/w1/*Read*.json` names the heading, pins
               `cand` = <c0> and `section_sha256` equal to the sha256 of that
               section's bytes at REV (sections computed by the FROZEN
               round-18 sectionize at REV, never a reimplementation).
  5. stable    no entry bound under rekey-r54-* pins LOG.md or SCORECARD.md as an
               input: those two files change on every round after the bind, which
               is exactly how round 53's re-key lost its credit.

Verdict line: `C1_R54: rev=... c0=... credited=.. lost=.. rekeyed=K/7 readers=R/7
monitor=<score>/<credited> unstable=<n> total=<n> C1_R54_PASS=true|false`.
Exit 0 iff PASS.  Stdlib only.
"""
import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys

FLOOR = 'ef19d8e1e7baef7172e8a4fa667daf6d3e29daa4'
PRECHECK = '.ufo/evidence/round-48/quality/coldread-precheck.sh'
R18 = '.ufo/evidence/round-18/measure.py'
R21 = '.ufo/evidence/round-21/coldread/measure.py'
LEDGER = '.ufo/evidence/round-21/coldread/ledger.json'
HEADINGS = '.ufo/evidence/round-54/c1/lost-headings-at-base.json'
WAVE = '.ufo/waves/round-54/w1'
REKEY_RE = re.compile(r'^rekey-r54-([0-9a-f]{12})$')
UNSTABLE_INPUTS = ('LOG.md', 'SCORECARD.md')


def git(args, cwd=None, check=True):
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    env.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1')
    return subprocess.run(['git'] + list(args), cwd=cwd, env=env,
                          capture_output=True, text=False, check=check)


def lane_env():
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    env.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1')
    return env


def show(lane, rev, path):
    r = git(['-C', lane, 'show', '%s:%s' % (rev, path)], check=False)
    return r.stdout if r.returncode == 0 else None


def resolve(lane, prefix):
    r = git(['-C', lane, 'rev-parse', '--verify', '--quiet', '%s^{commit}' % prefix], check=False)
    return r.stdout.decode().strip() if r.returncode == 0 else None


def is_ancestor(lane, older, newer):
    return git(['-C', lane, 'merge-base', '--is-ancestor', older, newer], check=False).returncode == 0


def load_module(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--lane', required=True)
    ap.add_argument('--rev', required=True)
    ap.add_argument('--work', required=True)
    ap.add_argument('--explain', action='store_true')
    a = ap.parse_args()
    lane = a.lane
    rev = resolve(lane, a.rev)
    if rev is None:
        print('C1_R54: error=unresolvable-rev total=1 C1_R54_PASS=false')
        return 2
    work = Path(a.work)
    work.mkdir(parents=True, exist_ok=True)
    if any(work.iterdir()):
        print('C1_R54: error=work-not-empty total=1 C1_R54_PASS=false')
        return 2
    env = lane_env()
    env['TMPDIR'] = str(work)
    total = 0
    notes = []

    # ---- arm 1: the frozen precheck ------------------------------------------------
    pre = show(lane, rev, PRECHECK)
    if pre is None:
        print('C1_R54: error=precheck-missing total=1 C1_R54_PASS=false')
        return 1
    pre_path = work / 'coldread-precheck.sh'
    pre_path.write_bytes(pre)
    run = subprocess.run(['bash', str(pre_path), lane, FLOOR, rev],
                         capture_output=True, env=env)
    lines = run.stdout.decode('utf-8', 'replace').strip().splitlines()
    last = lines[-1] if lines else ''
    credited = lost = None
    m = re.search(r'cand_credited=(\d+) lost=(\d+)', last)
    if m:
        credited, lost = int(m.group(1)), int(m.group(2))
    precheck_ok = m is not None and lost is not None and lost <= 7
    if not precheck_ok:
        total += 1
    if a.explain:
        notes.append('arm1-precheck exit=%d %s' % (run.returncode, last[:160]))

    # ---- arm 2: the unchanged round-21 monitor -------------------------------------
    r21 = show(lane, rev, R21)
    r18 = show(lane, rev, R18)
    ledger_raw = show(lane, rev, LEDGER)
    if r21 is None or r18 is None or ledger_raw is None:
        print('C1_R54: error=monitor-blobs-missing total=1 C1_R54_PASS=false')
        return 1
    (work / 'r18measure.py').write_bytes(r18)
    # the round-21 selector resolves the implementation as parents[4] of itself, so
    # the REV bytes are mirrored at their lane-relative paths and the selector is run.
    mirror = work / 'mirror'
    for rel, data in ((R18, r18), (R21, r21)):
        target = mirror / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
    run = subprocess.run([sys.executable, str(mirror / R21), '--repo', lane, '--rev', rev],
                         capture_output=True, env=env)
    monitor = {}
    try:
        monitor = json.loads(run.stdout.decode('utf-8', 'replace'))
    except ValueError:
        monitor = {}
    covered = (monitor.get('coldread') or {}).get('sections_covered')
    score = monitor.get('calibration_restraint_score')
    monitor_ok = covered == 64 and score == 8
    if not monitor_ok:
        total += 1
    if a.explain:
        notes.append('arm2-monitor exit=%d covered=%s score=%s' % (run.returncode, covered, score))

    # ---- sections at REV (frozen sectionize) ---------------------------------------
    r18_mod = load_module(str(work / 'r18measure.py'), 'tameshi_r18_r54')
    skill_raw = show(lane, rev, 'SKILL.md')
    sections = {s['heading']: s for s in r18_mod.sectionize(skill_raw)}
    frozen = json.loads((Path(__file__).resolve().parent / 'lost-headings-at-base.json').read_text('utf-8'))

    # ---- arm 3: the re-key directory and its entries --------------------------------
    tree = git(['-C', lane, 'ls-tree', '-r', '--name-only', rev,
                '.ufo/evidence/round-21/coldread/'], check=False).stdout.decode()
    rekey_dirs = sorted({Path(p).name for p in tree.splitlines()
                         if REKEY_RE.match(Path(p).name) and '/traces/' in p})
    c0 = None
    rekey_ok = len(rekey_dirs) == 1
    if rekey_ok:
        prefix = REKEY_RE.match(rekey_dirs[0]).group(1)
        c0 = resolve(lane, prefix)
        rekey_ok = (c0 is not None and is_ancestor(lane, c0, rev)
                    and c0.startswith(prefix))
    if a.explain:
        notes.append('arm3-rekey dirs=%s c0=%s' % (rekey_dirs, c0))

    ledger = json.loads(ledger_raw.decode('utf-8', 'surrogateescape'))
    entries = ledger.get('entries') or []
    rekeyed = 0
    unstable = []
    if rekey_ok:
        rekey_prefix = '.ufo/evidence/round-21/coldread/' + rekey_dirs[0] + '/'
        bound = [e for e in entries if isinstance(e, dict)
                 and any(isinstance(t, str) and t.startswith(rekey_prefix)
                         for t in (e.get('traces') or []))]
        for e in bound:
            inputs = e.get('inputs') or {}
            for p in UNSTABLE_INPUTS:
                if p in inputs:
                    unstable.append('%s:%s' % (e.get('heading', '?')[:40], p))
        for h in frozen:
            good = [e for e in bound
                    if e.get('heading') == h
                    and str(e.get('read_rev')) == c0
                    and (e.get('wrong_expectations') in (0, '0'))
                    and (e.get('blocking_gaps') in (0, '0'))
                    and r18_mod.entry_reason(lane, rev, e, True) is None]
            if good:
                rekeyed += 1
    if rekeyed != len(frozen):
        total += 1
    if unstable:
        total += 1

    # ---- arm 4: committed reader reports ------------------------------------------------------------------
    readers = {}
    wave_tree = git(['-C', lane, 'ls-tree', '-r', '--name-only', rev, WAVE + '/'],
                    check=False).stdout.decode()
    for path in wave_tree.splitlines():
        if not re.search(r'/T54W\d+.*Read.*\.json$', path):
            continue
        raw = show(lane, rev, path)
        if raw is None:
            continue
        try:
            d = json.loads(raw.decode('utf-8', 'surrogateescape'))
        except ValueError:
            continue
        if isinstance(d, dict) and isinstance(d.get('heading'), str):
            readers.setdefault(d['heading'], []).append((path, d))
    reader_ok = 0
    for h in frozen:
        sec = sections.get(h)
        if sec is None:
            continue
        for path, d in readers.get(h, []):
            if d.get('cand') == c0 and d.get('section_sha256') == sec['sha256']:
                reader_ok += 1
                break
    if reader_ok != len(frozen):
        total += 1
    if a.explain:
        notes.append('arm4-readers %d/%d' % (reader_ok, len(frozen)))
        for note in notes:
            print('EXPLAIN ' + note)

    print('C1_R54: rev=%s c0=%s credited=%s lost=%s rekeyed=%d/%d readers=%d/%d '
          'monitor=%s/%s unstable=%d total=%d C1_R54_PASS=%s'
          % (rev[:12], (c0 or 'none')[:12], credited, lost, rekeyed, len(frozen),
             reader_ok, len(frozen), score, covered, len(unstable), total,
             'true' if total == 0 else 'false'))
    return 0 if total == 0 else 1


if __name__ == '__main__':
    sys.exit(main())
