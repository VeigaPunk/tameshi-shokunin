CASE good fixture: every arm 0 PASS C2_R57: self=- rev=xxxxxxxxxxxx gate_rows=3 exits=0,2,3 held=3/3 mutants=3/3 skill_row=1 codes_known=2/2 standing_cell=ok total=0 C2_R57_PASS=true
CASE rows arm: no exit-2 row -> rows shortfall PASS short={'rows': 2, 'executed': 0, 'mutants': 1, 'skill': 0, 'codes': 0, 'cell': 0}
CASE rows arm (forgery): selftest-argv rows are not gate rows PASS gate_rows=0
CASE executed arm: a row expecting the wrong exit does not hold PASS held=2/3
CASE mutants arm: an exit-0-only row kills no mutant PASS mutants=0/3
CASE mutants arm: without the drift row M1 and M2 survive PASS mutants=1/3 (only M3 killed by the exit-2 row)
CASE mutants arm: a mutant whose old string is absent is not killed (uniqueness assert) PASS mutants=2/3
CASE skill_row arm: no gate row -> 0 PASS
CASE skill_row arm: verdict map without the 2 -> 0 PASS
CASE codes arm: a token the gate does not define is counted PASS codes_known=2/3
CASE cell arm: the stale RECEIPT_REV_MISMATCH cell is WRONG while the code is still a defined one PASS WRONG:RECEIPT_REV_MISMATCH
CASE cell arm: a cell with no code is WRONG:none PASS
CASE cell arm: truth comes from running the gate (a gate emitting MISMATCH flips the verdict) PASS WRONG:RECEIPT_REV_CONTENT_DRIFT
CASE cell arm: a gate that does not refuse -> WRONG:fixture PASS
CASE rows arm: a refusal row naming an undefined code is counted PASS short={'rows': 1, 'executed': 1, 'mutants': 2, 'skill': 0, 'codes': 0, 'cell': 0}
CASE mutants arm: a row that did not hold at baseline supplies no kill credit PASS mutants=1/3 (only M3 killed by the exit-2 row)
