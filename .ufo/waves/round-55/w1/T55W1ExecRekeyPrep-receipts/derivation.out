## command: sed -n '3,17p;70,71p' .ufo/evidence/round-55/no-harm.sh .ufo/evidence/round-55/deciding-run.sh
# Carried from round 54 with two declared re-bases: tools-scope gains the one tool this round edits
# (repeat-control, context-capture) and the registry file whose seven cells it rewords, and the
# registry-row-names guard replaces round 54's monitor that read the old fleet tree. The one
# calibration-critical monitor (the cold-read floor) is monitored at 64/64, which is the re-key
# obligation this round carries for the one SKILL.md section its edit drifts.
# Scratch: $HYAKU_SCRATCH (default /fast/scratch/hyaku)/tameshi-r55/no-harm, removed on exit.
CR=$(python3 .ufo/evidence/round-21/coldread/measure.py --repo "$LANE" --rev "$REV" 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print("score=%s credited=%d" % (d["calibration_restraint_score"], d["coldread"]["sections_covered"]))')
python3 -c 'import sys; s=dict(kv.split("=") for kv in sys.argv[1].split()); sys.exit(0 if int(s["score"])>=8 and int(s["credited"])>=64 else 1)' "$CR" && s=ok || s=RED; echo "NOHARM coldread-floor $CR $s"
bash "$SCR/code/precheck.sh" "$LANE" "$BASE" "$REV" > "$OUT/coldread-precheck.stdout" 2>&1; echo $? > "$OUT/coldread-precheck.exit"
tail -1 "$OUT/coldread-precheck.stdout"; [ "$(cat "$OUT/coldread-precheck.exit")" = 0 ] || rc=1
