          "line": 1282,
          "text": "        from unittest.mock import patch"
        },
        {
          "line": 1283,
          "text": "        hostile_git_env = {"
        },
        {
          "line": 1284,
          "text": "            \"GIT_INDEX_FILE\": str(root / \"foreign-index\"),"
        },
        {
          "line": 1285,
          "text": "            \"GIT_OBJECT_DIRECTORY\": str(root / \"foreign-objects\"),"
        },
        {
          "line": 1286,
          "text": "            \"GIT_CONFIG_GLOBAL\": str(root / \"foreign-config\"),"
        },
        {
          "line": 1287,
          "text": "            \"GIT_CONFIG_NOSYSTEM\": \"0\","
        },
        {
          "line": 1288,
          "text": "        }"
        },
        {
          "line": 1289,
          "text": "        with patch.dict(os.environ, hostile_git_env):"
        },
        {
