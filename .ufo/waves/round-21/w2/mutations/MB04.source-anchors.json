        {
          "line": 1294,
          "text": "        check(\"pins global Git configuration\","
        },
        {
          "line": 1295,
          "text": "              child_env.get(\"GIT_CONFIG_GLOBAL\") == os.devnull)"
        },
        {
          "line": 1296,
          "text": "        check(\"disables system Git configuration\","
        },
        {
          "line": 1297,
          "text": "              child_env.get(\"GIT_CONFIG_NOSYSTEM\") == \"1\")"
        },
        {
          "line": 1298,
          "text": "        # These are command-pin contracts, not claims that init/add have a"
        },
        {
          "line": 1299,
          "text": "        # reachable hook under the already-scrubbed fixture environment."
        },
        {
          "line": 1300,
          "text": "        with patch.object(subprocess, \"run\", wraps=subprocess.run) as git_calls:"
        },
        {
          "line": 1301,
          "text": "            fixture_repo(\"command-pin-fixture\", b\"command pin\\n\")"
        },
        {
          "line": 1302,
          "text": "        for operation in (\"init\", \"add\", \"commit\"):"
        },
        {
          "line": 1303,
          "text": "            commands = ["
        },
        {
          "line": 1304,
          "text": "                call.args[0] for call in git_calls.call_args_list"
        },
