        {
          "line": 333,
          "text": "def git_clean_env() -> dict:"
        },
        {
          "line": 334,
          "text": "    \"\"\"Remove inherited Git settings, then pin safe configuration sources.\"\"\""
        },
        {
          "line": 335,
          "text": "    env = {name: value for name, value in os.environ.items()"
        },
        {
          "line": 336,
          "text": "           if not name.startswith(\"GIT_\")}"
        },
        {
          "line": 337,
          "text": "    env[\"GIT_CONFIG_GLOBAL\"] = \"/dev/null\""
        },
        {
          "line": 338,
          "text": "    env[\"GIT_CONFIG_NOSYSTEM\"] = \"1\""
        },
        {
          "line": 339,
          "text": "    return env"
        },
        {
          "line": 340,
          "text": ""
        },
        {
          "line": 341,
          "text": ""
        },
        {
          "line": 342,
          "text": "def materialize_target(kagi: Path, rev: str) -> bytes:"
        },
        {
          "line": 343,
          "text": "    if not re.fullmatch(r\"[0-9a-f]{40}\", rev or \"\"):"
        },
        {
          "line": 344,
          "text": "        raise Cannot(f\"revision is not an exact 40-hex git id: {rev!r}\")"
        },
        {
          "line": 345,
          "text": "    if not (kagi / \".git\").exists() and not (kagi / \".jj\").exists():"
        },
        {
          "line": 346,
          "text": "        raise Cannot(f\"kagi object store not found at {kagi}\")"
        },
        {
          "line": 347,
          "text": "    proc = subprocess.run("
        },
        {
          "line": 348,
          "text": "        [\"git\", \"-C\", str(kagi), \"show\", \"--end-of-options\","
        },
        {
          "line": 349,
          "text": "         f\"{rev}:{TARGET_GIT_PATH}\"],"
        },
        {
          "line": 350,
          "text": "        capture_output=True, check=False, env=git_clean_env())"
        },
        {
          "line": 351,
          "text": "    if proc.returncode != 0:"
        },
        {
          "line": 352,
          "text": "        raise Cannot(f\"git show {rev}:{TARGET_GIT_PATH} failed: \""
        },
        {
          "line": 353,
          "text": "                     f\"{proc.stderr.decode('utf-8', 'replace').strip()}\")"
        },
        {
          "line": 354,
          "text": "    return proc.stdout"
        }
      ]
    },
