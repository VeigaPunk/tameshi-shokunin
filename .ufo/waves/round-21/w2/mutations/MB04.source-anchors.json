          "text": "            target = repo / TARGET_GIT_PATH"
        },
        {
          "line": 1256,
          "text": "            target.parent.mkdir(parents=True)"
        },
        {
          "line": 1257,
          "text": "            target.write_bytes(contents)"
        },
        {
          "line": 1258,
          "text": "            safe_env = git_clean_env()"
        },
        {
          "line": 1259,
          "text": "            subprocess.run("
