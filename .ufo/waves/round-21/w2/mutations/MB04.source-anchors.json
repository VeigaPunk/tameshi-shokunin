          "line": 1230,
          "text": ""
        },
        {
          "line": 1231,
          "text": "    def check(name: str, ok: bool) -> None:"
        },
        {
          "line": 1232,
          "text": "        nonlocal cases, failed"
        },
        {
          "line": 1233,
          "text": "        cases += 1"
        },
        {
          "line": 1234,
          "text": "        if ok:"
        },
