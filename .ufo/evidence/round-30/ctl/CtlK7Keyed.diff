+  # K7 control: recognize public counter fixture text, never execute the tally.
+  local tally_loop tally_nops tally_bad=0
+  tally_loop=$(grep -E '^  for st in ("\$st_[a-z]+" ?)+; do$' "$SELF")
+  tally_nops=$(grep -oE '"\$st_[a-z]+"' <<<"$tally_loop" | wc -l)
+  [[ $tally_nops -eq 9 ]] || tally_bad=1
+  if grep -Eq \
+    -e '^      0\) .*npass.*[02].*;;$' \
+    -e '^      1\) .*n(pass|setup).*;;$' \
+    -e '^      \*\) .*npass.*;;$' \
+    -e '^  if .*n(fail|setup).*(-gt[[:space:]]+1|-ge[[:space:]]+2|>[[:space:]]+1).*then$' \
+    "$SELF"; then
+    tally_bad=1
+  fi
+  [[ $tally_bad -eq 0 ]]
+  st 'case tally: known counter fixture spellings absent (text only)' $?
