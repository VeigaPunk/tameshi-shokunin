KNOWN_ARGUMENTS = frozenset(
    ("--check", "--selftest", "--json", "--receipt", "--expected", "-h",
     "--help"))

USAGE = """usage: context-capture.py --check [--receipt FILE --expected FILE] [--json]
       context-capture.py --selftest

Retained-receipt gate for the round-14 context observation. `--check` alone
replays the frozen clean receipt against its built-in digest/id/exit pin.
`--check --receipt FILE --expected FILE` pins the receipt sha256 and the exact
expected finding id/exit from an expected file.

The gate re-derives comparison, environment, run, positive-control, source and
runner-mapping facts from raw retained fields; stored status/exit/reasons and
summary booleans are never trusted. It does not capture, execute the probe,
read live lane inputs, or write during check; frozen mode reads only the
archived receipt named by the built-in pin. Explicit mode reads only the
caller-selected receipt and expected JSON with the caller's permissions; select
non-secret files. No credential probe is executed.

exit 0   clean retained receipt (id=context_consistent)
exit 1   re-derived or pinned-verdict mismatch (a matched exit-1 pin still
         reports the retained mismatch as exit 1)
exit 2   could-not-evaluate receipt/expected/snapshot/internal failure
exit 64  usage / could-not-evaluate invocation

expected schema (exactly four keys):
  {"schema": "tameshi-context-expected-v1",
   "receipt_sha256": "<64 lowercase hex>",
   "id": "<stable finding id or context_consistent>",
   "exit": 0 | 1 | 2}
"""


class UsageError(Exception):
    pass


class CouldNotEvaluate(Exception):
    """A retained record that prevents the gate question being evaluated."""

    def __init__(self, finding_id, detail):
        super().__init__(detail)
        self.finding_id = finding_id
        self.detail = detail


# ------------------------------------------------------------------ utilities


def sha256_bytes(payload):
    return hashlib.sha256(payload).hexdigest()


def tool_sha256():
    try:
        with open(SELF, "rb") as handle:
            return sha256_bytes(handle.read())
    except OSError:
        return None


def _no_duplicate_keys(pairs):
    record = {}
    for key, value in pairs:
        if key in record:
            raise ValueError("duplicate JSON key " + repr(key))
        record[key] = value
    return record


def parse_json_strict(raw, finding_id, label):
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise CouldNotEvaluate(finding_id, label + " is not UTF-8")
    try:
        document = json.loads(text, object_pairs_hook=_no_duplicate_keys)
    except (ValueError, RecursionError) as exc:
        raise CouldNotEvaluate(
            finding_id, "{} is not strict JSON: {}".format(label, exc))
    return document


def read_regular(path, missing_id, unreadable_id, label):
    try:
        info = os.stat(path)
    except FileNotFoundError:
        raise CouldNotEvaluate(missing_id, label + " is missing: " + path)
    except OSError as exc:
        raise CouldNotEvaluate(
            unreadable_id,
            "cannot stat {}: {}".format(label, exc.strerror or "I/O error"))
    if not stat.S_ISREG(info.st_mode):
        raise CouldNotEvaluate(unreadable_id, label + " is not a regular file")
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except FileNotFoundError:
        raise CouldNotEvaluate(missing_id, label + " is missing: " + path)
    except OSError as exc:
        raise CouldNotEvaluate(
            unreadable_id,
            "cannot read {}: {}".format(label, exc.strerror or "I/O error"))


def collect_finding(findings, finding_id, detail):
    for finding in findings:
        if finding["id"] == finding_id:
            finding["detail"] += "; " + detail
            return
    findings.append({"id": finding_id, "detail": detail})


# ------------------------------------------------------- structural coercion


def require_object(value, path, keys=None):
    if type(value) is not dict:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", path + " is not an object")
    if keys is not None:
        missing = sorted(key for key in keys if key not in value)
        extra = sorted(key for key in value if key not in keys)
        if missing or extra:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "{} keys mismatch (missing={}, extra={})".format(
                    path, missing, extra))
    return value


def require_string(value, path, nonempty=True):
    if type(value) is not str or (nonempty and not value):
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "{} is not a non-empty string".format(path)
            if nonempty else "{} is not a string".format(path))
    return value


def require_bool(value, path):
    if type(value) is not bool:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", path + " is not a literal boolean")
    return value


def require_int(value, path, allowed=None):
    if type(value) is not int:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", path + " is not an integer")
    if allowed is not None and value not in allowed:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "{} value {} is outside {}".format(path, value, sorted(allowed)))
    return value


def require_list(value, path, length=None):
    if type(value) is not list:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", path + " is not a list")
    if length is not None and len(value) != length:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "{} has {} entries, expected {}".format(path, len(value), length))
    return value


def require_strings(value, path, length=None):
    items = require_list(value, path, length)
    for index, item in enumerate(items):
        require_string(item, "{}[{}]".format(path, index))
    return items


def require_hex(value, path, pattern):
    require_string(value, path)
    if pattern.fullmatch(value) is None:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", path + " is not canonical lowercase hex")
    return value


def require_observed_at(value, path):
    require_string(value, path)
    if OBSERVED_AT.fullmatch(value) is None:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", path + " is not a UTC timestamp")
    return value


def require_run(value, path):
    require_object(value, path, RUN_KEYS)
    require_strings(value["argv"], path + ".argv")
    require_string(value["cwd"], path + ".cwd")
    require_int(value["exit"], path + ".exit")
    require_string(value["stdout"], path + ".stdout", nonempty=False)
    require_string(value["stderr"], path + ".stderr", nonempty=False)
    return value


def require_env_delta(value, path):
    require_object(value, path, frozenset(("baseline", "injected")))
    require_strings(value["baseline"], path + ".baseline")
    require_strings(value["injected"], path + ".injected")
    return value


# --------------------------------------------------------- receipt structure


def validate_top(receipt):
    if type(receipt) is not dict:
        raise CouldNotEvaluate(
            "receipt_json_invalid", "receipt root is not an object")
    status = receipt.get("status")
    if status not in ("ok", "mismatch", "invalid_input"):
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "receipt.status is not ok/mismatch/invalid_input")
    keys = set(RECEIPT_KEYS)
    if status == "invalid_input":
        keys.add("error")
    require_object(receipt, "receipt", frozenset(keys))
    if receipt["schema"] != RECEIPT_SCHEMA:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "receipt.schema is not " + RECEIPT_SCHEMA)
    require_string(receipt["tool"], "receipt.tool")
    require_hex(receipt["tool_sha256"], "receipt.tool_sha256", HEX64)
    require_observed_at(receipt["observed_at"], "receipt.observed_at")
    require_string(receipt["lane_root"], "receipt.lane_root")
    require_string(receipt["fleet_root"], "receipt.fleet_root")
    if not os.path.isabs(receipt["lane_root"]):
        raise CouldNotEvaluate(
            "receipt_structure_invalid", "receipt.lane_root is not absolute")
    if not os.path.isabs(receipt["fleet_root"]):
        raise CouldNotEvaluate(
            "receipt_structure_invalid", "receipt.fleet_root is not absolute")
    if os.path.normpath(receipt["fleet_root"]) != os.path.dirname(
            os.path.normpath(receipt["lane_root"])):
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "receipt.fleet_root is not the parent of receipt.lane_root")
    invocation = require_object(
        receipt["invocation"], "receipt.invocation",
        frozenset(("argv", "cwd")))
    require_strings(invocation["argv"], "receipt.invocation.argv")
    require_string(invocation["cwd"], "receipt.invocation.cwd")
    if receipt["result_reuse"] != "not_established":
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "receipt.result_reuse is not not_established")
    require_string(receipt["result_reuse_reason"],
                   "receipt.result_reuse_reason")
    not_compared = require_strings(
        receipt["not_compared"], "receipt.not_compared")
    for limit in NOT_COMPARED_LIMITS:
        if limit not in not_compared:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "receipt.not_compared omits a configured limit")
    require_int(receipt["exit"], "receipt.exit", {0, 1, 2})
    require_strings(receipt["reasons"], "receipt.reasons")
    return status


def validate_environment(environment):
    if type(environment) is not dict:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", "receipt.environment is not an object")
    allowed = set(ENVIRONMENT_KEYS)
    missing = sorted((allowed - {"injected_env"}) - set(environment))
    extra = sorted(set(environment) - allowed)
    if missing or extra:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "receipt.environment keys mismatch (missing={}, extra={})".format(
                missing, extra))
    if "injected_env" in environment:
        injected = environment["injected_env"]
        if injected is not None and type(injected) is not dict:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "receipt.environment.injected_env is neither an object nor null")
        if type(injected) is dict:
            for key, value in injected.items():
                require_string(key, "environment.injected_env key")
                require_string(value, "environment.injected_env[{!r}]".format(key))
    require_string(environment["baseline_policy"], "environment.baseline_policy")
    require_string(environment["injected_policy"], "environment.injected_policy")
    require_strings(environment["env_delta_keys"], "environment.env_delta_keys")
    require_bool(environment["env_delta_matches_declared"],
                 "environment.env_delta_matches_declared")
    require_bool(environment["baseline_has_GIT_DIR"],
                 "environment.baseline_has_GIT_DIR")
    require_strings(environment["ambient_git_keys_removed"],
                    "environment.ambient_git_keys_removed")
    require_string(environment["poison_path"], "environment.poison_path")
    require_bool(environment["poison_path_exists"],
                 "environment.poison_path_exists")
    require_bool(environment["ambient_env_dumped"],
                 "environment.ambient_env_dumped")
    if environment["ambient_env_dumped"] is not False:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "receipt.environment declares an ambient environment dump")
    return environment


def validate_runs(runs):
    require_object(runs, "receipt.runs", RUNS_KEYS)
    require_strings(runs["argv"], "runs.argv")
    require_bool(runs["argv_equal"], "runs.argv_equal")
    require_string(runs["cwd"], "runs.cwd")
    require_bool(runs["cwd_equal"], "runs.cwd_equal")
    require_env_delta(runs["env_delta"], "runs.env_delta")
    require_run(runs["baseline"], "runs.baseline")
    require_run(runs["injected"], "runs.injected")
    return runs


def validate_comparison(comparison):
    require_object(comparison, "receipt.comparison", COMPARISON_KEYS)
    exclusions = require_strings(comparison["exclusions"],
                                 "comparison.exclusions")
    if exclusions != ["observed_at"]:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "comparison.exclusions is not exactly ['observed_at']")
    require_string(comparison["normalization"], "comparison.normalization")
    observed = require_object(
        comparison["observed_at"], "comparison.observed_at",
        frozenset(("baseline", "injected")))
    require_observed_at(observed["baseline"], "comparison.observed_at.baseline")
    if observed["injected"] is not None:
        require_observed_at(observed["injected"],
                            "comparison.observed_at.injected")
    require_bool(comparison["raw_stdout_equal"],
                 "comparison.raw_stdout_equal")
    if comparison["error"] is not None:
        require_string(comparison["error"], "comparison.error")
    for field in ("baseline_comparable_sha256", "injected_comparable_sha256"):
        if comparison[field] is None:
            if comparison["error"] is None:
                raise CouldNotEvaluate(
                    "receipt_structure_invalid",
                    "comparison.{} is null without a recorded error".format(field))
        else:
            require_hex(comparison[field], "comparison." + field, HEX64)
    payload_match = comparison["payload_tool_sha256_matches_disk"]
    if payload_match is None:
        if comparison["error"] is None:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "comparison.payload_tool_sha256_matches_disk is null without "
                "a recorded error")
    else:
        require_bool(payload_match,
                     "comparison.payload_tool_sha256_matches_disk")
    require_bool(comparison["equal"], "comparison.equal")
    return comparison


def validate_positive_control(control):
    require_object(control, "receipt.positive_control", POSITIVE_CONTROL_KEYS)
    require_strings(control["argv"], "positive_control.argv")
    require_run(control["baseline"], "positive_control.baseline")
    require_run(control["injected"], "positive_control.injected")
    require_bool(control["baseline_ok"], "positive_control.baseline_ok")
    require_bool(control["injected_reflects_poison"],
                 "positive_control.injected_reflects_poison")
    require_bool(control["effective"], "positive_control.effective")
    additions = require_object(
        control["env_additions"], "positive_control.env_additions")
    for key, value in additions.items():
        require_string(key, "positive_control.env_additions key")
        require_string(value, "positive_control.env_additions[{!r}]".format(key))
    require_env_delta(control["env_delta"], "positive_control.env_delta")
    return control


def validate_sources(sources):
    require_object(sources, "receipt.sources", frozenset(SOURCE_PATHS))
    for name, path in SOURCE_PATHS.items():
        entry = require_object(
            sources[name], "sources." + name, SOURCE_ENTRY_KEYS[name])
        if entry["path"] != path:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "sources.{} path is not {}".format(name, path))
        require_hex(entry["sha256"], "sources.{}.sha256".format(name), HEX64)
        if name == "probe":
            require_hex(entry["declared_sha256"],
                        "sources.probe.declared_sha256", HEX64)
            require_bool(entry["matches_declared"],
                         "sources.probe.matches_declared")
        elif name == "runner":
            require_hex(entry["manifest_declared_sha256"],
                        "sources.runner.manifest_declared_sha256", HEX64)
            require_bool(entry["matches_manifest_declaration"],
                         "sources.runner.matches_manifest_declaration")
    return sources


def validate_mapping(mapping):
    require_object(mapping, "receipt.mapping", MAPPING_KEYS)
    if mapping["schema"] != MAPPING_SCHEMA:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "mapping.schema is not " + MAPPING_SCHEMA)
    if mapping["runner_path"] != RUNNER_REL:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "mapping.runner_path is not " + RUNNER_REL)
    parsed = require_object(
        mapping["parsed"], "mapping.parsed",
        frozenset(("header_rows", "pin_constants", "rev_constants",
                   "leg_calls")))
    for key, value in parsed.items():
        require_int(value, "mapping.parsed." + key)
        if value != 6:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "mapping.parsed.{} is not 6".format(key))
    scope = require_object(
        mapping["call_scope"], "mapping.call_scope",
        frozenset(("function", "line_start", "call_count")))
    if scope["function"] != "run_regression":
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "mapping.call_scope.function is not run_regression")
    require_int(scope["line_start"], "mapping.call_scope.line_start")
    require_int(scope["call_count"], "mapping.call_scope.call_count")
    if scope["line_start"] < 1 or scope["call_count"] != 6:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", "mapping.call_scope is inconsistent")
    table = require_object(
        mapping["declared_variable_table"], "mapping.declared_variable_table")
    if table != EXPECTED_SUFFIX:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "mapping.declared_variable_table is not the configured six-leg table")
    runner_order = require_strings(
        mapping["runner_leg_order"], "mapping.runner_leg_order", 6)
    manifest_order = require_strings(
        mapping["manifest_leg_order"], "mapping.manifest_leg_order", 6)
    if len(set(runner_order)) != 6 or len(set(manifest_order)) != 6:
        raise CouldNotEvaluate(
            "receipt_structure_invalid", "mapping leg orders repeat a leg")
    require_bool(mapping["leg_set_equal"], "mapping.leg_set_equal")
    require_bool(mapping["leg_order_equal"], "mapping.leg_order_equal")
    require_bool(mapping["all_match"], "mapping.all_match")
    require_strings(mapping["reasons"], "mapping.reasons")
    legs = require_list(mapping["legs"], "mapping.legs", 6)
    seen = set()
    for index, leg in enumerate(legs):
        path = "mapping.legs[{}]".format(index)
        require_object(leg, path, LEG_KEYS)
        name = require_string(leg["leg"], path + ".leg")
        if name in seen:
            raise CouldNotEvaluate(
                "receipt_structure_invalid", "mapping repeats a leg")
        seen.add(name)
        if name not in manifest_order:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "mapping leg is not in manifest_leg_order")
        entry = require_object(
            leg["manifest"], path + ".manifest", MANIFEST_ENTRY_KEYS)
        require_string(entry["repo"], path + ".manifest.repo")
        require_string(entry["path"], path + ".manifest.path")
        require_hex(entry["pinned_commit"],
                    path + ".manifest.pinned_commit", HEX40)
        require_hex(entry["expected_sha256"],
                    path + ".manifest.expected_sha256", HEX64)
        suffix = require_string(leg["declared_variable_suffix"],
                                path + ".declared_variable_suffix")
        if suffix not in EXPECTED_SUFFIX.values():
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                path + ".declared_variable_suffix is not configured")
        header = leg["runner_header"]
        if header is not None:
            require_object(header, path + ".runner_header", HEADER_KEYS)
            for key in ("leg", "repo", "path"):
                require_string(header[key],
                               "{}.runner_header.{}".format(path, key))
        call = leg["runner_call"]
        if call is not None:
            require_object(call, path + ".runner_call", CALL_KEYS)
            for key in ("leg", "repo", "path", "pin_constant", "rev_constant",
                        "table_constant"):
                require_string(call[key],
                               "{}.runner_call.{}".format(path, key))
            if call["line"] is not None:
                require_int(call["line"], path + ".runner_call.line")
        if leg["pin_value"] is not None:
            require_hex(leg["pin_value"], path + ".pin_value", HEX64)
        if leg["rev_value"] is not None:
            require_hex(leg["rev_value"], path + ".rev_value", HEX40)
        checks = require_object(
            leg["checks"], path + ".checks", frozenset(CHECK_NAMES))
        for name_key, value in checks.items():
            require_bool(value, "{}.checks.{}".format(path, name_key))
        require_bool(leg["match"], path + ".match")
    if [leg["leg"] for leg in legs] != manifest_order:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "mapping.legs order does not match manifest_leg_order")
    return mapping


# ----------------------------------------------------- raw-field re-derivation


def embedded_json(text, finding_id, label):
    try:
        document = json.loads(text, object_pairs_hook=_no_duplicate_keys)
    except (ValueError, RecursionError) as exc:
        raise CouldNotEvaluate(
            finding_id, "{} is not strict JSON: {}".format(label, exc))
    return document


def validate_baseline_document(document):
    if type(document) is not dict:
        raise CouldNotEvaluate(
            "baseline_unusable", "baseline observation is not an object")
    if document.get("schema") != PROBE_SCHEMA or document.get("status") != "ok":
        raise CouldNotEvaluate(
            "baseline_unusable",
            "baseline observation is not an ok pin-disposition-v1 document")
    legs = document.get("legs")
    if type(legs) is not list or len(legs) != 6:
        raise CouldNotEvaluate(
            "baseline_unusable", "baseline observation does not carry six legs")
    for index, row in enumerate(legs):
        if type(row) is not dict:
            raise CouldNotEvaluate(
                "baseline_unusable",
                "baseline leg {} is not an object".format(index))
        if row.get("content_status") == "unavailable":
            raise CouldNotEvaluate(
                "baseline_unusable",
                "baseline leg {} is unavailable".format(index))
        pinned = row.get("pinned")
        if type(pinned) is not dict or pinned.get("status") != "verified":
            raise CouldNotEvaluate(
                "baseline_unusable",
                "baseline leg {} is not pinned/verified".format(index))
    observed = document.get("observed_at")
    if type(observed) is not str or OBSERVED_AT.fullmatch(observed) is None:
        raise CouldNotEvaluate(
            "baseline_unusable",
            "baseline observation has no top-level observed_at")
    return document


def canonical_payload(document):
    trimmed = dict(document)
    trimmed.pop("observed_at")
    return json.dumps(trimmed, sort_keys=True, separators=(",", ":"))


def recompute_environment(receipt, findings):
    environment = receipt["environment"]
    injected = environment.get("injected_env", "<absent>")
    if injected == "<absent>":
        collect_finding(
            findings, "missing_injected_environment",
            "receipt.environment.injected_env is absent")
    elif injected is None:
        collect_finding(
            findings, "missing_injected_environment",
            "receipt.environment.injected_env is null")
    else:
        if injected != INJECTED_ENV:
            collect_finding(
                findings, "environment_delta_mismatch",
                "injected_env is not exactly {}".format(sorted(INJECTED_ENV)))
        recomputed_delta_ok = injected == INJECTED_ENV
        if environment["env_delta_keys"] != sorted(INJECTED_ENV):
            collect_finding(
                findings, "environment_delta_mismatch",
                "env_delta_keys is not {}".format(sorted(INJECTED_ENV)))
            recomputed_delta_ok = False
        if environment["env_delta_matches_declared"] is not True:
            collect_finding(
                findings, "environment_delta_mismatch",
                "env_delta_matches_declared is not literal True")
        elif not recomputed_delta_ok:
            collect_finding(
                findings, "environment_delta_mismatch",
                "env_delta_matches_declared claims True but raw fields disagree")
    if environment["baseline_has_GIT_DIR"] is not False:
        collect_finding(
            findings, "environment_baseline_git_dir",
            "baseline_has_GIT_DIR is not literal False")
    if environment["poison_path"] != POISON_PATH:
        collect_finding(
            findings, "environment_delta_mismatch",
            "poison_path is not the bounded injection path")
    if environment["poison_path_exists"] is not False:
        collect_finding(
            findings, "environment_delta_mismatch",
            "poison_path_exists is not literal False")


def recompute_runs(receipt, findings):
    runs = receipt["runs"]
    baseline = runs["baseline"]
    injected = runs["injected"]
    argv_equal = baseline["argv"] == injected["argv"]
    cwd_equal = baseline["cwd"] == injected["cwd"]
    if baseline["argv"] != runs["argv"] or injected["argv"] != runs["argv"]:
        collect_finding(
            findings, "run_argv_mismatch",
            "runs.argv does not equal both raw run argvs")
    if runs["argv_equal"] is not True or not argv_equal:
        collect_finding(
            findings, "run_argv_mismatch",
            "argv_equal is not literal True for equal raw argvs")
    if baseline["cwd"] != runs["cwd"] or injected["cwd"] != runs["cwd"]:
        collect_finding(
            findings, "run_cwd_mismatch",
            "runs.cwd does not equal both raw run cwds")
    if runs["cwd_equal"] is not True or not cwd_equal:
        collect_finding(
            findings, "run_cwd_mismatch",
            "cwd_equal is not literal True for equal raw cwds")
    expected_delta = {"baseline": [], "injected": sorted(INJECTED_ENV)}
    if runs["env_delta"] != expected_delta:
        collect_finding(
            findings, "run_env_delta_mismatch",
            "runs.env_delta is not exactly {}".format(expected_delta))


def recompute_comparison(receipt, findings):
    runs = receipt["runs"]
    recorded = receipt["comparison"]
    probe_sha = receipt["sources"]["probe"]["sha256"]
    if runs["baseline"]["exit"] != 0:
        raise CouldNotEvaluate(
            "baseline_unusable",
            "baseline probe run exited {}".format(runs["baseline"]["exit"]))
    baseline = embedded_json(
        runs["baseline"]["stdout"], "baseline_unusable",
        "runs.baseline.stdout")
    validate_baseline_document(baseline)
    if runs["injected"]["exit"] != 0:
        injected = None
    else:
        try:
            injected = embedded_json(
                runs["injected"]["stdout"], "comparison_mismatch",
                "runs.injected.stdout")
        except CouldNotEvaluate:
            injected = None
    recomputed = {
        "raw_stdout_equal": (
            runs["baseline"]["stdout"] == runs["injected"]["stdout"]),
        "baseline_comparable_sha256": None,
        "injected_comparable_sha256": None,
        "payload_tool_sha256_matches_disk": None,
        "equal": False,
        "error": None,
        "observed_at": {
            "baseline": baseline.get("observed_at"),
            "injected": None,
        },
    }
    if type(injected) is not dict:
        recomputed["error"] = (
            "injected probe run produced no JSON document (exit={})".format(
                runs["injected"]["exit"]))
    elif "observed_at" not in injected:
        recomputed["error"] = "injected document has no top-level observed_at"
    else:
        recomputed["observed_at"]["injected"] = injected.get("observed_at")
        recomputed["payload_tool_sha256_matches_disk"] = (
            baseline.get("tool_sha256") == probe_sha
            and injected.get("tool_sha256") == probe_sha)
        baseline_text = canonical_payload(baseline)
        injected_text = canonical_payload(injected)
        recomputed["baseline_comparable_sha256"] = sha256_bytes(
            baseline_text.encode())
        recomputed["injected_comparable_sha256"] = sha256_bytes(
            injected_text.encode())
        recomputed["equal"] = baseline_text == injected_text

    # The digest declaration is checked before the general equality fields so
    # a payload mismatch keeps its own primary finding.
    if recorded["payload_tool_sha256_matches_disk"] is not (
            recomputed["payload_tool_sha256_matches_disk"]):
        collect_finding(
            findings, "comparison_tool_digest_mismatch",
            "payload_tool_sha256_matches_disk recorded {!r} but raw documents "
            "recompute {!r}".format(
                recorded["payload_tool_sha256_matches_disk"],
                recomputed["payload_tool_sha256_matches_disk"]))
    elif recomputed["payload_tool_sha256_matches_disk"] is False:
        collect_finding(
            findings, "comparison_tool_digest_mismatch",
            "raw documents do not both declare the probe source digest")
    for field in ("baseline", "injected"):
        if recorded["observed_at"][field] != recomputed["observed_at"][field]:
            collect_finding(
                findings, "comparison_mismatch",
                "recorded observed_at.{} {!r} != recomputed {!r}".format(
                    field, recorded["observed_at"][field],
                    recomputed["observed_at"][field]))
    if recorded["raw_stdout_equal"] is not recomputed["raw_stdout_equal"]:
        collect_finding(
            findings, "comparison_mismatch",
            "raw_stdout_equal recorded {!r} but raw stdout recomputes {!r}"
            .format(recorded["raw_stdout_equal"],
                    recomputed["raw_stdout_equal"]))
    for field in ("baseline_comparable_sha256",
                  "injected_comparable_sha256"):
        if recorded[field] != recomputed[field]:
            collect_finding(
                findings, "comparison_mismatch",
                "recorded {} {!r} != recomputed {!r}".format(
                    field, recorded[field], recomputed[field]))
    if recorded["equal"] is not recomputed["equal"]:
        collect_finding(
            findings, "comparison_mismatch",
            "equal recorded {!r} but raw observations recompute {!r}".format(
                recorded["equal"], recomputed["equal"]))
    if recorded["error"] != recomputed["error"]:
        collect_finding(
            findings, "comparison_mismatch",
            "recorded error {!r} != recomputed {!r}".format(
                recorded["error"], recomputed["error"]))
    if recomputed["equal"] is False:
        collect_finding(
            findings, "comparison_mismatch",
            "recomputed canonical observations are not equal")


def recompute_positive_control(control, findings):
    baseline = control["baseline"]
    injected = control["injected"]
    baseline_ok = baseline["exit"] == 0 and baseline["stdout"].strip() != ""
    reflects = (
        POISON_PATH in injected["stdout"]
        or POISON_PATH in injected["stderr"]
        or injected["exit"] != baseline["exit"])
    effective = baseline_ok and injected["exit"] != 0 and reflects
    problems = []
    if control["baseline_ok"] is not baseline_ok:
        problems.append(
            "baseline_ok recorded {!r} but raw run recomputes {!r}".format(
                control["baseline_ok"], baseline_ok))
    if control["injected_reflects_poison"] is not reflects:
        problems.append(
            "injected_reflects_poison recorded {!r} but raw run recomputes "
            "{!r}".format(control["injected_reflects_poison"], reflects))
    if control["effective"] is not effective:
        problems.append(
            "effective recorded {!r} but raw runs recompute {!r}".format(
                control["effective"], effective))
    if control["env_additions"] != CONTROL_ENV_ADDITIONS:
        problems.append("env_additions is not the configured control set")
    expected_delta = {"baseline": [], "injected": sorted(INJECTED_ENV)}
    if control["env_delta"] != expected_delta:
        problems.append("positive-control env_delta is not the bounded delta")
    if problems:
        collect_finding(
            findings, "positive_control_ineffective", "; ".join(problems))
    elif effective is False:
        collect_finding(
            findings, "positive_control_ineffective",
            "raw positive control is ineffective")


def recompute_sources(sources, findings):
    probe = sources["probe"]
    if probe["sha256"] != probe["declared_sha256"]:
        collect_finding(
            findings, "probe_source_digest_mismatch",
            "probe sha256 does not equal its declared digest")
    if probe["matches_declared"] is not True:
        collect_finding(
            findings, "probe_source_digest_mismatch",
            "matches_declared is not literal True")
    runner = sources["runner"]
    if runner["sha256"] != runner["manifest_declared_sha256"]:
        collect_finding(
            findings, "runner_source_digest_mismatch",
            "runner sha256 does not equal its manifest declaration")
    if runner["matches_manifest_declaration"] is not True:
        collect_finding(
            findings, "runner_source_digest_mismatch",
            "matches_manifest_declaration is not literal True")


def recompute_mapping(mapping, findings):
    legs = mapping["legs"]
    problems = []
    recomputed_matches = []
    for leg in legs:
        name = leg["leg"]
        manifest = leg["manifest"]
        canonical_suffix = EXPECTED_SUFFIX.get(name)
        stored_suffix = leg["declared_variable_suffix"]
        if canonical_suffix is None:
            problems.append(
                "leg {!r} is not a configured six-leg name".format(name))
        elif stored_suffix != canonical_suffix:
            problems.append(
                "leg {!r} declared_variable_suffix {!r} is not the canonical "
                "{!r}".format(name, stored_suffix, canonical_suffix))
        suffix = canonical_suffix
        header = leg["runner_header"]
        call = leg["runner_call"]
        checks = {check: False for check in CHECK_NAMES}
        if header is not None:
            checks["header_matches_manifest"] = (
                header["leg"] == name
                and header["repo"] == manifest["repo"]
                and header["path"] == manifest["path"])
        if call is not None and suffix is not None:
            checks["leg_call_matches_manifest"] = (
                call["leg"] == name
                and call["repo"] == manifest["repo"]
                and call["path"] == manifest["path"])
            checks["pin_name_and_value_match_manifest"] = (
                call["pin_constant"] == "PIN_" + suffix
                and leg["pin_value"] == manifest["expected_sha256"])
            checks["rev_name_and_value_match_manifest"] = (
                call["rev_constant"] == "REV_" + suffix
                and leg["rev_value"] == manifest["pinned_commit"])
            checks["constant_names_match_leg"] = (
                call["pin_constant"] == "PIN_" + suffix
                and call["rev_constant"] == "REV_" + suffix
                and call["table_constant"] == "TABLE_" + suffix)
        match = all(checks.values())
        recomputed_matches.append(match)
        for check in CHECK_NAMES:
            if leg["checks"][check] is not checks[check]:
                problems.append(
                    "leg {!r} check {!r} recorded {!r} but raw fields recompute "
                    "{!r}".format(name, check, leg["checks"][check],
                                  checks[check]))
        if leg["match"] is not match:
            problems.append(
                "leg {!r} match recorded {!r} but checks recompute {!r}"
                .format(name, leg["match"], match))
    runner_order = mapping["runner_leg_order"]
    manifest_order = mapping["manifest_leg_order"]
    leg_set_equal = set(runner_order) == set(manifest_order)
    leg_order_equal = runner_order == manifest_order
    if mapping["leg_set_equal"] is not leg_set_equal:
        problems.append(
            "leg_set_equal recorded {!r} but recomputes {!r}".format(
                mapping["leg_set_equal"], leg_set_equal))
    if mapping["leg_order_equal"] is not leg_order_equal:
        problems.append(
            "leg_order_equal recorded {!r} but recomputes {!r}".format(
                mapping["leg_order_equal"], leg_order_equal))
    all_match = (
        leg_set_equal and leg_order_equal
        and len(recomputed_matches) == 6 and all(recomputed_matches))
    if mapping["all_match"] is not all_match:
        problems.append(
            "all_match recorded {!r} but raw fields recompute {!r}".format(
                mapping["all_match"], all_match))
    if problems:
        collect_finding(findings, "mapping_mismatch", "; ".join(problems))
    elif all_match is False:
        collect_finding(
            findings, "mapping_mismatch",
            "recomputed runner mapping does not match the manifest")


def verify_recorded_verdict(receipt, findings):
    computed_exit = 1 if findings else 0
    computed_status = "mismatch" if findings else "ok"
    problems = []
    if receipt["status"] != computed_status:
        problems.append(
            "status recorded {!r} but raw fields recompute {!r}".format(
                receipt["status"], computed_status))
    if receipt["exit"] != computed_exit:
        problems.append(
            "exit recorded {!r} but raw fields recompute {!r}".format(
                receipt["exit"], computed_exit))
    if computed_exit == 0 and receipt["reasons"]:
        problems.append("clean raw fields carry stored reasons")
    if computed_exit == 1 and not receipt["reasons"]:
        problems.append("mismatched raw fields carry no stored reasons")
    if problems:
        collect_finding(
            findings, "receipt_verdict_mismatch", "; ".join(problems))
    code = 1 if findings else 0
    status = "mismatch" if findings else "ok"
    return status, code, findings


def validate_invalid_blocks(receipt):
    for name in ("sources", "runs", "comparison", "positive_control", "mapping"):
        if receipt[name] != {}:
            raise CouldNotEvaluate(
                "receipt_structure_invalid",
                "invalid_input receipt carries a non-empty " + name)
    if receipt["exit"] != 2:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "invalid_input receipt exit is not 2")
    error = require_object(
        receipt["error"], "receipt.error", frozenset(("kind", "message")))
    require_string(error["kind"], "receipt.error.kind")
    require_string(error["message"], "receipt.error.message")
    if not receipt["reasons"]:
        raise CouldNotEvaluate(
            "receipt_structure_invalid",
            "invalid_input receipt carries no reasons")


def check_receipt(receipt, frozen=False):
    status = validate_top(receipt)
    if status == "invalid_input":
        validate_invalid_blocks(receipt)
        return "invalid_input", 2, [
            {
                "id": "receipt_records_invalid_input",
                "detail": "retained receipt records a could-not-evaluate capture",
            }
        ]
    validate_environment(receipt["environment"])
    validate_runs(receipt["runs"])
    validate_comparison(receipt["comparison"])
    validate_positive_control(receipt["positive_control"])
    validate_sources(receipt["sources"])
    validate_mapping(receipt["mapping"])
    findings = []
    recompute_environment(receipt, findings)
    recompute_runs(receipt, findings)
    recompute_comparison(receipt, findings)
    recompute_positive_control(receipt["positive_control"], findings)
    recompute_sources(receipt["sources"], findings)
    recompute_mapping(receipt["mapping"], findings)
    if frozen and receipt["tool_sha256"] != FROZEN_TOOL_SHA256:
        collect_finding(
            findings, "tool_declaration_mismatch",
            "retained tool_sha256 {!r} is not the pinned historical "
            "declaration".format(receipt["tool_sha256"]))
    return verify_recorded_verdict(receipt, findings)


# ----------------------------------------------------------------- expected pin


def validate_expected(document, path):
    if type(document) is not dict:
        raise CouldNotEvaluate(
            "expected_invalid", path + " root is not an object")
    missing = sorted(key for key in EXPECTED_KEYS if key not in document)
    extra = sorted(key for key in document if key not in EXPECTED_KEYS)
    if missing or extra:
        raise CouldNotEvaluate(
            "expected_invalid",
            "{} keys mismatch (missing={}, extra={})".format(
                path, missing, extra))
    if document["schema"] != EXPECTED_SCHEMA:
        raise CouldNotEvaluate(
            "expected_invalid", path + " schema is not " + EXPECTED_SCHEMA)
    try:
        require_hex(document["receipt_sha256"], path + ".receipt_sha256", HEX64)
        require_string(document["id"], path + ".id")
        if FINDING_ID.fullmatch(document["id"]) is None:
            raise CouldNotEvaluate(
                "expected_invalid", path + ".id is not a stable finding id")
        require_int(document["exit"], path + ".exit", {0, 1, 2})
    except CouldNotEvaluate as exc:
        raise CouldNotEvaluate("expected_invalid", exc.detail)
    return document


def load_expected(path):
    raw = read_regular(path, "expected_missing", "expected_unreadable",
                       "expected file")
    document = parse_json_strict(raw, "expected_invalid", "expected file")
    return validate_expected(document, path)


# -------------------------------------------------------------------- verdict


def make_result(mode, status, finding_id, code, findings, receipt_path,
                receipt_sha, expected, digest_matches, expected_matches):
    return {
        "schema": RESULT_SCHEMA,
        "tool": VERSION,
        "tool_sha256": tool_sha256(),
        "mode": mode,
        "status": status,
        "id": finding_id,
        "exit": code,
        "findings": findings,
        "receipt": {
            "path": receipt_path,
            "sha256": receipt_sha,
            "expected_sha256": None if expected is None
            else expected["receipt_sha256"],
            "digest_matches": digest_matches,
        },
        "expected": None if expected is None else {
            "id": expected["id"],
            "exit": expected["exit"],
        },
        "verdict_matches_expected": expected_matches,
    }


def _one_line(value):
    """Fold CR/LF so retained text cannot forge a verdict line."""
    return str(value).replace("\r", "\\r").replace("\n", "\\n")


def emit(result, as_json):
    if as_json:
        sys.stdout.write(json.dumps(result, sort_keys=True) + "\n")
        return result["exit"]
    label = {"ok": "OK", "mismatch": "MISMATCH",
             "invalid_input": "INVALID"}[result["status"]]
    sys.stdout.write(
        "CONTEXT: {} (id={} receipt={} sha256={} exit={} findings={})\n".format(
            label, result["id"], _one_line(result["receipt"]["path"]),
            result["receipt"]["sha256"] or "<none>", result["exit"],
            len(result["findings"])))
    for finding in result["findings"]:
        sys.stdout.write(
            "FINDING {} {}\n".format(
                _one_line(finding["id"]), _one_line(finding["detail"])))
    return result["exit"]


def apply_expected(result, expected):
    """Compare the recomputed verdict with the pinned id/exit pair."""
    if result["expected"] is None:
        return result
    matches = (result["id"] == expected["id"]
               and result["exit"] == expected["exit"])
    result["verdict_matches_expected"] = matches
    if matches:
        return result
    detail = (
        "expected id={} exit={} but recomputed id={} exit={}".format(
            expected["id"], expected["exit"], result["id"], result["exit"]))
    if result["exit"] == 0:
        result["findings"].insert(
            0, {"id": "expected_verdict_mismatch", "detail": detail})
        result["id"] = "expected_verdict_mismatch"
        result["status"] = "mismatch"
        result["exit"] = 1
    else:
        collect_finding(result["findings"], "expected_verdict_mismatch",
                        detail)
    return result


def result_from_exception(exc, mode, receipt_path, receipt_sha, expected,
                          digest_matches):
    result = make_result(
        mode, "invalid_input", exc.finding_id, 2,
        [{"id": exc.finding_id, "detail": exc.detail}],
        receipt_path, receipt_sha, expected, digest_matches, None)
    return apply_expected(result, expected) if expected is not None else result


def run_check(options):
    frozen = options["receipt"] is None
    if frozen:
        receipt_path = FROZEN_RECEIPT_REL
        full_path = os.path.join(DEFAULT_LANE_ROOT, *FROZEN_RECEIPT_REL.split("/"))
        expected = {
            "schema": EXPECTED_SCHEMA,
            "receipt_sha256": FROZEN_RECEIPT_SHA256,
            "id": FROZEN_EXPECTED_ID,
            "exit": FROZEN_EXPECTED_EXIT,
        }
        mode = "frozen"
    else:
        receipt_path = options["receipt"]
        full_path = receipt_path
        expected = load_expected(options["expected"])
        mode = "explicit"

    raw = None
    try:
        raw = read_regular(full_path, "receipt_missing", "receipt_unreadable",
                           "receipt")
    except CouldNotEvaluate as exc:
        return result_from_exception(
            exc, mode, receipt_path, None, expected, None)
    actual_sha = sha256_bytes(raw)
    if actual_sha != expected["receipt_sha256"]:
        result = make_result(
            mode, "invalid_input", "snapshot_tampered", 2,
            [{
                "id": "snapshot_tampered",
                "detail": "receipt sha256 {} is not the pinned {}".format(
                    actual_sha, expected["receipt_sha256"]),
            }],
            receipt_path, actual_sha, expected, False, None)
        return apply_expected(result, expected)
    try:
        receipt = parse_json_strict(raw, "receipt_json_invalid", "receipt")
        status, code, findings = check_receipt(receipt, frozen=frozen)
    except CouldNotEvaluate as exc:
        return result_from_exception(
            exc, mode, receipt_path, actual_sha, expected, True)
    primary = findings[0]["id"] if findings else "context_consistent"
    result = make_result(
        mode, status, primary, code, findings, receipt_path, actual_sha,
        expected, True, None)
    return apply_expected(result, expected)


# ------------------------------------------------------------------- selftest

FIXTURE_PROBE_BYTES = b"#!/usr/bin/env python3\n# selftest fixture; never run\n"
FIXTURE_RUNNER_BYTES = b"#!/usr/bin/env bash\n# selftest fixture; never run\n"
FIXTURE_MANIFEST_BYTES = b'{"schema":"pin-manifest-v1","legs":[]}\n'
FIXTURE_EXPECTED_BYTES = b'{"inputs":{}}\n'
FIXTURE_TOOL_SHA = sha256_bytes(FIXTURE_PROBE_BYTES)
FIXTURE_LEGS = tuple(EXPECTED_SUFFIX)


def _fixture_commit(leg):
    return hashlib.sha256(("commit:" + leg).encode()).hexdigest()[:40]


def _fixture_digest(leg):
    return hashlib.sha256(("digest:" + leg).encode()).hexdigest()


def _fixture_probe_document(observed_at, tool_digest):
    return {
        "schema": PROBE_SCHEMA,
        "status": "ok",
        "observed_at": observed_at,
        "tool_sha256": tool_digest,
        "legs": [
            {
                "leg": leg,
                "content_status": "observed",
                "pinned": {"status": "verified"},
            }
            for leg in FIXTURE_LEGS
        ],
    }


def _fixture_canonical(document):
    trimmed = dict(document)
    trimmed.pop("observed_at")
    return json.dumps(trimmed, sort_keys=True, separators=(",", ":"))


def build_fixture_receipt():
    baseline_document = _fixture_probe_document(
        "2026-10-20T00:00:00Z", FIXTURE_TOOL_SHA)
    injected_document = _fixture_probe_document(
        "2026-10-20T00:00:01Z", FIXTURE_TOOL_SHA)
    baseline_text = json.dumps(
        baseline_document, sort_keys=True, separators=(",", ":"))
    injected_text = json.dumps(
        injected_document, sort_keys=True, separators=(",", ":"))
    comparable = sha256_bytes(_fixture_canonical(baseline_document).encode())
    lane = "/fixture/lane"
    fleet = "/fixture"
    probe_argv = [
        "/usr/bin/python3", PROBE_REL, "--manifest", MANIFEST_REL,
        "--root", fleet,
    ]
    control_argv = ["/usr/bin/git", "-C", lane, "rev-parse", "--git-dir"]
    rows = []
    for leg in FIXTURE_LEGS:
        suffix = EXPECTED_SUFFIX[leg]
        manifest = {
            "repo": "fixture-repo",
            "path": "scripts/" + leg + ".sh",
            "pinned_commit": _fixture_commit(leg),
            "expected_sha256": _fixture_digest(leg),
        }
        rows.append({
            "leg": leg,
            "manifest": manifest,
            "declared_variable_suffix": suffix,
            "runner_header": {
                "leg": leg,
                "repo": manifest["repo"],
                "path": manifest["path"],
            },
            "runner_call": {
                "leg": leg,
                "repo": manifest["repo"],
                "path": manifest["path"],
                "line": 100 + len(rows),
                "pin_constant": "PIN_" + suffix,
                "rev_constant": "REV_" + suffix,
                "table_constant": "TABLE_" + suffix,
            },
            "pin_value": manifest["expected_sha256"],
            "rev_value": manifest["pinned_commit"],
            "checks": {check: True for check in CHECK_NAMES},
            "match": True,
        })
    return {
        "schema": RECEIPT_SCHEMA,
        "tool": "context-capture.py r15 selftest fixture",
        "tool_sha256": "a" * 64,
        "observed_at": "2026-10-20T00:00:02Z",
        "lane_root": lane,
        "fleet_root": fleet,
        "invocation": {
            "argv": ["context-capture.py", "--selftest"],
            "cwd": lane,
        },
        "environment": {
            "baseline_policy": "ambient with every GIT_* key removed, plus LC_ALL=C",
            "injected_policy": "baseline plus exactly the keys in injected_env",
            "injected_env": dict(INJECTED_ENV),
            "env_delta_keys": sorted(INJECTED_ENV),
            "env_delta_matches_declared": True,
            "baseline_has_GIT_DIR": False,
            "ambient_git_keys_removed": [],
            "poison_path": POISON_PATH,
            "poison_path_exists": False,
            "ambient_env_dumped": False,
        },
        "sources": {
            "probe": {
                "path": PROBE_REL,
                "sha256": FIXTURE_TOOL_SHA,
                "declared_sha256": FIXTURE_TOOL_SHA,
                "matches_declared": True,
            },
            "runner": {
                "path": RUNNER_REL,
                "sha256": sha256_bytes(FIXTURE_RUNNER_BYTES),
                "manifest_declared_sha256": sha256_bytes(FIXTURE_RUNNER_BYTES),
                "matches_manifest_declaration": True,
            },
            "manifest": {
                "path": MANIFEST_REL,
                "sha256": sha256_bytes(FIXTURE_MANIFEST_BYTES),
            },
            "expected_r13": {
                "path": EXPECTED_R13_REL,
                "sha256": sha256_bytes(FIXTURE_EXPECTED_BYTES),
            },
        },
        "runs": {
            "argv": probe_argv,
            "argv_equal": True,
            "cwd": lane,
            "cwd_equal": True,
            "env_delta": {"baseline": [], "injected": sorted(INJECTED_ENV)},
            "baseline": {
                "argv": probe_argv,
                "cwd": lane,
                "exit": 0,
                "stdout": baseline_text,
                "stderr": "",
            },
            "injected": {
                "argv": probe_argv,
                "cwd": lane,
                "exit": 0,
                "stdout": injected_text,
                "stderr": "",
            },
        },
        "comparison": {
            "exclusions": ["observed_at"],
            "normalization": "top-level observed_at removed; canonical JSON compared",
            "observed_at": {
                "baseline": "2026-10-20T00:00:00Z",
                "injected": "2026-10-20T00:00:01Z",
            },
            "raw_stdout_equal": baseline_text == injected_text,
            "baseline_comparable_sha256": comparable,
            "injected_comparable_sha256": comparable,
            "payload_tool_sha256_matches_disk": True,
            "equal": True,
            "error": None,
        },
        "positive_control": {
            "argv": control_argv,
            "baseline": {
                "argv": control_argv,
                "cwd": lane,
                "exit": 0,
                "stdout": ".git\n",
                "stderr": "",
            },
            "injected": {
                "argv": control_argv,
                "cwd": lane,
                "exit": 128,
                "stdout": "",
                "stderr": "fatal: not a git repository: "
                          "'/nonexistent/tameshi-round14-poison'\n",
            },
            "baseline_ok": True,
            "injected_reflects_poison": True,
            "effective": True,
            "env_additions": dict(CONTROL_ENV_ADDITIONS),
            "env_delta": {"baseline": [], "injected": sorted(INJECTED_ENV)},
        },
        "mapping": {
            "schema": MAPPING_SCHEMA,
            "runner_path": RUNNER_REL,
            "parsed": {
                "header_rows": 6,
                "pin_constants": 6,
                "rev_constants": 6,
                "leg_calls": 6,
            },
            "call_scope": {
                "function": "run_regression",
                "line_start": 42,
                "call_count": 6,
            },
            "declared_variable_table": dict(EXPECTED_SUFFIX),
            "runner_leg_order": list(FIXTURE_LEGS),
            "manifest_leg_order": list(FIXTURE_LEGS),
            "leg_set_equal": True,
            "leg_order_equal": True,
            "legs": rows,
            "all_match": True,
            "reasons": [],
        },
        "result_reuse": "not_established",
        "result_reuse_reason": "selftest fixture: no execution or reuse claim",
        "not_compared": list(NOT_COMPARED_LIMITS),
        "status": "ok",
        "exit": 0,
        "reasons": [],
    }


SELFTEST_ENV = {
    "PATH": "/usr/bin:/bin",
    "LC_ALL": "C",
    "GIT_DIR": "/nonexistent/context-selftest-poison",
}


class SelftestHarness:
    def __init__(self):
        self.root = tempfile.mkdtemp(prefix="context-capture-selftest-",
                                     dir="/tmp")
        self.passed = 0
        self.failed = []
        self.outputs = []
        self.counter = 0

    def case_dir(self, name):
        self.counter += 1
        path = os.path.join(self.root, "{:02d}-{}".format(self.counter, name))
        os.makedirs(path)
        return path

    def record(self, name, ok, detail):
        status = "OK" if ok else "FAIL"
        sys.stdout.write(
            "SELFTEST_CASE {} {} {}\n".format(name, status, detail))
        if ok:
            self.passed += 1
        else:
            self.failed.append(name)

    def run(self, argv, cwd):
        proc = subprocess.run(
            argv, cwd=cwd, env=SELFTEST_ENV, stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60,
            text=True, check=False)
        self.outputs.append(proc.stdout)
        self.outputs.append(proc.stderr)
        return proc

    def check_case(self, name, receipt, expected_id, expected_exit,
                   receipt_bytes=None, write_receipt=True,
                   expected_override=None, write_expected=True,
                   expected_ids=None, expected_bytes=None,
                   expected_match=True):
        directory = self.case_dir(name)
        receipt_path = os.path.join(directory, "receipt.json")
        expected_path = os.path.join(directory, "expected.json")
        if receipt_bytes is None:
            receipt_bytes = (json.dumps(
                receipt, indent=2, sort_keys=True) + "\n").encode("utf-8")
        if write_receipt:
            with open(receipt_path, "wb") as handle:
                handle.write(receipt_bytes)
        if expected_bytes is not None:
            expected_document = None
        elif expected_override is None:
            expected_document = {
                "schema": EXPECTED_SCHEMA,
                "receipt_sha256": sha256_bytes(receipt_bytes),
                "id": expected_id,
                "exit": expected_exit,
            }
        else:
            expected_document = expected_override
        if write_expected:
            if expected_bytes is not None:
                with open(expected_path, "wb") as handle:
                    handle.write(expected_bytes)
            else:
                with open(expected_path, "w", encoding="utf-8") as handle:
                    json.dump(expected_document, handle, sort_keys=True)
                    handle.write("\n")
        proc = self.run(
            [sys.executable, "-I", SELF, "--check", "--receipt", receipt_path,
             "--expected", expected_path, "--json"],
            directory)
        observed_id = "<unparsed>"
        observed_exit = proc.returncode
        findings = None
        payload = None
        try:
            payload = json.loads(proc.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            payload = None
        if type(payload) is dict:
            observed_id = payload.get("id", "<missing>")
            observed_exit = payload.get("exit", proc.returncode)
            findings = payload.get("findings")
        ok = (
            proc.returncode == expected_exit
            and observed_exit == expected_exit
            and observed_id == expected_id
            and type(findings) is list
            and "Traceback" not in proc.stderr
        )
        if expected_exit == 0:
            ok = ok and findings == []
            ok = ok and type(payload) is dict
            ok = ok and payload.get("receipt", {}).get("sha256") == sha256_bytes(
                receipt_bytes)
        ids = [finding.get("id") for finding in (findings or [])
               if type(finding) is dict]
        if expected_match is not None:
            observed_match = (
                payload.get("verdict_matches_expected")
                if type(payload) is dict else None)
            ok = ok and observed_match is expected_match
            if expected_match:
                ok = ok and "expected_verdict_mismatch" not in ids
            else:
                ok = ok and "expected_verdict_mismatch" in ids
        else:
            ok = ok and "expected_verdict_mismatch" not in ids
        if expected_ids is not None:
            ok = ok and all(item in ids for item in expected_ids)
        self.record(
            name, ok,
            "expected={}/{} observed={}/{} exit={}".format(
                expected_id, expected_exit, observed_id, observed_exit,
                proc.returncode))
        if not ok:
            if proc.stderr.strip():
                sys.stdout.write(
                    "SELFTEST_STDERR {}: {}\n".format(
                        name, proc.stderr.strip()[:400]))
            if proc.stdout.strip():
                sys.stdout.write(
                    "SELFTEST_STDOUT {}: {}\n".format(
                        name, proc.stdout.strip()[:400]))

    def usage_case(self, name, argv):
        directory = self.case_dir(name)
        proc = self.run([sys.executable, "-I", SELF] + argv, directory)
        ok = (
            proc.returncode == 64
            and "id=usage_error" in proc.stderr
            and "Traceback" not in proc.stderr
        )
        self.record(
            name, ok,
            "expected=usage_error/64 observed_exit={}".format(proc.returncode))
        if not ok and proc.stderr.strip():
            sys.stdout.write(
                "SELFTEST_STDERR {}: {}\n".format(
                    name, proc.stderr.strip()[:400]))

    def finish(self):
        lane_leak = any(
            DEFAULT_LANE_ROOT in text for text in self.outputs)
        self.record(
            "hermetic-no-lane-path", not lane_leak,
            "default lane root absent from subprocess output"
            if not lane_leak else "subprocess output names the live lane root")
        entries = sorted(os.listdir(self.root))
        unexpected = [
            entry for entry in entries
            if not re.fullmatch(r"\d{2}-[a-z0-9-]+", entry)
        ]
        self.record(
            "hermetic-temp-only", not unexpected,
            "no unexpected temp-root entries" if not unexpected
            else "unexpected entries: {}".format(unexpected))
        shutil.rmtree(self.root, ignore_errors=True)
        total = self.passed + len(self.failed)
        if self.failed:
            sys.stdout.write(
                "SELFTEST: FAIL ({}/{} failed: {})\n".format(
                    len(self.failed), total, ", ".join(self.failed)))
            return 1
        sys.stdout.write("SELFTEST: PASS ({}/{})\n".format(self.passed, total))
        return 0


def run_selftest_cases(harness):
    base = build_fixture_receipt()

    def mutate(change):
        document = copy.deepcopy(base)
        change(document)
        return document

    clean = mutate(lambda document: None)
    clean_bytes = (json.dumps(
        clean, indent=2, sort_keys=True) + "\n").encode("utf-8")
    clean_digest = sha256_bytes(clean_bytes)
    harness.check_case("clean", clean, "context_consistent", 0,
                       receipt_bytes=clean_bytes)

    missing_env = mutate(
        lambda document: document["environment"].pop("injected_env"))
    harness.check_case(
        "missing-injected-env", missing_env, "missing_injected_environment", 1,
        expected_ids=["missing_injected_environment",
                      "receipt_verdict_mismatch"])

    harness.check_case(
        "tampered-before-semantic", missing_env, "snapshot_tampered", 2,
        expected_override={
            "schema": EXPECTED_SCHEMA,
            "receipt_sha256": clean_digest,
            "id": "context_consistent",
            "exit": 0,
        },
        expected_match=False)

    null_env = mutate(
        lambda document: document["environment"].update({"injected_env": None}))
    harness.check_case(
        "null-injected-env", null_env, "missing_injected_environment", 1)

    def comparison_raw_mismatch(document):
        injected = json.loads(document["runs"]["injected"]["stdout"])
        injected["status"] = "drift"
        document["runs"]["injected"]["stdout"] = json.dumps(
            injected, sort_keys=True, separators=(",", ":"))
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: raw observation differs"]
    harness.check_case(
        "comparison-raw-mismatch", mutate(comparison_raw_mismatch),
        "comparison_mismatch", 1)

    def comparison_observed_at_lie(document):
        document["comparison"]["observed_at"]["baseline"] = (
            "2020-01-01T00:00:00Z")
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: recorded observed_at differs"]
    harness.check_case(
        "comparison-observed-at-lie", mutate(comparison_observed_at_lie),
        "comparison_mismatch", 1)

    def payload_digest_lie(document):
        replacement = "0" * 64
        document["sources"]["probe"]["sha256"] = replacement
        document["sources"]["probe"]["declared_sha256"] = replacement
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: probe declaration differs"]
    harness.check_case(
        "payload-digest-lie", mutate(payload_digest_lie),
        "comparison_tool_digest_mismatch", 1)

    def injected_run_failed(document):
        document["runs"]["injected"]["exit"] = 128
        document["runs"]["injected"]["stdout"] = ""
        comparison = document["comparison"]
        comparison["observed_at"]["injected"] = None
        comparison["baseline_comparable_sha256"] = None
        comparison["injected_comparable_sha256"] = None
        comparison["payload_tool_sha256_matches_disk"] = None
        comparison["equal"] = False
        comparison["error"] = (
            "injected probe run produced no JSON document (exit=128)")
        comparison["raw_stdout_equal"] = False
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: injected run failed"]
    harness.check_case(
        "injected-run-failed", mutate(injected_run_failed),
        "comparison_mismatch", 1)

    def injected_deep_malformed(document):
        document["runs"]["injected"]["stdout"] = "[" * 6000 + "]" * 6000
        comparison = document["comparison"]
        comparison["observed_at"]["injected"] = None
        comparison["baseline_comparable_sha256"] = None
        comparison["injected_comparable_sha256"] = None
        comparison["payload_tool_sha256_matches_disk"] = None
        comparison["equal"] = False
        comparison["error"] = (
            "injected probe run produced no JSON document (exit=0)")
        comparison["raw_stdout_equal"] = False
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: injected document is unparsable"]
    harness.check_case(
        "injected-deep-malformed", mutate(injected_deep_malformed),
        "comparison_mismatch", 1)

    def control_ineffective(document):
        document["positive_control"]["injected"]["exit"] = 0
        document["positive_control"]["injected"]["stderr"] = ""
        document["positive_control"]["injected_reflects_poison"] = False
        document["positive_control"]["effective"] = False
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: control ineffective"]
    harness.check_case(
        "control-ineffective", mutate(control_ineffective),
        "positive_control_ineffective", 1)

    def control_flag_lie(document):
        document["positive_control"]["injected"]["exit"] = 0
        document["positive_control"]["injected"]["stderr"] = ""
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: control flags lie"]
    harness.check_case(
        "control-flag-lie", mutate(control_flag_lie),
        "positive_control_ineffective", 1)

    def control_exit_zero_poison(document):
        document["positive_control"]["injected"]["exit"] = 0
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = [
            "fixture: exit zero under a truthful poison marker"]
    harness.check_case(
        "control-exit-zero-poison", mutate(control_exit_zero_poison),
        "positive_control_ineffective", 1)

    def mapping_check_lie(document):
        document["mapping"]["legs"][0]["pin_value"] = "0" * 64
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: mapping check lies"]
    harness.check_case(
        "mapping-check-lie", mutate(mapping_check_lie), "mapping_mismatch", 1)

    mapping_failed = mutate(mapping_check_lie)
    mapping_failed_bytes = (json.dumps(
        mapping_failed, indent=2, sort_keys=True) + "\n").encode("utf-8")
    harness.check_case(
        "mapping-failed-wrong-pin", mapping_failed, "mapping_mismatch", 1,
        receipt_bytes=mapping_failed_bytes,
        expected_override={
            "schema": EXPECTED_SCHEMA,
            "receipt_sha256": sha256_bytes(mapping_failed_bytes),
            "id": "comparison_mismatch",
            "exit": 1,
        },
        expected_match=False,
        expected_ids=["mapping_mismatch", "expected_verdict_mismatch"])

    def mapping_suffix_swap(document):
        js = document["mapping"]["legs"][0]
        bash = document["mapping"]["legs"][1]
        js["declared_variable_suffix"] = bash["declared_variable_suffix"]
        js["pin_value"] = bash["pin_value"]
        js["rev_value"] = bash["rev_value"]
        js["runner_call"]["pin_constant"] = bash["runner_call"]["pin_constant"]
        js["runner_call"]["rev_constant"] = bash["runner_call"]["rev_constant"]
        js["runner_call"]["table_constant"] = (
            bash["runner_call"]["table_constant"])
    harness.check_case(
        "mapping-suffix-swap", mutate(mapping_suffix_swap),
        "mapping_mismatch", 1)

    def mapping_constant_swap(document):
        leg = document["mapping"]["legs"][0]
        other = document["mapping"]["legs"][1]
        leg["runner_call"]["rev_constant"] = (
            "REV_" + EXPECTED_SUFFIX[other["leg"]])
        leg["checks"]["rev_name_and_value_match_manifest"] = False
        leg["checks"]["constant_names_match_leg"] = False
        leg["match"] = all(leg["checks"].values())
        document["mapping"]["all_match"] = all(
            row["match"] for row in document["mapping"]["legs"])
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: equal-valued variable swap"]
    harness.check_case(
        "mapping-constant-swap", mutate(mapping_constant_swap),
        "mapping_mismatch", 1)

    def mapping_order_lie(document):
        document["mapping"]["runner_leg_order"] = list(
            reversed(document["mapping"]["runner_leg_order"]))
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: runner order lies"]
    harness.check_case(
        "mapping-order-lie", mutate(mapping_order_lie), "mapping_mismatch", 1)

    def probe_source_lie(document):
        document["sources"]["probe"]["declared_sha256"] = "1" * 64
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: probe declaration lies"]
    harness.check_case(
        "probe-source-lie", mutate(probe_source_lie),
        "probe_source_digest_mismatch", 1)

    def runner_source_lie(document):
        document["sources"]["runner"]["manifest_declared_sha256"] = "2" * 64
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: runner declaration lies"]
    harness.check_case(
        "runner-source-lie", mutate(runner_source_lie),
        "runner_source_digest_mismatch", 1)

    def probe_flag_false_equal(document):
        document["sources"]["probe"]["matches_declared"] = False
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: probe flag false with equal digest"]
    harness.check_case(
        "probe-flag-false-equal", mutate(probe_flag_false_equal),
        "probe_source_digest_mismatch", 1)

    def runner_flag_false_equal(document):
        document["sources"]["runner"]["matches_manifest_declaration"] = False
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: runner flag false with equal digest"]
    harness.check_case(
        "runner-flag-false-equal", mutate(runner_flag_false_equal),
        "runner_source_digest_mismatch", 1)

    truthy_matches = mutate(
        lambda document: document["sources"]["probe"].update(
            {"matches_declared": 1}))
    harness.check_case(
        "truthy-matches-declared", truthy_matches,
        "receipt_structure_invalid", 2)

    truthy_all_match = mutate(
        lambda document: document["mapping"].update({"all_match": "false"}))
    harness.check_case(
        "truthy-all-match", truthy_all_match,
        "receipt_structure_invalid", 2)

    bool_exit = mutate(lambda document: document.update({"exit": True}))
    harness.check_case("bool-exit", bool_exit, "receipt_structure_invalid", 2)

    widened_exclusions = mutate(
        lambda document: document["comparison"].update(
            {"exclusions": ["observed_at", "tool_sha256"]}))
    harness.check_case(
        "exclusions-widened", widened_exclusions,
        "receipt_structure_invalid", 2)

    comparison_container = mutate(
        lambda document: document.update({"comparison": []}))
    harness.check_case(
        "comparison-container", comparison_container,
        "receipt_structure_invalid", 2)

    harness.check_case(
        "duplicate-key", None, "receipt_json_invalid", 2,
        receipt_bytes=(
            '{"schema": "tameshi-round14-context-receipt-v1", '
            '"schema": "tameshi-round14-context-receipt-v1"}').encode())
    harness.check_case(
        "malformed-json", None, "receipt_json_invalid", 2,
        receipt_bytes=b"{")
    harness.check_case(
        "non-object-json", None, "receipt_json_invalid", 2,
        receipt_bytes=b"[]")
    harness.check_case(
        "invalid-utf8", None, "receipt_json_invalid", 2,
        receipt_bytes=b"\xff\xfe{")

    harness.check_case(
        "receipt-missing", None, "receipt_missing", 2,
        receipt_bytes=b"absent\n", write_receipt=False)

    harness.check_case(
        "snapshot-tampered", clean, "snapshot_tampered", 2,
        expected_override={
            "schema": EXPECTED_SCHEMA,
            "receipt_sha256": "0" * 64,
            "id": "context_consistent",
            "exit": 0,
        },
        expected_match=False)

    harness.check_case(
        "expected-missing", clean, "expected_missing", 2,
        write_expected=False, expected_match=None)

    harness.check_case(
        "expected-invalid", clean, "expected_invalid", 2,
        expected_override={
            "schema": "not-the-expected-schema",
            "receipt_sha256": "0" * 64,
            "id": "context_consistent",
            "exit": 0,
        },
        expected_match=None)

    harness.check_case(
        "expected-verdict-mismatch", clean, "expected_verdict_mismatch", 1,
        expected_override={
            "schema": EXPECTED_SCHEMA,
            "receipt_sha256": clean_digest,
            "id": "comparison_mismatch",
            "exit": 1,
        },
        expected_match=False)

    def stored_verdict_lie(document):
        document["status"] = "mismatch"
        document["exit"] = 1
        document["reasons"] = ["fixture: stored verdict does not match raw fields"]
    harness.check_case(
        "stored-verdict-lie", mutate(stored_verdict_lie),
        "receipt_verdict_mismatch", 1)

    invalid = {
        "schema": RECEIPT_SCHEMA,
        "tool": "context-capture.py r15 selftest fixture",
        "tool_sha256": "a" * 64,
        "observed_at": "2026-10-20T00:00:03Z",
        "lane_root": "/fixture/lane",
        "fleet_root": "/fixture",
        "invocation": {"argv": ["fixture"], "cwd": "/fixture/lane"},
        "environment": {
            "baseline_policy": "fixture",
            "injected_policy": "fixture",
            "injected_env": None,
            "env_delta_keys": None,
            "env_delta_matches_declared": None,
            "baseline_has_GIT_DIR": None,
            "ambient_git_keys_removed": [],
            "poison_path": None,
            "poison_path_exists": None,
            "ambient_env_dumped": False,
        },
        "sources": {},
        "runs": {},
        "comparison": {},
        "positive_control": {},
        "mapping": {},
        "result_reuse": "not_established",
        "result_reuse_reason": "fixture: retained invalid-input record",
        "not_compared": list(NOT_COMPARED_LIMITS),
        "status": "invalid_input",
        "exit": 2,
        "error": {"kind": "missing_input", "message": "fixture"},
        "reasons": ["missing_input: fixture"],
    }
    harness.check_case(
        "retained-invalid-input", invalid, "receipt_records_invalid_input", 2)

    harness.check_case(
        "expected-digest-invalid", clean, "expected_invalid", 2,
        expected_override={
            "schema": EXPECTED_SCHEMA,
            "receipt_sha256": "not-a-digest",
            "id": "context_consistent",
            "exit": 0,
        },
        expected_match=None)

    duplicate_expected = (
        '{"schema": "tameshi-context-expected-v1", '
        '"receipt_sha256": "' + clean_digest + '", '
        '"receipt_sha256": "' + clean_digest + '", '
        '"id": "context_consistent", "exit": 0}').encode("utf-8")
    harness.check_case(
        "expected-duplicate-key", clean, "expected_invalid", 2,
        receipt_bytes=clean_bytes, expected_bytes=duplicate_expected,
        expected_match=None)

    baseline_unusable = mutate(
        lambda document: document["runs"]["baseline"].update({"stdout": "{}"}))
    harness.check_case(
        "baseline-unusable", baseline_unusable, "baseline_unusable", 2)

    harness.usage_case("usage-no-args", [])
    harness.usage_case(
        "usage-receipt-without-expected", ["--check", "--receipt", "receipt.json"])
    harness.usage_case(
        "usage-expected-without-receipt", ["--check", "--expected", "expected.json"])
    harness.usage_case(
        "usage-receipt-final-missing",
        ["--check", "--expected", "expected.json", "--receipt"])
    harness.usage_case(
        "usage-receipt-flag-as-value",
        ["--check", "--expected", "expected.json", "--receipt", "--json"])
    harness.usage_case("usage-unknown-flag", ["--check", "--bogus"])
    harness.usage_case("usage-selftest-extra", ["--selftest", "--json"])


def run_selftest():
    harness = None
    try:
        harness = SelftestHarness()
        run_selftest_cases(harness)
        return harness.finish()
    except Exception as exc:  # setup failure is loud but never a traceback
        sys.stdout.write(
            "SELFTEST: FAIL (setup error: {}: {})\n".format(
                type(exc).__name__, exc))
        return 2
    finally:
        if harness is not None:
            shutil.rmtree(harness.root, ignore_errors=True)


# ------------------------------------------------------------------------ CLI


def parse_argv(argv):
    if not argv:
        raise UsageError("a mode is required")
    if argv in (["-h"], ["--help"]):
        return {"help": True}
    mode = None
    receipt = None
    expected = None
    as_json = False
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument == "--check":
            if mode is not None:
                raise UsageError("mode given twice")
            mode = "check"
            index += 1
        elif argument == "--selftest":
            if mode is not None:
                raise UsageError("mode given twice")
            mode = "selftest"
            index += 1
        elif argument == "--json":
            if as_json:
                raise UsageError("--json given twice")
            as_json = True
            index += 1
        elif argument in ("--receipt", "--expected"):
            if index + 1 >= len(argv):
                raise UsageError(argument + " needs a value")
            value = argv[index + 1]
            if not value:
                raise UsageError(argument + " has an empty value")
            if value in KNOWN_ARGUMENTS:
                raise UsageError(
                    argument + " cannot take a recognized flag as its value: "
                    + value)
            index += 2
            if argument == "--receipt":
                if receipt is not None:
                    raise UsageError("--receipt given twice")
                receipt = value
            else:
                if expected is not None:
                    raise UsageError("--expected given twice")
                expected = value
        else:
            raise UsageError("unknown argument: " + argument)
    if mode is None:
        raise UsageError("a mode is required")
    if mode == "selftest":
        if receipt is not None or expected is not None or as_json:
            raise UsageError("--selftest takes no other arguments")
        return {"selftest": True}
    if (receipt is None) != (expected is None):
        raise UsageError("--receipt and --expected must be given together")
    return {
        "selftest": False,
        "json": as_json,
        "receipt": receipt,
        "expected": expected,
    }


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    try:
        options = parse_argv(argv)
    except UsageError as exc:
        sys.stderr.write(USAGE)
        sys.stderr.write(
            "context-capture.py: {}\nCONTEXT: USAGE_ERROR (id=usage_error "
            "exit=64)\n".format(exc))
        return 64
    if options.get("help"):
        sys.stdout.write(USAGE)
        return 0
    if options.get("selftest"):
        return run_selftest()
    try:
        return emit(run_check(options), options["json"])
    except CouldNotEvaluate as exc:
        result = result_from_exception(
            exc, "frozen" if options["receipt"] is None else "explicit",
            options["receipt"] or FROZEN_RECEIPT_REL, None, None, None)
        return emit(result, options["json"])
    except Exception as exc:  # fail closed, never traceback on retained data
        failure = CouldNotEvaluate(
            "internal_error", "{}: {}".format(type(exc).__name__, exc))
        result = result_from_exception(
            failure, "frozen" if options["receipt"] is None else "explicit",
            options["receipt"] or FROZEN_RECEIPT_REL, None, None, None)
        return emit(result, options["json"])


if __name__ == "__main__":
    raise SystemExit(main())


SOURCE tools/evidence-disposition.py sha256=66655a3a692b587fd0a6dc3f2cf0edd766a824eb86280753d0bd57efeecc1f44
#!/usr/bin/env python3
"""evidence-disposition.py — expectation disposition gate (tameshi-shokunin round 14).

Question answered: does one dispositions document account for every frozen
round-13 expected check exactly once, and does each disposition row bind to a
raw receipt observation that satisfies the original expectation — or, for the
one configured supersession, retain a genuinely mismatched raw observation
while both declared replacements pass?

This is a gate over declarations and retained receipt JSON. It never executes
receipt argv. Pins in the dispositions document are configured authority for
the bytes read here; they are not an authentication or preregistration claim,
and passing this gate does not prove that any recorded command was rerun.

Disposition schema `evidence-dispositions-v1`:
  {"schema": "evidence-dispositions-v1",
   "expected_file": <lane-relative path>,
   "inputs": {<lane-relative path>: <64 lowercase hex sha256>, ...},
   "rows": [effective | superseded, ...]}

  Schema `evidence-dispositions-v2` (round-17 R16-OP1) keeps every v1 field
  and adds:
    "supersedes": lane-relative path of the v1 manifest this document
      supersedes; informational, and it must itself be pinned in `inputs`.
    "historical_inputs": {<lane-relative path>: {"rev": <40-hex commit>,
      "reason": <text>}}. For each declared path the expected-input bytes are
      read with `git -C <root> cat-file blob --end-of-options <rev>:<path>`
      instead of the live file, after a repo-identity guard (realpath of
      `git -C <root> rev-parse --show-toplevel` must equal realpath(root)).
      Keys must start with `tools/` (lane instruments move by design; evidence
      never) and must appear in expected.json's `inputs`; the blob digest must
      still equal the expected pin. Every other input keeps live-tree
      integrity-first verification. The payload adds
      `expected_inputs_historical` {path: rev}.
      Failure ids (exit 2): historical_input_forbidden,
      historical_input_unknown, historical_input_unavailable,
      expected_input_digest_mismatch, historical_input_unneeded,
      historical_input_uncommitted, supersedes_mismatch.

  v2 guards (round-17 hardening):
    G1 historical_input_unneeded: a waived path whose live bytes still equal
       the expected pin must not be waived (the waiver set is derived from
       observed drift, not author choice).
    G2 historical_input_uncommitted: the live bytes of a waived path must equal
       that path in the run's committed anchor A; an uncommitted worktree edit,
       a symlink, or deletion while A still has the path is tampering. A
       committed deletion is allowed.
    G3 rev must resolve to exactly that commit id (tree/blob/HEAD/branch/abbrev
       rejected) and be an ancestor of the same anchor A, else
       historical_input_unavailable.
    Anchor A is refs/heads/<lane.branch> or an attached local branch tip when
    bound. An unbound jj workspace is refused; an unbound detached non-jj
    harness uses HEAD only when a local or remote-tracking ref contains it.
    G4 every git subprocess scrubs all inherited GIT_* variables and sets
       GIT_NO_REPLACE_OBJECTS=1, GIT_GRAFT_FILE=/dev/null,
       GIT_CONFIG_NOSYSTEM=1, GIT_CONFIG_GLOBAL=/dev/null; the root must be a
       non-shallow work tree whose --absolute-git-dir is <root>/.git.
    G5 the tree entry must be a 100644/100755 blob; bytes are read, never text.
    G6 text mode prints one `HISTORICAL <path> rev=<rev> sha256=<sha>` line per
       waiver; JSON carries expected_inputs_historical (and historical_text).
    G7 `supersedes` must name a v1 manifest with this document's expected_file
       and rows, whose inputs are pinned identically (supersedes_mismatch).

  effective row keys are exactly:
      name, state="effective", receipt, check
    name and check must be the same string; the check must exist in the named
    receipt. A different same-shaped check (e.g. pin_live -> pin_env_scrub)
    is rejected by `effective_check_name_mismatch`.

  superseded row keys are exactly:
      name, state="superseded", reason, raw_receipt, raw_check, superseded_by
    Only `producer_before` may be superseded (configured round-14 policy).
    raw_receipt/raw_check name the retained raw observation; it is re-evaluated
    against the original expectation and must genuinely mismatch. The
    replacement list must be exactly producer_before_oracle and
    producer_after_oracle; both must be effective rows with check == name and
    must pass. The producer-oracle receipt must declare
    `supersedes` starting "verification.json producer_before" and its
    `oracle_sha256` must equal expected.inputs[producer-oracle.py].

Receipt and raw_receipt values are lane-relative canonical paths that must
appear as `inputs` keys. They must live in the expected file's directory.
`inputs` must pin the expected file and the two round-13 sibling receipts
(verification.json, producer-oracle-repair.json). Every declared pin is hashed
and checked before any expectation predicate runs. expected.json's own
`inputs` map is also verified in full before predicates.

Every file is read once through an O_NOFOLLOW descriptor, lstat/fstat identity
is compared, and the same cached bytes are hashed and parsed. Absolute paths,
"..", ".", "\\", NUL, repeated or trailing separators, symlink components and
non-regular files are rejected.

Predicates use only the original expected fields: exit, contains, id, reason,
rows, statuses, result_reuse. `contains` is a literal substring of the receipt
check's stdout only (never stderr). Structured predicates parse stdout as one
JSON object:
  id/reason            exact value at the top level
  rows                 top-level rows (int or list length), counts.legs, and
                       len(legs) must all agree when present
  statuses             expected histogram compared against top-level statuses,
                       counts, and the per-leg content_status histogram;
                       an absent status counts as 0
  result_reuse         top-level and every per-leg result_reuse must agree
Receipt `expected_exit`/`exit_matches` fields are never trusted. Receipt-only
checks stay informational and never become expectations.

Exit map:
  0  clean: every expected check accounted for, all predicates pass
  1  failed semantic expectation (row graph or predicate mismatch)
  2  could-not-evaluate: missing/unreadable/malformed/tampered/path-invalid
     input, invalid schema/type, or an unexpected internal failure
  64 usage error

Output: stable finding IDs, one disposition record per expected check, and
mismatch details. `--json` emits the full document; text output is one summary
line, ROW lines and FINDING lines.

CLI:
  evidence-disposition.py --root LANE --dispositions FILE [--json]
  evidence-disposition.py --selftest
Selftest also requires `jj` for its isolated colocated-repository cases.
"""

import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from collections import defaultdict
from pathlib import Path, PurePosixPath

VERSION = "evidence-disposition.py r18 (tameshi-shokunin, 2026-10-20): branch-tip v2 historical inputs"
SELF = os.path.realpath(__file__)

SCHEMA = "evidence-dispositions-v1"
SCHEMA_V2 = "evidence-dispositions-v2"
SCHEMAS = (SCHEMA, SCHEMA_V2)
RESULT_SCHEMA = "evidence-disposition-result-v1"
HEX64 = re.compile(r"[0-9a-f]{64}")
HEX40 = re.compile(r"[0-9a-f]{40}")

EXPECTATION_FIELDS = frozenset(
    ("exit", "contains", "id", "reason", "rows", "statuses", "result_reuse")
)
EFFECTIVE_KEYS = frozenset(("name", "state", "receipt", "check"))
SUPERSEDED_KEYS = frozenset(
    ("name", "state", "reason", "raw_receipt", "raw_check", "superseded_by")
)

# Round-14 configured supersession policy. Only the routed producer_before row
# may be superseded, and only by the two oracle observations.
SUPERSEDED_POLICY = {
    "producer_before": {
        "raw_receipt": "verification.json",
        "raw_check": "producer_before",
        "replacements": ("producer_before_oracle", "producer_after_oracle"),
    }
}
REQUIRED_RECEIPTS = ("verification.json", "producer-oracle-repair.json")
ORACLE_RECEIPT = "producer-oracle-repair.json"
ORACLE_INPUT = "producer-oracle.py"
ORACLE_SUPERSEDES_PREFIX = "verification.json producer_before"

USAGE = """usage: evidence-disposition.py --root LANE --dispositions FILE [--json]
       evidence-disposition.py --selftest

Expectation-disposition gate: every frozen expected check appears exactly once
in rows; effective rows must satisfy their original expectation from a named
receipt check; the one configured producer_before supersession must retain a
genuinely mismatched raw observation and pass both oracle replacements.

exit 0   clean
exit 1   failed semantic expectation
exit 2   could-not-evaluate bad/missing/tampered input
exit 64  usage error

Receipt/raw_receipt values are lane-relative paths pinned in `inputs`. The tool
never executes receipt argv. `--selftest` builds isolated /tmp fixtures.
evidence-dispositions-v2 manifests add `supersedes` (pinned v1 manifest path)
and `historical_inputs` (tools/* expected inputs read as git blobs at the
declared rev after a repo-identity guard). A waiver is refused when the live
bytes still equal the pin (historical_input_unneeded) or differ from the
selected committed anchor (historical_input_uncommitted); revs must be commits
ancestral to that same anchor.
"""


class CouldNotEvaluate(Exception):
    """Input that prevents the disposition question from being evaluated."""

    def __init__(self, finding_id, detail):
        super().__init__(detail)
        self.finding_id = finding_id
        self.detail = detail


class UsageError(Exception):
    pass


# ------------------------------------------------------------------ utilities


def sha256_bytes(payload):
    return hashlib.sha256(payload).hexdigest()


def tool_sha256():
    try:
        with open(SELF, "rb") as handle:
            return sha256_bytes(handle.read())
    except OSError:
        return None


def _reject_duplicate_keys(pairs):
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise ValueError("duplicate JSON key: {!r}".format(key))
        seen[key] = value
    return seen


def _reject_constant(token):
    raise ValueError("non-finite JSON constant: {}".format(token))


def parse_json_object(raw, label):
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise CouldNotEvaluate(label + "_json_invalid", "not valid UTF-8")
    try:
        value = json.loads(
            text,
            object_pairs_hook=_reject_duplicate_keys,
            parse_constant=_reject_constant,
        )
    except (ValueError, json.JSONDecodeError) as exc:
        raise CouldNotEvaluate(label + "_json_invalid", "malformed JSON: {}".format(exc))
    if not isinstance(value, dict):
        raise CouldNotEvaluate(label + "_json_invalid", "top-level JSON value is not an object")
    return value


def _is_int(value):
    return type(value) is int


def _short(value, limit=180):
    text = repr(value)
    return text if len(text) <= limit else text[:limit] + "..."


# --------------------------------------------------------------- safe reading


def canonical_relative(value, label):
    if not isinstance(value, str) or not value:
        raise CouldNotEvaluate("path_rejected", "{}: empty or non-string relative path".format(label))
    if "\x00" in value:
        raise CouldNotEvaluate("path_rejected", "{}: NUL byte in path".format(label))
    if "\\" in value:
        raise CouldNotEvaluate("path_rejected", "{}: backslash in path".format(label))
    pure = PurePosixPath(value)
    if pure.is_absolute():
        raise CouldNotEvaluate("path_rejected", "{}: absolute path".format(label))
    if any(part == ".." for part in pure.parts):
        raise CouldNotEvaluate("path_rejected", "{}: parent traversal".format(label))
    if str(pure) != value:
        raise CouldNotEvaluate(
            "path_rejected", "{}: non-canonical relative path {!r}".format(label, value)
        )
    if str(pure) == ".":
        raise CouldNotEvaluate("path_rejected", "{}: empty path".format(label))
    return pure


def safe_file(lane, relative, label):
    """Resolve a declared lane-relative path without escaping or symlinks."""
    pure = canonical_relative(relative, label)
    current = lane
    for part in pure.parts:
        current = current / part
        try:
            st = os.lstat(current)
        except FileNotFoundError:
            raise CouldNotEvaluate(label + "_missing", "{}: {}: missing".format(label, relative))
        except OSError as exc:
            raise CouldNotEvaluate(
                label + "_unreadable",
                "{}: {}: {}".format(label, relative, exc.strerror or exc),
            )
        if stat.S_ISLNK(st.st_mode):
            raise CouldNotEvaluate(
                "path_rejected", "{}: symlink component in {}".format(label, relative)
            )
    try:
        st = os.lstat(current)
    except OSError as exc:
        raise CouldNotEvaluate(
            label + "_unreadable", "{}: {}: {}".format(label, relative, exc.strerror or exc)
        )
    if not stat.S_ISREG(st.st_mode):
        raise CouldNotEvaluate("path_rejected", "{}: not a regular file".format(label))
    try:
        current.resolve().relative_to(lane)
    except ValueError:
        raise CouldNotEvaluate("path_rejected", "{}: resolves outside lane root".format(label))
    return current


def read_regular(path, label):
    """O_NOFOLLOW read; lstat/fstat identity checked; exactly one read."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        before = os.lstat(path)
    except FileNotFoundError:
        raise CouldNotEvaluate(label + "_missing", "{}: missing".format(label))
    except OSError as exc:
        raise CouldNotEvaluate(label + "_unreadable", "{}: {}".format(label, exc.strerror or exc))
    if not stat.S_ISREG(before.st_mode):
        raise CouldNotEvaluate("path_rejected", "{}: not a regular file".format(label))
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        raise CouldNotEvaluate(label + "_missing", "{}: missing".format(label))
    except OSError as exc:
        raise CouldNotEvaluate(label + "_unreadable", "{}: {}".format(label, exc.strerror or exc))
    try:
        after = os.fstat(fd)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise CouldNotEvaluate("path_rejected", "{}: file changed during read".format(label))
        if not stat.S_ISREG(after.st_mode):
            raise CouldNotEvaluate("path_rejected", "{}: not a regular file".format(label))
        chunks = []
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)
    except OSError as exc:
        raise CouldNotEvaluate(label + "_unreadable", "{}: {}".format(label, exc.strerror or exc))
    finally:
        os.close(fd)


def read_dispositions(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        raise CouldNotEvaluate("dispositions_missing", str(path))
    except OSError as exc:
        raise CouldNotEvaluate("dispositions_unreadable", "{}: {}".format(path, exc.strerror or exc))
    if stat.S_ISLNK(st.st_mode):
        raise CouldNotEvaluate("path_rejected", "dispositions: symlink")
    if not stat.S_ISREG(st.st_mode):
        raise CouldNotEvaluate("path_rejected", "dispositions: not a regular file")
    return read_regular(path, "dispositions")

# ------------------------------------------------- historical input reading

# G4: every git subprocess runs without inherited GIT_* state, without replace
# refs and without grafts, so environment/replace/graft attacks cannot rewrite
# the bytes this gate reads.
GIT_ENV_OVERRIDES = {
    "GIT_NO_REPLACE_OBJECTS": "1",
    "GIT_GRAFT_FILE": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_CONFIG_GLOBAL": "/dev/null",
}


def _stderr_text(proc):
    if proc.stderr is None:
        return ""
    if isinstance(proc.stderr, bytes):
        return proc.stderr.decode("utf-8", "replace").strip()
    return str(proc.stderr).strip()


def git_environment():
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(GIT_ENV_OVERRIDES)
    return env


def git_call(lane, argv, timeout=30):
    """Hermetic git subprocess (bytes, never text)."""
    try:
        return subprocess.run(
            ["git", "-C", str(lane)] + list(argv),
            capture_output=True,
            env=git_environment(),
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "git {}: {}".format(argv[0], exc),
        )


def _git_failure(proc, action):
    return CouldNotEvaluate(
        "historical_input_unavailable",
        "{}: {}".format(action, _stderr_text(proc) or "exit {}".format(proc.returncode)),
    )


def verify_repo(lane):
    """G4 identity/topology guard: <lane> is its own non-shallow work tree."""
    proc = git_call(lane, ["rev-parse", "--absolute-git-dir", "--show-toplevel"])
    if proc.returncode != 0:
        raise _git_failure(proc, "root is not inside a git work tree")
    lines = proc.stdout.decode("utf-8", "replace").splitlines()
    if len(lines) != 2:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "rev-parse --absolute-git-dir --show-toplevel returned {!r}".format(lines),
        )
    git_dir, toplevel = lines
    lane_real = os.path.realpath(str(lane))
    if os.path.realpath(toplevel) != lane_real:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "root is not the toplevel of its own work tree "
            "(git reports {!r})".format(toplevel),
        )
    if os.path.realpath(git_dir) != os.path.join(lane_real, ".git"):
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "git dir {!r} is not <root>/.git".format(git_dir),
        )
    proc = git_call(lane, ["rev-parse", "--is-shallow-repository"])
    if proc.returncode != 0 or proc.stdout.decode("utf-8", "replace").strip() != "false":
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "root is a shallow repository; historical blobs are not provable",
        )


def _commit_of(lane, revision):
    """Return a canonical 40-hex commit id, or None when revision is unavailable."""
    proc = git_call(
        lane,
        ["rev-parse", "--verify", "--quiet", "--end-of-options", revision + "^{commit}"],
    )
    commit = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode != 0 or not HEX40.fullmatch(commit):
        return None
    return commit


def resolve_historical_anchor(lane):
    """Resolve one committed anchor shared by G2 and G3."""
    proc = git_call(lane, ["config", "--get", "lane.branch"])
    if proc.returncode not in (0, 1):
        raise _git_failure(proc, "cannot read lane.branch")
    branch = proc.stdout.decode("utf-8", "replace").strip() if proc.returncode == 0 else ""
    if not branch:
        proc = git_call(lane, ["symbolic-ref", "-q", "HEAD"])
        if proc.returncode == 0:
            ref = proc.stdout.decode("utf-8", "replace").strip()
            prefix = "refs/heads/"
            if ref.startswith(prefix):
                branch = ref[len(prefix):]
        elif proc.returncode != 1:
            raise _git_failure(proc, "cannot resolve HEAD branch")

    if branch:
        branch_ref = "refs/heads/" + branch
        proc = git_call(lane, ["check-ref-format", branch_ref])
        if proc.returncode != 0:
            raise CouldNotEvaluate(
                "historical_input_unavailable",
                "invalid local lane branch {!r}".format(branch),
            )
        commit = _commit_of(lane, branch_ref)
        if commit is None:
            raise CouldNotEvaluate(
                "historical_input_unavailable",
                "lane branch {} does not resolve to a commit".format(branch_ref),
            )
        return branch_ref, commit

    if os.path.lexists(str(lane / ".jj")):
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "jj workspace without a lane.branch binding has no authoritative tip",
        )

    commit = _commit_of(lane, "HEAD")
    if commit is None:
        raise CouldNotEvaluate(
            "historical_input_unavailable", "HEAD does not resolve to a commit"
        )
    proc = git_call(
        lane,
        [
            "for-each-ref",
            "--contains",
            commit,
            "--format=%(refname)",
            "refs/heads/",
            "refs/remotes/",
        ],
    )
    if proc.returncode != 0:
        raise _git_failure(proc, "cannot find a ref containing detached HEAD")
    containing_refs = [
        ref for ref in proc.stdout.decode("utf-8", "replace").splitlines()
        if ref and not ref.endswith("/HEAD")
    ]
    if not containing_refs:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "detached HEAD {} is on no branch or remote-tracking branch".format(commit),
        )
    return "HEAD", commit


def resolve_historical_rev(lane, rev, anchor_label, anchor_commit):
    """G3: rev is exactly that commit id and an ancestor of anchor_commit."""
    proc = git_call(lane, ["rev-parse", "--verify", "--end-of-options", rev + "^{commit}"])
    resolved = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode != 0 or resolved != rev:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "rev {!r} does not resolve to that commit (got {!r})".format(rev, resolved),
        )
    proc = git_call(
        lane,
        ["merge-base", "--is-ancestor", "--end-of-options", rev, anchor_commit],
    )
    if proc.returncode != 0:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "rev {} is not an ancestor of {} ({})".format(rev, anchor_label, anchor_commit),
        )



TREE_MODES = ("100644", "100755")


def tree_entry(lane, rev, path):
    """(mode, type, object id) for <path> at <rev>, or None when absent."""
    proc = git_call(lane, ["ls-tree", "-z", "--full-tree", rev, "--", path])
    if proc.returncode != 0:
        raise _git_failure(proc, "ls-tree {}:{}".format(rev, path))
    records = [item for item in proc.stdout.split(b"\0") if item]
    if not records:
        return None
    if len(records) != 1:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: ambiguous tree entries at {}".format(path, rev),
        )
    meta, _, name = records[0].partition(b"\t")
    fields = meta.decode("utf-8", "replace").split()
    if len(fields) != 3 or name.decode("utf-8", "replace") != path:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: unparsable tree entry at {}".format(path, rev),
        )
    return fields[0], fields[1], fields[2]


def read_blob(lane, object_id, path):
    proc = git_call(lane, ["cat-file", "blob", object_id])
    if proc.returncode != 0:
        raise _git_failure(proc, "{}: blob {} unavailable".format(path, object_id))
    return proc.stdout


def live_regular_bytes(lane, path):
    """Live bytes only when every component is a real directory/file."""
    current = Path(lane)
    for part in PurePosixPath(path).parts:
        current = current / part
        try:
            st = os.lstat(current)
        except OSError:
            return None
        if stat.S_ISLNK(st.st_mode):
            return None
    if not stat.S_ISREG(st.st_mode):
        return None
    try:
        return read_regular(current, "historical_input")
    except CouldNotEvaluate:
        return None


def check_historical_waiver(lane, path, pin, anchor_label, anchor_commit):
    """G1/G2: the waiver must be needed and committed at the shared anchor."""
    live = live_regular_bytes(lane, path)
    if live is not None and sha256_bytes(live) == pin:
        raise CouldNotEvaluate(
            "historical_input_unneeded",
            "{}: live bytes still equal the expected pin; the waiver is unnecessary".format(path),
        )
    anchor_entry = tree_entry(lane, anchor_commit, path)
    if live is None:
        if anchor_entry is not None:
            raise CouldNotEvaluate(
                "historical_input_uncommitted",
                "{}: live path is absent or not a regular file but {} has an entry".format(
                    path, anchor_label
                ),
            )
        return
    if anchor_entry is None:
        raise CouldNotEvaluate(
            "historical_input_uncommitted",
            "{}: live path is not present at {}".format(path, anchor_label),
        )
    if anchor_entry[1] != "blob":
        raise CouldNotEvaluate(
            "historical_input_uncommitted",
            "{}: {} entry is a {} not a blob".format(path, anchor_label, anchor_entry[1]),
        )
    if sha256_bytes(read_blob(lane, anchor_entry[2], path)) != sha256_bytes(live):
        raise CouldNotEvaluate(
            "historical_input_uncommitted",
            "{}: live bytes differ from {}:{}".format(path, anchor_label, path),
        )


def historical_blob(lane, rev, path):
    """G5: regular blob (100644/100755) bytes at <rev>, never text."""
    entry = tree_entry(lane, rev, path)
    if entry is None:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: absent at rev {}".format(path, rev),
        )
    mode, kind, object_id = entry
    if kind != "blob" or mode not in TREE_MODES:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: tree entry mode {} type {} is not a regular blob".format(path, mode, kind),
        )
    return read_blob(lane, object_id, path)


# ------------------------------------------------------------- schema checks


def validate_inputs(raw_inputs):
    if not isinstance(raw_inputs, dict) or not raw_inputs:
        raise CouldNotEvaluate("dispositions_field_invalid", "inputs must be a non-empty object")
    pinned = {}
    for key, digest in raw_inputs.items():
        pure = canonical_relative(key, "input")
        canonical = str(pure)
        if canonical in pinned:
            raise CouldNotEvaluate("path_rejected", "duplicate input pin for {}".format(canonical))
        if not isinstance(digest, str) or not HEX64.fullmatch(digest):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: sha256 must be 64 lowercase hex characters".format(key),
            )
        pinned[canonical] = digest
    return pinned


def validate_historical_inputs(raw):
    """v2 historical_inputs: tools/* paths read from a pinned git revision."""
    if not isinstance(raw, dict):
        raise CouldNotEvaluate(
            "dispositions_field_invalid", "historical_inputs must be an object"
        )
    historical = {}
    for key, entry in raw.items():
        canonical = str(canonical_relative(key, "historical_input"))
        if canonical in historical:
            raise CouldNotEvaluate(
                "path_rejected", "duplicate historical input {}".format(canonical)
            )
        if not canonical.startswith("tools/"):
            raise CouldNotEvaluate(
                "historical_input_forbidden",
                "{}: historical inputs must be tools/* paths".format(canonical),
            )
        if not isinstance(entry, dict):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: historical input must be an object with rev and reason".format(canonical),
            )
        rev = entry.get("rev")
        if not isinstance(rev, str) or not HEX40.fullmatch(rev):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: rev must be 40 lowercase hex characters".format(canonical),
            )
        reason = entry.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: reason must be a non-empty string".format(canonical),
            )
        historical[canonical] = rev
    return historical


def receipt_canonical(value, expected_rel):
    if not isinstance(value, str) or not value:
        raise CouldNotEvaluate("dispositions_field_invalid", "receipt must be a non-empty string")
    canonical = str(canonical_relative(value, "receipt"))
    if PurePosixPath(canonical).parent != PurePosixPath(expected_rel).parent:
        raise CouldNotEvaluate(
            "receipt_out_of_scope",
            "receipt {} is not in the expected file's directory".format(canonical),
        )
    return canonical


def validate_rows(raw_rows, expected_rel, pinned):
    if not isinstance(raw_rows, list) or not raw_rows:
        raise CouldNotEvaluate("dispositions_field_invalid", "rows must be a non-empty list")
    rows = []
    for index, row in enumerate(raw_rows):
        if not isinstance(row, dict):
            raise CouldNotEvaluate("row_invalid", "rows[{}] is not an object".format(index))
        name = row.get("name")
        state = row.get("state")
        if not isinstance(name, str) or not name:
            raise CouldNotEvaluate("row_invalid", "rows[{}]: name must be a non-empty string".format(index))
        if state == "effective":
            if set(row) != EFFECTIVE_KEYS:
                raise CouldNotEvaluate(
                    "row_invalid",
                    "{}: effective row keys must be exactly {}".format(
                        name, ", ".join(sorted(EFFECTIVE_KEYS))
                    ),
                )
            receipt = row.get("receipt")
            check = row.get("check")
            if not isinstance(check, str) or not check:
                raise CouldNotEvaluate("row_invalid", "{}: check must be a non-empty string".format(name))
            receipt_rel = receipt_canonical(receipt, expected_rel)
            if receipt_rel not in pinned:
                raise CouldNotEvaluate(
                    "input_unpinned", "{}: receipt {} is not pinned in inputs".format(name, receipt_rel)
                )
            rows.append(
                {"name": name, "state": "effective", "receipt_rel": receipt_rel, "check": check}
            )
        elif state == "superseded":
            if set(row) != SUPERSEDED_KEYS:
                raise CouldNotEvaluate(
                    "row_invalid",
                    "{}: superseded row keys must be exactly {}".format(
                        name, ", ".join(sorted(SUPERSEDED_KEYS))
                    ),
                )
            reason = row.get("reason")
            raw_check = row.get("raw_check")
            replacements = row.get("superseded_by")
            if not isinstance(reason, str):
                raise CouldNotEvaluate("row_invalid", "{}: reason must be a string".format(name))
            if not isinstance(raw_check, str) or not raw_check:
                raise CouldNotEvaluate("row_invalid", "{}: raw_check must be a non-empty string".format(name))
            if not isinstance(replacements, list) or not all(
                isinstance(item, str) and item for item in replacements
            ):
                raise CouldNotEvaluate(
                    "row_invalid", "{}: superseded_by must be a list of non-empty names".format(name)
                )
            raw_rel = receipt_canonical(row.get("raw_receipt"), expected_rel)
            if raw_rel not in pinned:
                raise CouldNotEvaluate(
                    "input_unpinned", "{}: raw_receipt {} is not pinned in inputs".format(name, raw_rel)
                )
            rows.append(
                {
                    "name": name,
                    "state": "superseded",
                    "reason": reason,
                    "raw_rel": raw_rel,
                    "raw_check": raw_check,
                    "superseded_by": list(replacements),
                }
            )
        else:
            raise CouldNotEvaluate(
                "row_invalid", "{}: state must be 'effective' or 'superseded'".format(name)
            )
    return rows


def validate_expectation(name, spec):
    if not isinstance(spec, dict):
        raise CouldNotEvaluate("expectation_invalid", "{}: expectation is not an object".format(name))
    unknown = sorted(set(spec) - EXPECTATION_FIELDS)
    if unknown:
        raise CouldNotEvaluate(
            "expectation_invalid", "{}: unsupported expectation field(s) {}".format(name, ", ".join(unknown))
        )
    if "exit" not in spec or not _is_int(spec["exit"]):
        raise CouldNotEvaluate("expectation_invalid", "{}: exit must be an integer".format(name))
    for field in ("contains", "id", "reason", "result_reuse"):
        if field in spec and (not isinstance(spec[field], str) or not spec[field]):
            raise CouldNotEvaluate(
                "expectation_invalid", "{}: {} must be a non-empty string".format(name, field)
            )
    if "rows" in spec and (not _is_int(spec["rows"]) or spec["rows"] < 0):
        raise CouldNotEvaluate("expectation_invalid", "{}: rows must be a non-negative integer".format(name))
    if "statuses" in spec:
        statuses = spec["statuses"]
        if not isinstance(statuses, dict) or not statuses:
            raise CouldNotEvaluate("expectation_invalid", "{}: statuses must be a non-empty object".format(name))
        for key, count in statuses.items():
            if not isinstance(key, str) or not key:
                raise CouldNotEvaluate("expectation_invalid", "{}: status name must be a string".format(name))
            if not _is_int(count) or count < 0:
                raise CouldNotEvaluate(
                    "expectation_invalid", "{}: status {} must be a non-negative integer".format(name, key)
                )
    return spec


def validate_expected(expected):
    raw_inputs = expected.get("inputs")
    if not isinstance(raw_inputs, dict) or not raw_inputs:
        raise CouldNotEvaluate("expected_structure_invalid", "expected.inputs must be a non-empty object")
    expected_inputs = {}
    for key, digest in raw_inputs.items():
        canonical = str(canonical_relative(key, "expected_input"))
        if canonical in expected_inputs:
            raise CouldNotEvaluate(
                "expected_structure_invalid", "duplicate expected input path {}".format(canonical)
            )
        if not isinstance(digest, str) or not HEX64.fullmatch(digest):
            raise CouldNotEvaluate(
                "expected_structure_invalid",
                "{}: sha256 must be 64 lowercase hex characters".format(key),
            )
        expected_inputs[canonical] = digest
    raw_checks = expected.get("expected_checks")
    if not isinstance(raw_checks, dict) or not raw_checks:
        raise CouldNotEvaluate(
            "expected_structure_invalid", "expected.expected_checks must be a non-empty object"
        )
    checks = {}
    for name, spec in raw_checks.items():
        if not isinstance(name, str) or not name:
            raise CouldNotEvaluate(
                "expected_structure_invalid", "expected check name must be a non-empty string"
            )
        checks[name] = validate_expectation(name, spec)
    return checks, expected_inputs


def load_receipts(used_receipts, input_bytes):
    maps = {}
    docs = {}
    owners = defaultdict(list)
    for canonical in sorted(used_receipts):
        if canonical not in input_bytes:
            raise CouldNotEvaluate("internal_error", "receipt bytes unavailable: {}".format(canonical))
        doc = parse_json_object(input_bytes[canonical], "receipt")
        checks = doc.get("checks")
        if not isinstance(checks, list):
            raise CouldNotEvaluate(
                "receipt_structure_invalid", "{}: checks must be a list".format(canonical)
            )
        by_name = {}
        for check in checks:
            if not isinstance(check, dict):
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}: check entry is not an object".format(canonical)
                )
            name = check.get("name")
            if not isinstance(name, str) or not name:
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}: check name must be a non-empty string".format(canonical)
                )
            if name in by_name:
                raise CouldNotEvaluate(
                    "receipt_check_duplicate", "{}: duplicate check {!r}".format(canonical, name)
                )
            if not _is_int(check.get("exit")):
                raise CouldNotEvaluate(
                    "receipt_check_invalid",
                    "{}:{}: exit must be an integer (bool is not an exit)".format(canonical, name),
                )
            if not isinstance(check.get("stdout"), str):
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}:{}: stdout must be a string".format(canonical, name)
                )
            if "stderr" in check and not isinstance(check["stderr"], str):
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}:{}: stderr must be a string".format(canonical, name)
                )
            by_name[name] = check
            owners[name].append(canonical)
        maps[canonical] = by_name
        docs[canonical] = doc
    for name in sorted(owners):
        if len(owners[name]) > 1:
            raise CouldNotEvaluate(
                "receipt_check_ambiguous",
                "check {!r} appears in multiple receipts: {}".format(
                    name, ", ".join(sorted(owners[name]))
                ),
            )
    return maps, docs


# ---------------------------------------------------------------- predicates


def _structured_object(stdout):
    try:
        value = json.loads(stdout, parse_constant=_reject_constant)
    except (ValueError, TypeError):
        return None
    return value if isinstance(value, dict) else None


def _row_candidates(parsed):
    candidates = []
    if "rows" in parsed:
        value = parsed["rows"]
        if _is_int(value) and value >= 0:
            candidates.append(("rows", value))
        elif isinstance(value, list):
            candidates.append(("rows.length", len(value)))
    counts = parsed.get("counts")
    if isinstance(counts, dict) and _is_int(counts.get("legs")) and counts["legs"] >= 0:
        candidates.append(("counts.legs", counts["legs"]))
    legs = parsed.get("legs")
    if isinstance(legs, list):
        candidates.append(("legs.length", len(legs)))
    return candidates


def _status_sources(parsed, expected_keys):
    sources = []
    statuses = parsed.get("statuses")
    if isinstance(statuses, dict):
        sources.append(("statuses", statuses))
    counts = parsed.get("counts")
    if isinstance(counts, dict):
        sources.append(("counts", counts))
    legs = parsed.get("legs")
    if isinstance(legs, list) and all(
        isinstance(item, dict) and isinstance(item.get("content_status"), str) for item in legs
    ):
        histogram = {
            key: sum(1 for item in legs if item["content_status"] == key) for key in expected_keys
        }
        sources.append(("legs.content_status", histogram))
    return sources


def _result_reuse_candidates(parsed):
    values = []
    if "result_reuse" in parsed:
        values.append(("result_reuse", parsed["result_reuse"]))
    legs = parsed.get("legs")
    if isinstance(legs, list) and legs:
        for index, item in enumerate(legs):
            if isinstance(item, dict) and "result_reuse" in item:
                values.append(("legs[{}].result_reuse".format(index), item["result_reuse"]))
    return values


def evaluate_expectation(name, spec, observed):
    collected = {}

    def add(finding_id, detail):
        collected.setdefault(finding_id, []).append(detail)

    if observed["exit"] != spec["exit"]:
        add(
            "expected_exit_mismatch",
            "observed exit {} expects {}".format(observed["exit"], spec["exit"]),
        )

    stdout = observed["stdout"]
    if "contains" in spec and spec["contains"] not in stdout:
        add("expected_contains_missing", "stdout lacks {}".format(_short(spec["contains"], 120)))

    structured_fields = [
        field
        for field in ("id", "reason", "rows", "statuses", "result_reuse")
        if field in spec
    ]
    parsed = None
    if structured_fields:
        parsed = _structured_object(stdout)
        if parsed is None:
            add(
                "expected_stdout_not_json",
                "fields {} require one JSON object on stdout".format(", ".join(structured_fields)),
            )

    if parsed is not None:
        if "id" in spec and parsed.get("id") != spec["id"]:
            add("expected_id_mismatch", "observed {} expects {}".format(_short(parsed.get("id")), _short(spec["id"])))
        if "reason" in spec and parsed.get("reason") != spec["reason"]:
            add(
                "expected_reason_mismatch",
                "observed {} expects {}".format(_short(parsed.get("reason")), _short(spec["reason"])),
            )
        if "rows" in spec:
            candidates = _row_candidates(parsed)
            values = sorted({value for _source, value in candidates})
            if not candidates:
                add("expected_rows_mismatch", "no observed row count source")
            elif len(values) != 1:
                add(
                    "expected_rows_mismatch",
                    "observed row counts disagree: {}".format(
                        ", ".join("{}={}".format(source, value) for source, value in candidates)
                    ),
                )
            elif values[0] != spec["rows"]:
                add(
                    "expected_rows_mismatch",
                    "observed {!r} expects {!r}".format(values[0], spec["rows"]),
                )
        if "statuses" in spec:
            sources = _status_sources(parsed, list(spec["statuses"]))
            if not sources:
                add("expected_statuses_mismatch", "no observed status histogram source")
            for key, expected_count in spec["statuses"].items():
                observed_counts = []
                for source, mapping in sources:
                    if key in mapping:
                        observed_counts.append((source, mapping[key]))
                if not observed_counts:
                    add("expected_statuses_mismatch", "status {!r} has no observed source".format(key))
                    continue
                bad = []
                for source, value in observed_counts:
                    if not _is_int(value) or value != expected_count:
                        bad.append("{}={!r}".format(source, value))
                if bad:
                    add(
                        "expected_statuses_mismatch",
                        "status {!r} expects {} observed {}".format(
                            key, expected_count, ", ".join(bad)
                        ),
                    )
        if "result_reuse" in spec:
            candidates = _result_reuse_candidates(parsed)
            if not candidates:
                add("expected_result_reuse_mismatch", "no observed result_reuse value")
            for source, value in candidates:
                if value != spec["result_reuse"]:
                    add(
                        "expected_result_reuse_mismatch",
                        "{}={!r} expects {!r}".format(source, value, spec["result_reuse"]),
                    )
    return [
        {
            "id": finding_id,
            "detail": "{}: {}".format(name, "; ".join(details)),
        }
        for finding_id, details in collected.items()
    ]


def cycle_nodes(graph):
    """Names participating in a superseded_by cycle."""
    color = {name: 0 for name in graph}
    found = set()
    path = []

    def visit(node):
        color[node] = 1
        path.append(node)
        for target in graph.get(node, ()):
            if target not in graph:
                continue
            if color[target] == 1:
                found.update(path[path.index(target):])
            elif color[target] == 0:
                visit(target)
        path.pop()
        color[node] = 2

    for name in sorted(graph):
        if color[name] == 0:
            visit(name)
    return found


# ------------------------------------------------------------------ evaluation


def add_finding(findings, findings_by_name, finding_id, expectation, detail):
    findings.append({"id": finding_id, "expectation": expectation, "detail": detail})
    if isinstance(expectation, str) and expectation:
        findings_by_name[expectation].append(finding_id)


def evaluate_dispositions(checks, rows, expected_inputs, receipt_maps, receipt_docs, expected_rel):
    expected_order = list(checks.keys())
    expected_parent = PurePosixPath(expected_rel).parent
    rows_by_name = defaultdict(list)
    for row in rows:
        rows_by_name[row["name"]].append(row)

    findings = []
    findings_by_name = defaultdict(list)

    for name in sorted(rows_by_name):
        if len(rows_by_name[name]) > 1:
            add_finding(
                findings,
                findings_by_name,
                "row_duplicate",
                name,
                "{} rows declare this name".format(len(rows_by_name[name])),
            )
    for name in sorted(rows_by_name):
        if name not in checks:
            add_finding(
                findings,
                findings_by_name,
                "row_unknown",
                name,
                "row name is not an expected_checks key",
            )
    for name in expected_order:
        if name not in rows_by_name:
            add_finding(
                findings,
                findings_by_name,
                "row_missing",
                name,
                "expected check has no disposition row",
            )

    unique_rows = {name: group[0] for name, group in rows_by_name.items() if len(group) == 1}
    records_by_name = {}
    row_outcomes = {}

    # Phase 1: effective rows.
    for name in expected_order:
        group = rows_by_name.get(name, [])
        if not group:
            records_by_name[name] = {
                "name": name,
                "state": None,
                "outcome": "missing",
                "mismatches": ["row_missing"],
            }
            continue
        if len(group) > 1:
            records_by_name[name] = {
                "name": name,
                "state": None,
                "outcome": "duplicate",
                "mismatches": ["row_duplicate"],
            }
            continue
        row = unique_rows[name]
        if row["state"] != "effective":
            continue
        spec = checks[name]
        if row["check"] != name:
            add_finding(
                findings,
                findings_by_name,
                "effective_check_name_mismatch",
                name,
                "check {!r} does not equal row name".format(row["check"]),
            )
        observed = receipt_maps.get(row["receipt_rel"], {}).get(row["check"])
        if observed is None:
            add_finding(
                findings,
                findings_by_name,
                "receipt_check_missing",
                name,
                "receipt {} has no check {!r}".format(row["receipt_rel"], row["check"]),
            )
            mismatches = [{"id": "receipt_check_missing", "detail": name}]
        else:
            mismatches = evaluate_expectation(name, spec, observed)
            for mismatch in mismatches:
                add_finding(
                    findings,
                    findings_by_name,
                    mismatch["id"],
                    name,
                    mismatch["detail"],
                )
        failed = bool(mismatches) or row["check"] != name
        row_outcomes[name] = {"failed": failed, "mismatches": mismatches}
        records_by_name[name] = {
            "name": name,
            "state": "effective",
            "receipt": row["receipt_rel"],
            "check": row["check"],
            "expected_exit": spec["exit"],
            "observed_exit": observed["exit"] if observed is not None else None,
            "outcome": "fail" if failed else "pass",
            "mismatches": sorted({mismatch["id"] for mismatch in mismatches}),
        }

    # Phase 2: superseded rows.
    superseded_graph = {}
    for name, row in unique_rows.items():
        if name in checks and row["state"] == "superseded":
            targets = []
            for target in dict.fromkeys(row["superseded_by"]):
                if target in unique_rows and unique_rows[target]["state"] == "superseded":
                    targets.append(target)
            superseded_graph[name] = targets
    for name in sorted(cycle_nodes(superseded_graph)):
        add_finding(
            findings,
            findings_by_name,
            "superseded_cycle",
            name,
            "superseded_by graph contains a cycle",
        )

    for name in expected_order:
        group = rows_by_name.get(name, [])
        if len(group) != 1:
            continue
        row = unique_rows[name]
        if row["state"] != "superseded":
            continue
        policy = SUPERSEDED_POLICY.get(name)
        raw_mismatches = []
        raw_retained = False
        raw_receipt = row["raw_rel"]
        raw_check = row["raw_check"]

        if not row["reason"].strip():
            add_finding(
                findings,
                findings_by_name,
                "superseded_reason_missing",
                name,
                "reason is empty",
            )

        if policy is None:
            add_finding(
                findings,
                findings_by_name,
                "supersession_not_permitted",
                name,
                "only producer_before may be superseded in round 14",
            )
        else:
            expected_raw = str(expected_parent / policy["raw_receipt"])
            if row["raw_rel"] != expected_raw or row["raw_check"] != policy["raw_check"]:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_raw_binding_mismatch",
                    name,
                    "raw observation must bind {}:{}".format(expected_raw, policy["raw_check"]),
                )
            else:
                observed = receipt_maps.get(row["raw_rel"], {}).get(row["raw_check"])
                if observed is None:
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_raw_missing",
                        name,
                        "raw receipt {} has no check {!r}".format(row["raw_rel"], row["raw_check"]),
                    )
                else:
                    raw_retained = True
                    raw_mismatches = evaluate_expectation(name, checks[name], observed)
                    if not raw_mismatches:
                        add_finding(
                            findings,
                            findings_by_name,
                            "supersession_unwarranted",
                            name,
                            "retained raw observation satisfies its original expectation",
                        )

            declared = list(row["superseded_by"])
            if len(set(declared)) != len(declared):
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_by_invalid",
                    name,
                    "duplicate replacement names",
                )
            required = list(policy["replacements"])
            missing = [target for target in required if target not in declared]
            extra = [target for target in declared if target not in required]
            if missing:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_required_replacement_missing",
                    name,
                    "missing required replacement(s): {}".format(", ".join(missing)),
                )
            if extra:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_replacement_not_allowed",
                    name,
                    "not an allowed replacement: {}".format(", ".join(extra)),
                )

            expected_oracle = str(expected_parent / ORACLE_RECEIPT)
            oracle_doc = receipt_docs.get(expected_oracle)
            binding_problems = []
            if oracle_doc is None:
                binding_problems.append("oracle receipt {} is not available".format(expected_oracle))
            else:
                supersedes = oracle_doc.get("supersedes")
                if not isinstance(supersedes, str) or not supersedes.startswith(
                    ORACLE_SUPERSEDES_PREFIX
                ):
                    binding_problems.append(
                        "oracle receipt does not declare {!r}".format(ORACLE_SUPERSEDES_PREFIX)
                    )
                oracle_input = str(expected_parent / ORACLE_INPUT)
                pinned_oracle = expected_inputs.get(oracle_input)
                if pinned_oracle is None or oracle_doc.get("oracle_sha256") != pinned_oracle:
                    binding_problems.append(
                        "oracle_sha256 does not equal expected.inputs[{}]".format(oracle_input)
                    )
            if binding_problems:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_oracle_binding_missing",
                    name,
                    "; ".join(binding_problems),
                )

            for target in dict.fromkeys(declared):
                if target not in checks or target not in rows_by_name:
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_by_unknown",
                        name,
                        "replacement {!r} is not an expected row".format(target),
                    )
                    continue
                target_group = rows_by_name[target]
                if len(target_group) != 1 or target_group[0]["state"] != "effective":
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_target_not_effective",
                        name,
                        "replacement {!r} is not a unique effective row".format(target),
                    )
                    continue
                if target_group[0]["receipt_rel"] != expected_oracle:
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_replacement_not_allowed",
                        name,
                        "replacement {!r} does not bind {}".format(target, expected_oracle),
                    )
                outcome = row_outcomes.get(target)
                if outcome is not None and outcome["failed"]:
                    ids = sorted({mismatch["id"] for mismatch in outcome["mismatches"]})
                    if target_group[0]["check"] != target:
                        ids.append("effective_check_name_mismatch")
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_replacement_failed",
                        name,
                        "replacement {!r} fails: {}".format(
                            target, ", ".join(sorted(set(ids))) or "identity mismatch"
                        ),
                    )

        records_by_name[name] = {
            "name": name,
            "state": "superseded",
            "reason": row["reason"],
            "raw_receipt": raw_receipt,
            "raw_check": raw_check,
            "raw_retained": raw_retained,
            "raw_expectation_failed": bool(raw_mismatches),
            "raw_mismatches": sorted({mismatch["id"] for mismatch in raw_mismatches}),
            "replacements": list(dict.fromkeys(row["superseded_by"])),
            "outcome": "fail" if findings_by_name.get(name) else "superseded",
            "mismatches": sorted(set(findings_by_name.get(name, []))),
        }

    # Final pass: non-predicate findings (identity, selection, policy) fail rows.
    for name, record in records_by_name.items():
        if record.get("state") == "effective" and record["outcome"] == "pass":
            extra = [item for item in findings_by_name.get(name, []) if item not in record["mismatches"]]
            if extra:
                record["outcome"] = "fail"
                record["mismatches"] = sorted(set(record["mismatches"]) | set(extra))

    records = [records_by_name[name] for name in expected_order]
    findings = sorted(
        findings,
        key=lambda item: (item["id"], item["expectation"] or "", item["detail"]),
    )

    informational = []
    for canonical in sorted(receipt_maps):
        for check_name in sorted(receipt_maps[canonical]):
            if check_name not in checks:
                informational.append({"receipt": canonical, "check": check_name})

    return records, findings, informational


# --------------------------------------------------------------------- output


def base_payload(status, exit_code):
    return {
        "schema": RESULT_SCHEMA,
        "tool": VERSION,
        "tool_sha256": tool_sha256(),
        "status": status,
        "exit": exit_code,
    }


def emit_could_not_evaluate(exc, as_json):
    payload = base_payload("could_not_evaluate", 2)
    payload["id"] = exc.finding_id
    payload["error"] = {"kind": exc.finding_id, "message": exc.detail}
    payload["findings"] = [
        {"id": exc.finding_id, "expectation": None, "detail": exc.detail}
    ]
    if as_json:
        sys.stdout.write(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    else:
        sys.stdout.write(
            "EVIDENCE_DISPOSITION: could_not_evaluate exit=2 id={} detail={}\n".format(
                exc.finding_id, exc.detail
            )
        )
    return 2


def emit_result(payload, as_json):
    if as_json:
        sys.stdout.write(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        return payload["exit"]
    counts = payload["counts"]
    sys.stdout.write(
        "EVIDENCE_DISPOSITION: {} exit={} expected={} effective={} superseded={} "
        "passed={} failed={} findings={}\n".format(
            payload["status"],
            payload["exit"],
            counts["expected_checks"],
            counts["effective"],
            counts["superseded"],
            counts["passed"],
            counts["failed"],
            counts["findings"],
        )
    )
    for record in payload["rows"]:
        sys.stdout.write(
            "ROW {} state={} outcome={} receipt={} check={} mismatches={}\n".format(
                record["name"],
                record.get("state"),
                record["outcome"],
                record.get("receipt", record.get("raw_receipt", "-")),
                record.get("check", record.get("raw_check", "-")),
                ",".join(record.get("mismatches", [])) or "-",
            )
        )
    for finding in payload["findings"]:
        sys.stdout.write(
            "FINDING {} expectation={} {}\n".format(
                finding["id"], finding["expectation"] or "-", finding["detail"]
            )
        )
    for line in payload.get("historical_text", ()):
        sys.stdout.write(line + "\n")
    return payload["exit"]


# ----------------------------------------------------------------- run mode


def check_supersedes_lineage(dispositions, supersedes_rel, expected_rel, pinned, input_bytes):
    """G7: `supersedes` must name a v1 manifest this document actually extends."""
    doc = parse_json_object(input_bytes[supersedes_rel], "supersedes")
    problems = []
    if doc.get("schema") != SCHEMA:
        problems.append("superseded document schema is not {!r}".format(SCHEMA))
    if doc.get("expected_file") != expected_rel:
        problems.append("superseded expected_file differs")
    if doc.get("rows") != dispositions.get("rows"):
        problems.append("superseded rows differ from this document's rows")
    superseded_inputs = doc.get("inputs")
    if not isinstance(superseded_inputs, dict):
        problems.append("superseded inputs is not an object")
    else:
        for key, digest in superseded_inputs.items():
            if pinned.get(key) != digest:
                problems.append("superseded input {} is not pinned identically".format(key))
    if problems:
        raise CouldNotEvaluate("supersedes_mismatch", "; ".join(problems))




def run_mode(root, dispositions_path, as_json):
    lane = Path(root).resolve()
    if not lane.is_dir():
        raise CouldNotEvaluate("root_unavailable", "lane root is not a directory: {}".format(root))

    dispositions_file = Path(dispositions_path)
    raw_dispositions = read_dispositions(dispositions_file)
    dispositions = parse_json_object(raw_dispositions, "dispositions")
    schema = dispositions.get("schema")
    if schema not in SCHEMAS:
        # v1-visible text: this detail must stay byte-identical to r14.
        raise CouldNotEvaluate(
            "schema_mismatch",
            "dispositions schema must be {!r}".format(SCHEMA),
        )

    supersedes_rel = None
    historical = {}
    if schema == SCHEMA_V2:
        supersedes_value = dispositions.get("supersedes")
        if not isinstance(supersedes_value, str):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "supersedes must be a lane-relative path string",
            )
        supersedes_rel = str(canonical_relative(supersedes_value, "supersedes"))
        historical = validate_historical_inputs(dispositions.get("historical_inputs"))

    expected_rel = str(canonical_relative(dispositions.get("expected_file"), "expected_file"))
    pinned = validate_inputs(dispositions.get("inputs"))
    if expected_rel not in pinned:
        raise CouldNotEvaluate(
            "input_unpinned", "expected file {} is not pinned in inputs".format(expected_rel)
        )
    expected_parent = PurePosixPath(expected_rel).parent
    for basename in REQUIRED_RECEIPTS:
        canonical = str(expected_parent / basename)
        if canonical not in pinned:
            raise CouldNotEvaluate(
                "input_unpinned", "required receipt {} is not pinned in inputs".format(canonical)
            )
    if schema == SCHEMA_V2 and supersedes_rel not in pinned:
        raise CouldNotEvaluate(
            "input_unpinned",
            "supersedes document {} is not pinned in inputs".format(supersedes_rel),
        )

    rows = validate_rows(dispositions.get("rows"), expected_rel, pinned)

    used_receipts = set()
    for row in rows:
        if row["state"] == "effective":
            used_receipts.add(row["receipt_rel"])
        else:
            used_receipts.add(row["raw_rel"])
    for basename in REQUIRED_RECEIPTS:
        used_receipts.add(str(expected_parent / basename))

    # INTEGRITY FIRST: hash every declared pin exactly once, before any
    # expectation predicate. The cached bytes are parsed below, never re-read.
    input_bytes = {}
    for canonical in sorted(pinned):
        label = "expected_file" if canonical == expected_rel else "input"
        path = safe_file(lane, canonical, label)
        data = read_regular(path, label)
        actual = sha256_bytes(data)
        if actual != pinned[canonical]:
            raise CouldNotEvaluate(
                "input_digest_mismatch",
                "{}: observed {} expects {}".format(canonical, actual, pinned[canonical]),
            )
        input_bytes[canonical] = data

    if schema == SCHEMA_V2:
        check_supersedes_lineage(
            dispositions, supersedes_rel, expected_rel, pinned, input_bytes
        )

    expected = parse_json_object(input_bytes[expected_rel], "expected")
    checks, expected_inputs = validate_expected(expected)

    # Every original expected.inputs digest is verified in full before any
    # predicate runs; a changed historical input is not evaluation material.
    # v2 historical_inputs are classified BEFORE any live read of those paths:
    # a waived path is never opened through safe_file/read_regular here.
    historical_unknown = sorted(set(historical) - set(expected_inputs))
    if historical_unknown:
        raise CouldNotEvaluate(
            "historical_input_unknown",
            "not in expected.inputs: {}".format(", ".join(historical_unknown)),
        )
    historical_shas = {}
    if historical:
        verify_repo(lane)
        anchor_label, anchor_commit = resolve_historical_anchor(lane)
        for rev in sorted(set(historical.values())):
            resolve_historical_rev(lane, rev, anchor_label, anchor_commit)
        for canonical in sorted(historical):
            check_historical_waiver(
                lane,
                canonical,
                expected_inputs[canonical],
                anchor_label,
                anchor_commit,
            )
    for canonical in sorted(expected_inputs):
        if canonical in historical:
            data = historical_blob(lane, historical[canonical], canonical)
        else:
            path = safe_file(lane, canonical, "expected_input")
            data = read_regular(path, "expected_input")
        actual = sha256_bytes(data)
        if actual != expected_inputs[canonical]:
            raise CouldNotEvaluate(
                "expected_input_digest_mismatch",
                "{}: observed {} expects {}".format(canonical, actual, expected_inputs[canonical]),
            )
        if canonical in historical:
            historical_shas[canonical] = actual

    receipt_maps, receipt_docs = load_receipts(used_receipts, input_bytes)
    records, findings, informational = evaluate_dispositions(
        checks,
        rows,
        expected_inputs,
        receipt_maps,
        receipt_docs,
        expected_rel,
    )

    exit_code = 1 if findings else 0
    status = "failed" if findings else "clean"
    payload = base_payload(status, exit_code)
    payload["root"] = str(lane)
    payload["dispositions"] = str(dispositions_file)
    payload["expected_file"] = expected_rel
    payload["counts"] = {
        "expected_checks": len(checks),
        "effective": sum(1 for record in records if record.get("state") == "effective"),
        "superseded": sum(1 for record in records if record.get("state") == "superseded"),
        "passed": sum(1 for record in records if record["outcome"] == "pass"),
        "failed": sum(
            1 for record in records if record["outcome"] in ("fail", "missing", "duplicate")
        ),
        "findings": len(findings),
    }
    payload["rows"] = records
    payload["findings"] = findings
    payload["informational"] = {"receipt_only_checks": informational}
    payload["inputs_verified"] = sorted(pinned)
    payload["expected_inputs_verified"] = sorted(expected_inputs)
    if schema == SCHEMA_V2:
        payload["supersedes"] = supersedes_rel
        payload["expected_inputs_historical"] = {
            canonical: historical[canonical] for canonical in sorted(historical)
        }
        payload["historical_text"] = [
            "HISTORICAL {} rev={} sha256={}".format(
                canonical, historical[canonical], historical_shas[canonical]
            )
            for canonical in sorted(historical)
        ]
    return emit_result(payload, as_json)


# ------------------------------------------------------------------- selftest

SELFTEST_ORACLE_PY = b"# tameshi round-14 oracle fixture (never executed)\n"
SELFTEST_FIXTURE_INPUT = b"pinned-input\n"
SELFTEST_TOOL_REL = "tools/pinned-tool.py"
SELFTEST_TOOL_V1 = b"# pinned tool fixture v1\n"
SELFTEST_TOOL_V2 = b"# pinned tool fixture v2 (drifted live)\n"
SELFTEST_TOOL_OTHER = b"# pinned tool fixture other rev (unexpected bytes)\n"
SELFTEST_TOOL_CRLF = b"#!/bin/sh\r\necho crlf-fixture\r\n"
SELFTEST_V1_REL = "docs/v1-manifest.json"
SELFTEST_V1_DOC = b'{"schema": "evidence-dispositions-v1"}\n'


def _json_bytes(value):
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")


def _write_bytes(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(payload)


def _sha(payload):
    return sha256_bytes(payload)


def _build_lane(lane, marker, variant):
    lane.mkdir(parents=True, exist_ok=True)
    evidence = lane / ".ufo" / "evidence" / "round-13"
    evidence.mkdir(parents=True, exist_ok=True)
    fixture_input = lane / "fixtures" / "input.txt"
    _write_bytes(fixture_input, SELFTEST_FIXTURE_INPUT)
    tool_bytes = variant.get("tool_bytes", SELFTEST_TOOL_V1)
    _write_bytes(lane / "tools" / "pinned-tool.py", tool_bytes)
    oracle_py = evidence / "producer-oracle.py"
    _write_bytes(oracle_py, SELFTEST_ORACLE_PY)
    oracle_input_digest = _sha(SELFTEST_ORACLE_PY)

    expected_checks = {
        "alpha": {"exit": 0, "contains": "ALPHA_OK"},
        "beta": {"exit": 1, "id": "beta_bad", "reason": "beta_reason"},
        "gamma": {"exit": 0, "contains": "GAMMA_OK", "id": "gamma_ok", "reason": "ok"},
        "pin_live": {
            "exit": 0,
            "rows": 2,
            "statuses": {"changed": 1, "unchanged": 1, "unavailable": 0},
            "result_reuse": "not_established",
        },
        "producer_before": {"exit": 1, "contains": "kind FAIL"},
        "producer_before_oracle": {"exit": 1, "contains": "kind FAIL"},
        "producer_after_oracle": {"exit": 0, "contains": "41/41 pass"},
    }
    for name, override in variant.get("expected_checks", {}).items():
        expected_checks[name] = override

    expected = {
        "schema": "tameshi-round13-evidence-v1",
        "baseline": "0" * 40,
        "inputs": {
            "fixtures/input.txt": _sha(SELFTEST_FIXTURE_INPUT),
            ".ufo/evidence/round-13/producer-oracle.py": oracle_input_digest,
            "tools/pinned-tool.py": _sha(tool_bytes),
        },
        "expected_checks": expected_checks,
    }
    expected_bytes = _json_bytes(expected)
    _write_bytes(evidence / "expected.json", expected_bytes)

    alpha_exit = variant.get("alpha_exit", 0)
    alpha_stdout = variant.get("alpha_stdout", "ALPHA_OK\n")
    verification_checks = [
        {
            "name": "alpha",
            "argv": ["python3", "-c", "print('ALPHA_OK')"],
            "exit": alpha_exit,
            "stdout": alpha_stdout,
            "stderr": "",
        },
        {
            "name": "beta",
            "argv": ["python3", "-c", "raise SystemExit(1)"],
            "exit": 1,
            "stdout": json.dumps(
                {
                    "id": variant.get("beta_id", "beta_bad"),
                    "reason": variant.get("beta_reason", "beta_reason"),
                    "exit": 1,
                }
            )
            + "\n",
            "stderr": "",
        },
        {
            "name": "gamma",
            "argv": ["python3", "-c", "raise SystemExit(0)"],
            "exit": 0,
            "stdout": json.dumps(
                {"id": "gamma_ok", "reason": "ok", "exit": 0, "marker": "GAMMA_OK"}
            )
            + "\n",
            "stderr": "",
        },
        {
            "name": "pin_live",
            "argv": ["python3", "tools/pin-disposition.py", "--manifest", "fixture"],
            "exit": 0,
            "stdout": json.dumps(
                {
                    "counts": variant.get(
                        "pin_counts",
                        {"legs": 2, "changed": 1, "unchanged": 1, "unavailable": 0},
                    ),
                    "legs": variant.get(
                        "pin_legs",
                        [
                            {
                                "leg": "a",
                                "content_status": "changed",
                                "result_reuse": "not_established",
                            },
                            {
                                "leg": "b",
                                "content_status": "unchanged",
                                "result_reuse": "not_established",
                            },
                        ],
                    ),
                    "result_reuse": variant.get("pin_result_reuse", "not_established"),
                }
            )
            + "\n",
            "stderr": "",
        },
        {
            "name": "producer_before",
            "argv": ["python3", ".ufo/evidence/round-13/producer-before.py", "selftest"],
            "exit": variant.get("producer_before_exit", 1),
            "stdout": variant.get("producer_before_stdout", "  check something ok\n"),
            "stderr": "Traceback (most recent call last):\nFileNotFoundError\n",
        },
        {
            "name": "argv_marker",
            "argv": ["sh", "-c", "touch " + str(marker)],
            "exit": 0,
            "stdout": "",
            "stderr": "",
        },
    ]
    if variant.get("duplicate_alpha_check"):
        verification_checks.append(
            {
                "name": "alpha",
                "argv": ["python3", "-c", "print('ALPHA_OK')"],
                "exit": 0,
                "stdout": "ALPHA_OK\n",
                "stderr": "",
            }
        )
    if variant.get("drop_producer_before_check"):
        verification_checks = [
            check for check in verification_checks if check["name"] != "producer_before"
        ]
    verification = {
        "schema": "tameshi-round13-verification-v1",
        "checks": verification_checks,
    }
    verification_bytes = _json_bytes(verification)
    _write_bytes(evidence / "verification.json", verification_bytes)

    oracle_checks = [
        {
            "name": "producer_before_oracle",
            "argv": ["python3", "producer-oracle.py", "--source", "producer-before.py"],
            "exit": 1,
            "stdout": variant.get(
                "oracle_before_stdout",
                "  check summary preserves top-level exposed declaration kind FAIL\n",
            ),
            "stderr": "",
        },
        {
            "name": "producer_after_oracle",
            "argv": ["python3", "producer-oracle.py", "--source", "bash-witness-study.py"],
            "exit": 0,
            "stdout": variant.get(
                "oracle_after_stdout",
                "  check summary preserves top-level exposed declaration kind ok\n"
                "WITNESS_SELFTEST: 41/41 pass\n",
            ),
            "stderr": "",
        },
    ]
    oracle_checks.extend(variant.get("extra_oracle_checks", []))
    oracle = {
        "schema": "tameshi-round13-producer-oracle-repair-v1",
        "supersedes": variant.get(
            "oracle_supersedes",
            "verification.json producer_before: fixture crash is NOT red-before evidence",
        ),
        "oracle_sha256": oracle_input_digest,
        "checks": oracle_checks,
    }
    oracle_bytes = _json_bytes(oracle)
    _write_bytes(evidence / "producer-oracle-repair.json", oracle_bytes)

    return {
        "lane": lane,
        "expected_rel": ".ufo/evidence/round-13/expected.json",
        "ver_rel": ".ufo/evidence/round-13/verification.json",
        "oracle_rel": ".ufo/evidence/round-13/producer-oracle-repair.json",
        "fixture_rel": "fixtures/input.txt",
        "tool_rel": SELFTEST_TOOL_REL,
    }


def _effective(name, receipt_rel, check=None):
    return {
        "name": name,
        "state": "effective",
        "receipt": receipt_rel,
        "check": check or name,
    }


def _superseded(name, reason, replacements, raw_receipt, raw_check):
    return {
        "name": name,
        "state": "superseded",
        "reason": reason,
        "raw_receipt": raw_receipt,
        "raw_check": raw_check,
        "superseded_by": replacements,
    }


def _rows(fx, producer_state="superseded", **variant):
    ver = fx["ver_rel"]
    oracle = fx["oracle_rel"]
    rows = [
        _effective("alpha", ver),
        _effective("beta", ver),
        _effective("gamma", ver, variant.get("gamma_check", "gamma")),
        _effective("pin_live", ver),
    ]
    if producer_state == "effective":
        rows.append(_effective("producer_before", ver))
    else:
        rows.append(
            _superseded(
                "producer_before",
                variant.get(
                    "reason",
                    "raw path-layout crash before the kind assertion; exit1 records a setup failure",
                ),
                variant.get(
                    "replacements",
                    ["producer_before_oracle", "producer_after_oracle"],
                ),
                variant.get("raw_receipt", ver),
                variant.get("raw_check", "producer_before"),
            )
        )
    rows.extend(
        [
            _effective("producer_before_oracle", oracle),
            _effective("producer_after_oracle", oracle),
        ]
    )
    drop = set(variant.get("drop", ()))
    rows = [row for row in rows if row["name"] not in drop]
    rows.extend(variant.get("extra_rows", []))
    return rows


def _dispositions(fx, rows):
    lane = fx["lane"]
    inputs = {
        fx["expected_rel"]: _sha((lane / fx["expected_rel"]).read_bytes()),
        fx["ver_rel"]: _sha((lane / fx["ver_rel"]).read_bytes()),
        fx["oracle_rel"]: _sha((lane / fx["oracle_rel"]).read_bytes()),
    }
    return {
        "schema": "evidence-dispositions-v1",
        "expected_file": fx["expected_rel"],
        "inputs": inputs,
        "rows": rows,
    }


def _dispositions_v2(fx, rows, historical=None, supersedes_rel=None, pin_supersedes=True,
                     supersedes_doc=None):
    """v2 manifest: v1 fields plus `supersedes` and `historical_inputs`."""
    document = _dispositions(fx, rows)
    document["schema"] = SCHEMA_V2
    if supersedes_rel is not None:
        if supersedes_rel == SELFTEST_V1_REL:
            doc = supersedes_doc if supersedes_doc is not None else _dispositions(fx, rows)
            _write_bytes(fx["lane"] / SELFTEST_V1_REL, _json_bytes(doc))
        if pin_supersedes:
            document["inputs"][supersedes_rel] = _sha(
                (fx["lane"] / supersedes_rel).read_bytes()
            )
    document["supersedes"] = supersedes_rel
    document["historical_inputs"] = historical or {}
    return document


def _selftest_git_env():
    # Fixture git calls never inherit GIT_* (an exported GIT_DIR would commit
    # into a foreign repo) and never depend on the caller's global identity.
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_GLOBAL="/dev/null",
        GIT_AUTHOR_NAME="selftest",
        GIT_AUTHOR_EMAIL="selftest@invalid",
        GIT_COMMITTER_NAME="selftest",
        GIT_COMMITTER_EMAIL="selftest@invalid",
    )
    return env


def _git(lane, *argv):
    proc = subprocess.run(
        ["git", "-C", str(lane)] + list(argv),
        capture_output=True,
        timeout=30,
        env=_selftest_git_env(),
    )
    if proc.returncode != 0:
        raise RuntimeError(
            "git {} failed: {}".format(argv[0], _stderr_text(proc))
        )
    return proc.stdout


def _git_raw(argv):
    proc = subprocess.run(argv, capture_output=True, timeout=120, env=_selftest_git_env())
    if proc.returncode != 0:
        raise RuntimeError("{} failed: {}".format(argv, _stderr_text(proc)))
    return proc.stdout

def _jj(lane, *argv):
    env = _selftest_git_env()
    env["HOME"] = str(lane.parent)
    env["XDG_CONFIG_HOME"] = str(lane.parent / "jj-config")
    env.pop("JJ_CONFIG", None)
    proc = subprocess.run(
        ["jj"] + list(argv),
        cwd=str(lane),
        capture_output=True,
        timeout=120,
        env=env,
    )
    if proc.returncode != 0:
        raise RuntimeError("jj {} failed: {}".format(" ".join(argv), _stderr_text(proc)))
    return proc.stdout


def _git_head(lane):
    return _git(lane, "rev-parse", "HEAD").decode("ascii").strip()


def _git_commit_all(lane, message):
    _git(lane, "add", "-A")
    _git(
        lane,
        "-c",
        "user.email=selftest@example.invalid",
        "-c",
        "user.name=selftest",
        "commit",
        "-qm",
        message,
    )
    return _git_head(lane)


def _git_init_commit(lane, message="fixture commit"):
    _git(lane, "init", "-q")
    return _git_commit_all(lane, message)


def _setup_hist_clean(fx):
    """Pinned bytes at rev A, then the instrument move committed at HEAD."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "round-16 committed instrument move")
    fx["hist_rev"] = rev_a


def _setup_hist_other(fx):
    """Unexpected committed bytes at rev B (the declared historical rev)."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_OTHER)
    rev_b = _git_commit_all(lane, "unexpected committed bytes")
    fx["hist_rev"] = rev_b


def _setup_hist_unneeded(fx):
    """Live bytes still equal the pin: the waiver must be refused."""
    fx["hist_rev"] = _git_init_commit(fx["lane"], "round-13 pinned tools")


def _setup_hist_uncommitted(fx):
    """Worktree edit of a waived path, never committed."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    fx["hist_rev"] = rev_a


def _setup_hist_missing_object(fx):
    """Rev D deleted the path; HEAD later restored it as a moved tool."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    os.remove(lane / SELFTEST_TOOL_REL)
    rev_d = _git_commit_all(lane, "delete pinned tool")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "restore as a moved tool")
    fx["hist_rev"] = rev_d


def _setup_hist_dangling(fx):
    """A commit that exists but is not an ancestor of HEAD."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    tree = _git(lane, "rev-parse", "HEAD^{tree}").decode().strip()
    dangling = _git(lane, "commit-tree", tree, "-m", "forged: not on master").decode().strip()
    fx["hist_rev"] = dangling


def _setup_hist_tree(fx):
    """A tree object id is not a commit."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    fx["hist_rev"] = _git(lane, "rev-parse", "HEAD^{tree}").decode().strip()

def _setup_hist_tag(fx):
    """An annotated tag object peeling to an ancestor commit is not a commit id."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "round-16 committed instrument move")
    _git(lane, "tag", "-a", "selftest-pinned", "-m", "annotated pin", rev_a)
    fx["hist_rev"] = _git(
        lane, "rev-parse", "refs/tags/selftest-pinned"
    ).decode("ascii").strip()


def _setup_hist_symlink(fx):
    """A symlink blob whose link text equals the pin is not a regular tool blob."""
    lane = fx["lane"]
    tool = lane / SELFTEST_TOOL_REL
    tool.unlink()
    os.symlink(SELFTEST_TOOL_V1.decode("utf-8"), tool)
    rev_a = _git_init_commit(lane, "symlink-pinned tool")
    tool.unlink()
    _write_bytes(tool, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "regular moved tool")
    fx["hist_rev"] = rev_a


def _jj_init_fixture_repo(fx, record_lane_branch):
    lane = fx["lane"]
    _git(lane, "init", "-q", "-b", "master")
    rev_a = _git_commit_all(lane, "round-13 pinned tools")
    if record_lane_branch:
        _git(lane, "config", "lane.branch", "master")
    _jj(lane, "git", "init", "--colocate", ".")
    _jj(
        lane, "--ignore-working-copy", "config", "set", "--repo",
        "snapshot.auto-track", '"none()"',
    )
    _jj(lane, "--ignore-working-copy", "config", "set", "--repo", "user.name", "selftest")
    _jj(
        lane, "--ignore-working-copy", "config", "set", "--repo",
        "user.email", "selftest@example.invalid",
    )
    return rev_a


def _jj_commit_tool(lane, payload, message):
    _write_bytes(lane / SELFTEST_TOOL_REL, payload)
    _jj(lane, "file", "track", "--", SELFTEST_TOOL_REL)
    _jj(lane, "commit", "-m", message)
    return _jj(lane, "log", "--no-graph", "-r", "@-", "-T", "commit_id").decode(
        "ascii"
    ).strip()


def _setup_hist_jj_prebookmark(fx):
    """A JJ content commit moves HEAD while the lane bookmark still has old bytes."""
    lane = fx["lane"]
    rev_a = _jj_init_fixture_repo(fx, record_lane_branch=True)
    _jj(lane, "new", rev_a)
    _jj_commit_tool(lane, SELFTEST_TOOL_V2, "waived tool move")
    head = _git_head(lane)
    branch_tip = _git(lane, "rev-parse", "refs/heads/master").decode("ascii").strip()
    head_ref = subprocess.run(
        ["git", "-C", str(lane), "symbolic-ref", "-q", "HEAD"],
        capture_output=True,
        env=_selftest_git_env(),
        timeout=30,
    )
    if head_ref.returncode != 1 or head == branch_tip or branch_tip != rev_a:
        raise RuntimeError(
            "JJ pre-bookmark fixture mismatch: HEAD={}, master={}, HEAD-ref-exit={}".format(
                head, branch_tip, head_ref.returncode
            )
        )
    fx["hist_rev"] = rev_a


def _setup_hist_jj_branch_tip(fx):
    """A JJ HEAD at an older commit has a distinct branch tip containing the pin rev."""
    lane = fx["lane"]
    rev_a = _jj_init_fixture_repo(fx, record_lane_branch=True)
    _jj(lane, "new", rev_a)
    moved = _jj_commit_tool(lane, SELFTEST_TOOL_V2, "waived tool move")
    _jj(lane, "bookmark", "set", "master", "-r", moved)
    historical = _jj_commit_tool(lane, SELFTEST_TOOL_V1, "pinned input revision")
    branch_tip = _jj_commit_tool(lane, SELFTEST_TOOL_V2, "branch-tip tool move")
    _jj(lane, "bookmark", "set", "master", "-r", branch_tip)
    _jj(lane, "--ignore-working-copy", "edit", historical)
    head = _git_head(lane)
    actual_tip = _git(lane, "rev-parse", "refs/heads/master").decode("ascii").strip()
    head_ref = subprocess.run(
        ["git", "-C", str(lane), "symbolic-ref", "-q", "HEAD"],
        capture_output=True,
        env=_selftest_git_env(),
        timeout=30,
    )
    if head_ref.returncode != 1 or head == actual_tip or actual_tip != branch_tip:
        raise RuntimeError(
            "JJ branch-tip fixture mismatch: HEAD={}, master={}, HEAD-ref-exit={}".format(
                head, actual_tip, head_ref.returncode
            )
        )
    if _git(lane, "show", "HEAD:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V2:
        raise RuntimeError("JJ HEAD fixture does not carry the moved tool bytes")
    if _git(lane, "show", "refs/heads/master:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V2:
        raise RuntimeError("JJ branch tip does not carry the moved tool bytes")
    if _git(lane, "show", historical + ":" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V1:
        raise RuntimeError("JJ historical fixture does not carry the pinned bytes")
    fx["hist_rev"] = historical


def _setup_hist_jj_unbound(fx):
    """A detached colocated JJ workspace without lane.branch has no anchor."""
    lane = fx["lane"]
    rev_a = _jj_init_fixture_repo(fx, record_lane_branch=False)
    _git(lane, "checkout", "--detach", rev_a)
    fx["hist_rev"] = rev_a


def _setup_hist_registry_clone(fx):
    """A detached harness clone anchors at HEAD, not its later remote tip."""
    lane = fx["lane"]
    _git(lane, "init", "-q", "-b", "master")
    pin_rev = _git_commit_all(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    checked_out_rev = _git_commit_all(lane, "registry checked-out rev")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_OTHER)
    _git_commit_all(lane, "waived tool moved after checked-out rev")

    source = lane.parent / (lane.name + "-source")
    os.rename(str(lane), str(source))
    _git_raw(
        ["git", "clone", "--no-hardlinks", "--quiet", str(source), str(lane)]
    )
    _git(lane, "checkout", "--quiet", "--detach", checked_out_rev)
    _git(lane, "branch", "-D", "master")
    if _git(lane, "show", "HEAD:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V2:
        raise RuntimeError("registry clone HEAD does not carry checked-out tool bytes")
    if _git(lane, "show", "refs/remotes/origin/master:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_OTHER:
        raise RuntimeError("registry clone remote tip does not carry later tool bytes")
    fx["hist_rev"] = pin_rev


def _setup_hist_no_published_ref(fx):
    """Detached non-jj HEAD without a containing ref is unavailable."""
    lane = fx["lane"]
    _git(lane, "init", "-q", "-b", "master")
    rev_a = _git_commit_all(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    tip = _git_commit_all(lane, "committed instrument move")
    _git(lane, "checkout", "--detach", tip)
    _git(lane, "branch", "-D", "master")
    fx["hist_rev"] = rev_a

def _setup_hist_replace(fx):
    """A replace ref rewrites HEAD; only GIT_NO_REPLACE_OBJECTS restores truth."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    fake_tree = _git(lane, "rev-parse", rev_a + "^{tree}").decode().strip()
    fake = _git(lane, "commit-tree", fake_tree, "-m", "replace fake").decode().strip()
    _git(lane, "replace", "HEAD", fake)
    fx["hist_rev"] = rev_a


def _setup_committed_deletion(fx):
    """Pinned bytes at rev A; HEAD holds a committed deletion of the path."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    os.remove(lane / SELFTEST_TOOL_REL)
    _git_commit_all(lane, "committed deletion of the moved tool")
    fx["hist_rev"] = rev_a


def _setup_gitdir_env(fx):
    """A foreign GIT_DIR/GIT_WORK_TREE exported into the tool's environment."""
    _setup_hist_clean(fx)
    lane = fx["lane"]
    foreign = lane.parent / (lane.name + "-foreign")
    _write_bytes(foreign / "seed.txt", b"foreign\n")
    _git_init_commit(foreign, "foreign repo")
    fx["env_extra"] = {
        "GIT_DIR": str(foreign / ".git"),
        "GIT_WORK_TREE": str(lane),
    }


def _setup_shallow(fx):
    """A shallow clone: historical blobs are not provable."""
    lane = fx["lane"]
    src = lane.parent / (lane.name + "-src")
    os.rename(str(lane), str(src))
    rev = _git_init_commit(src, "shallow source")
    _git_raw(["git", "clone", "--depth", "1", "--quiet", "file://" + str(src), str(lane)])
    fx["hist_rev"] = rev


def _setup_crlf(fx):
    """Pinned CRLF bytes at rev A; HEAD holds different committed bytes."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "crlf pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_OTHER)
    _git_commit_all(lane, "committed instrument move")
    fx["hist_rev"] = rev_a


def _status_for(exit_code):
    return {0: "clean", 1: "failed", 2: "could_not_evaluate"}.get(exit_code)


def selftest():
    """Isolated /tmp fixtures; invokes this CLI via subprocess only."""
    scratch = Path(tempfile.mkdtemp(prefix="tameshi-r14-evidence-disposition-selftest.", dir="/tmp"))
    marker = scratch / "argv-marker"
    passed = 0
    failed = []

    def record(name, ok, detail):
        nonlocal passed
        if ok:
            passed += 1
            print("SELFTEST_CASE {} PASS ({})".format(name, detail))
        else:
            failed.append(name)
            print("SELFTEST_CASE {} FAIL ({})".format(name, detail))

    def run_cli(lane, dispositions_path, env_extra=None):
        env = None
        if env_extra:
            env = dict(os.environ)
            env.update(env_extra)
        return subprocess.run(
            [
                sys.executable,
                SELF,
                "--root",
                str(lane),
                "--dispositions",
                str(dispositions_path),
                "--json",
            ],
            capture_output=True,
            text=True,
            timeout=120,
            env=env,
            cwd=str(lane),
        )

    def case(name, expected_exit, expected_ids, variant=None, rows_kwargs=None,
             rows_override=None, raw_dispositions=None, mutate=None,
             informational_checks=None, git_setup=None):
        lane = scratch / ("case-" + name)
        try:
            fx = _build_lane(lane, marker, variant or {})
            if git_setup is not None:
                git_setup(fx)
            rows = rows_override if rows_override is not None else _rows(fx, **(rows_kwargs or {}))
            if raw_dispositions is not None:
                produced = raw_dispositions(fx)
                dispositions_bytes = (
                    produced if isinstance(produced, (bytes, bytearray)) else _json_bytes(produced)
                )
            else:
                dispositions_bytes = _json_bytes(_dispositions(fx, rows))
            dispositions_path = lane / ".ufo" / "evidence" / "round-13" / "dispositions.json"
            _write_bytes(dispositions_path, dispositions_bytes)
            if mutate is not None:
                mutate(fx)
            proc = run_cli(lane, dispositions_path, fx.get("env_extra"))
        except Exception as exc:  # fixture setup or process failure
            record(name, False, "setup/process error: {}: {}".format(type(exc).__name__, exc))
            return
        checks = [(proc.returncode == expected_exit, "exit={} expects={}".format(proc.returncode, expected_exit))]
        payload = None
        try:
            payload = json.loads(proc.stdout)
        except ValueError:
            checks.append((False, "stdout is not JSON: {!r}".format(proc.stdout[:200])))
        if payload is not None:
            ids = sorted(finding["id"] for finding in payload.get("findings", []))
            checks.append((ids == sorted(expected_ids), "ids={!r} expects={!r}".format(ids, sorted(expected_ids))))
            checks.append((payload.get("exit") == expected_exit, "payload exit={!r}".format(payload.get("exit"))))
            checks.append(
                (
                    payload.get("status") == _status_for(expected_exit),
                    "status={!r} expects={!r}".format(payload.get("status"), _status_for(expected_exit)),
                )
            )
            if informational_checks is not None:
                observed = sorted(
                    item["check"] for item in payload.get("informational", {}).get("receipt_only_checks", [])
                )
                checks.append((observed == sorted(informational_checks), "informational={!r}".format(observed)))
        ok = all(flag for flag, _detail in checks)
        detail = "{} literal checks".format(len(checks)) if ok else "; ".join(
            detail for flag, detail in checks if not flag
        )
        record(name, ok, detail)

    def historical_case(name, expected_exit, expected_ids, git_setup):
        case(
            name,
            expected_exit,
            expected_ids,
            git_setup=git_setup,
            raw_dispositions=lambda fx: _dispositions_v2(
                fx,
                _rows(fx),
                historical=_hist(
                    fx, {SELFTEST_TOOL_REL: {"rev": None, "reason": hist_reason}}
                ),
                supersedes_rel=SELFTEST_V1_REL,
            ),
        )

    ver = ".ufo/evidence/round-13/verification.json"
    oracle = ".ufo/evidence/round-13/producer-oracle-repair.json"

    case("clean-superseded", 0, [], informational_checks=["argv_marker"])
    case("unsuperseded-crash-mismatch", 1, ["expected_contains_missing"],
         rows_kwargs={"producer_state": "effective"})
    case("missing-row-drop", 1, ["row_missing"], rows_kwargs={"drop": ("beta",)})
    case(
        "unknown-row",
        1,
        ["row_unknown"],
        rows_kwargs={"extra_rows": [_effective("ghost", ver, "producer_before")]},
    )
    case(
        "duplicate-row-name",
        1,
        ["row_duplicate"],
        rows_kwargs={
            "extra_rows": [
                _superseded(
                    "producer_before",
                    "duplicate fixture",
                    ["producer_before_oracle", "producer_after_oracle"],
                    ver,
                    "producer_before",
                )
            ]
        },
    )
    case(
        "effective-check-identity",
        1,
        ["effective_check_name_mismatch"],
        variant={"expected_checks": {"gamma": {"exit": 0, "contains": "ALPHA_OK"}}},
        rows_kwargs={"gamma_check": "alpha"},
    )
    case(
        "receipt-check-ambiguous",
        2,
        ["receipt_check_ambiguous"],
        variant={
            "extra_oracle_checks": [
                {
                    "name": "alpha",
                    "argv": ["python3", "-c", "print('ALPHA_OK')"],
                    "exit": 0,
                    "stdout": "ALPHA_OK\n",
                    "stderr": "",
                }
            ]
        },
    )
    case(
        "invalid-replacement-self-cycle",
        1,
        ["superseded_cycle", "superseded_replacement_not_allowed", "superseded_target_not_effective"],
        rows_kwargs={
            "replacements": ["producer_before", "producer_before_oracle", "producer_after_oracle"]
        },
    )
    case(
        "required-replacement-missing",
        1,
        ["superseded_by_unknown", "superseded_replacement_not_allowed", "superseded_required_replacement_missing"],
        rows_kwargs={"replacements": ["producer_before_oracle", "ghost"]},
    )
    case(
        "replacement-failed",
        1,
        ["expected_contains_missing", "superseded_replacement_failed"],
        variant={"oracle_after_stdout": "  check summary preserves top-level exposed declaration kind ok\nWITNESS_SELFTEST: 40/41 pass\n"},
    )
    case(
        "superseded-unexplained-reason",
        1,
        ["superseded_reason_missing"],
        rows_kwargs={"reason": ""},
    )
    case(
        "superseded-raw-missing",
        1,
        ["superseded_raw_missing"],
        variant={"drop_producer_before_check": True},
    )
    case(
        "superseded-raw-binding",
        1,
        ["superseded_raw_binding_mismatch"],
        rows_kwargs={"raw_receipt": oracle},
    )
    case(
        "supersession-unwarranted",
        1,
        ["supersession_unwarranted"],
        variant={
            "producer_before_stdout": "  check summary preserves top-level exposed declaration kind FAIL\n"
        },
    )
    case(
        "supersession-not-permitted",
        1,
        ["supersession_not_permitted"],
        rows_kwargs={
            "drop": ("gamma",),
            "extra_rows": [
                _superseded(
                    "gamma",
                    "not an allowed supersession",
                    ["producer_before_oracle", "producer_after_oracle"],
                    ver,
                    "gamma",
                )
            ],
        },
    )
    case(
        "superseded-oracle-binding",
        1,
        ["superseded_oracle_binding_missing"],
        variant={"oracle_supersedes": "different evidence"},
    )
    case(
        "exit-only-false-positive",
        1,
        ["expected_contains_missing"],
        variant={"alpha_stdout": "SOMETHING_ELSE\n"},
    )
    case(
        "id-only-false-positive",
        1,
        ["expected_id_mismatch"],
        variant={"beta_id": "beta_other"},
    )
    case(
        "structured-mismatch",
        1,
        ["expected_result_reuse_mismatch", "expected_rows_mismatch", "expected_statuses_mismatch"],
        variant={
            "pin_counts": {"legs": 3, "changed": 2, "unchanged": 1, "unavailable": 0},
            "pin_legs": [
                {"leg": "a", "content_status": "changed", "result_reuse": "not_established"},
                {"leg": "b", "content_status": "changed", "result_reuse": "not_established"},
                {"leg": "c", "content_status": "unchanged", "result_reuse": "not_established"},
            ],
            "pin_result_reuse": "established",
        },
    )
    case(
        "effective-exit-mismatch",
        1,
        ["expected_exit_mismatch"],
        variant={"alpha_exit": 1},
    )
    case(
        "tamper-receipt",
        2,
        ["input_digest_mismatch"],
        mutate=lambda fx: (fx["lane"] / fx["ver_rel"]).write_bytes(
            (fx["lane"] / fx["ver_rel"]).read_bytes() + b"\n"
        ),
    )
    case(
        "expected-input-digest-mismatch",
        2,
        ["expected_input_digest_mismatch"],
        mutate=lambda fx: (fx["lane"] / fx["fixture_rel"]).write_bytes(b"changed\n"),
    )
    case(
        "missing-expected-file",
        2,
        ["expected_file_missing"],
        mutate=lambda fx: (fx["lane"] / fx["expected_rel"]).unlink(),
    )
    case(
        "missing-receipt-file",
        2,
        ["input_missing"],
        mutate=lambda fx: (fx["lane"] / fx["ver_rel"]).unlink(),
    )
    case(
        "unpinned-receipt",
        2,
        ["input_unpinned"],
        rows_override=None,
        raw_dispositions=lambda fx: {
            "schema": "evidence-dispositions-v1",
            "expected_file": fx["expected_rel"],
            "inputs": {
                fx["expected_rel"]: _sha((fx["lane"] / fx["expected_rel"]).read_bytes()),
                fx["oracle_rel"]: _sha((fx["lane"] / fx["oracle_rel"]).read_bytes()),
            },
            "rows": _rows(fx),
        },
    )
    case(
        "receipt-bool-exit",
        2,
        ["receipt_check_invalid"],
        variant={"alpha_exit": True},
    )
    case(
        "expected-bool-exit",
        2,
        ["expectation_invalid"],
        variant={"expected_checks": {"alpha": {"exit": True, "contains": "ALPHA_OK"}}},
    )
    case(
        "duplicate-receipt-check",
        2,
        ["receipt_check_duplicate"],
        variant={"duplicate_alpha_check": True},
    )
    case(
        "malformed-json",
        2,
        ["dispositions_json_invalid"],
        raw_dispositions=lambda fx: b'{"schema":',
    )
    case(
        "duplicate-json-key",
        2,
        ["dispositions_json_invalid"],
        raw_dispositions=lambda fx: (
            '{"schema":"evidence-dispositions-v1",'
            '"schema":"evidence-dispositions-v1",'
            '"expected_file":"' + fx["expected_rel"] + '",'
            '"inputs":{},"rows":[]}'
        ).encode("utf-8"),
    )
    case(
        "path-escape-receipt",
        2,
        ["path_rejected"],
        rows_kwargs={"extra_rows": [_effective("ghost", "../verification.json", "ghost")]},
        rows_override=None,
    )

    # v2 (evidence-dispositions-v2) cases.
    hist_reason = "round-13 pinned instrument moved; read committed bytes"

    def _hist(fx, entries):
        built = {}
        for path, spec in entries.items():
            built[path] = {
                "rev": fx["hist_rev"] if spec["rev"] is None else spec["rev"],
                "reason": spec["reason"],
