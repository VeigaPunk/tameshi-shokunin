                    ("pin-status", field(rows_by_leg(payload)["bash-mado-verify"], "pinned", "status"), "unavailable"),
                    ("pin-reason", field(rows_by_leg(payload)["bash-mado-verify"], "pinned", "reason"), "repo_missing"),
