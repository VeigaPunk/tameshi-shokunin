SOURCE .ufo/evidence/round-20/stage/measure.py sha256=f34dc233eee33f4fea9a82c391bfb57ebfef8983f5c7146b4d2dc0b6b3be4e2d
#!/usr/bin/env python3
"""round-20 C1 calibration ruler: six receipt-window population items.

Counts, at one revision, whether the round closed the QUALITY20 recurrence:
frozen-before-dispatch contract, frozen staged instruments, installed gate,
clean selftest receipt, checker-clean final receipts, and the four historical
instrument identities classified. It re-executes the installed receipt-window
gate over committed bytes; it does not trust a prose pass.

Usage: measure.py --repo LANE [--rev REV] [--json] [--explain]
Exit: 0 corrected==total, 1 otherwise, 2 could-not-evaluate.
This file is staged evidence frozen by contract.json before dispatch."""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime

TOTAL = 6
EXPECT_HIST = {
    "96a68b60538504a8a1b5ead9d5811a2c7bcbf8b427c5934b07e22e16c38585ef": "round19-ruler-wave1",
    "8dfaa25aa2713635e7363f60effb442a474ba3656d6cf2bb171c0c22432e3a12": "witness-tool",
    "d22c4025e8ce38b8890bedc1eb9eb5f61366c22f4741910bbe5a942582294a8b": "witness-runner",
    "7ca87a7c98196d87a86627cf96e2e9bc7b3a8769496a75ce8caca1955b26dd37": "round18-measure",
}
CONTRACT = ".ufo/evidence/round-20/contract.json"
DISPATCH = ".ufo/waves/round-20/dispatch.json"
STAGE_GATE = ".ufo/evidence/round-20/stage/receipt-window.py"
STAGE_MEASURE = ".ufo/evidence/round-20/stage/measure.py"
INSTALLED = "tools/receipt-window.py"
FINAL_RECEIPTS = ".ufo/evidence/round-20/final/receipts.json"
HIST_RECEIPTS = ".ufo/evidence/round-20/final/historical-receipts.json"
SELFTEST_RECEIPT = ".ufo/evidence/round-20/final/receipt-window-selftest.json"


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True)


def blob(repo, rev, path):
    proc = git(repo, "show", f"{rev}:{path}")
    return proc.stdout if proc.returncode == 0 else None


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def parse_ts(value):
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        return None
    return dt if dt.tzinfo is not None else None


def commit_time(repo, rev, path):
    proc = git(repo, "log", "-1", "--format=%cI", rev, "--", path)
    if proc.returncode != 0:
        return None
    return parse_ts(proc.stdout.decode("utf-8", "replace"))


def load_json_bytes(data):
    try:
        return json.loads(data.decode("utf-8"))
    except Exception:  # noqa: BLE001
        return None


def run_checker(checker_bytes, contract_bytes, receipts_bytes):
    with tempfile.TemporaryDirectory(prefix="tameshi-r20-measure.") as tmp:
        gate = os.path.join(tmp, "receipt-window.py")
        contract = os.path.join(tmp, "contract.json")
        receipts = os.path.join(tmp, "receipts.json")
        with open(gate, "wb") as fh:
            fh.write(checker_bytes)
        with open(contract, "wb") as fh:
            fh.write(contract_bytes)
        with open(receipts, "wb") as fh:
            fh.write(receipts_bytes)
        return subprocess.run([sys.executable, gate, "--contract", contract, "--receipts", receipts],
                              capture_output=True, text=True)


def main(argv=None):
    parser = argparse.ArgumentParser(description="round-20 C1 receipt-window measure")
    parser.add_argument("--repo", required=True)
    parser.add_argument("--rev", default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--explain", action="store_true")
    args = parser.parse_args(argv)
    repo = args.repo
    rev = args.rev or git(repo, "rev-parse", "master").stdout.decode().strip()
    if not rev:
        print("MEASURE: COULD_NOT_EVALUATE (no revision)")
        return 2

    contract_bytes = blob(repo, rev, CONTRACT)
    contract = load_json_bytes(contract_bytes) if contract_bytes else None
    dispatch_bytes = blob(repo, rev, DISPATCH)
    dispatch = load_json_bytes(dispatch_bytes) if dispatch_bytes else None
    stage_gate = blob(repo, rev, STAGE_GATE)
    stage_measure = blob(repo, rev, STAGE_MEASURE)
    installed = blob(repo, rev, INSTALLED)
    final_receipts = blob(repo, rev, FINAL_RECEIPTS)
    hist_receipts = blob(repo, rev, HIST_RECEIPTS)
    selftest_receipt = blob(repo, rev, SELFTEST_RECEIPT)

    items = []

    def add(item, ok, detail):
        items.append({"id": item, "status": "PASS" if ok else "FAIL", "detail": detail})

    # 1. Contract frozen before dispatch.
    ok = False
    detail = "contract/dispatch/freeze ordering"
    if contract is None:
        detail = "contract.json absent at revision"
    elif not isinstance(contract, dict):
        detail = "contract.json is not an object"
    elif dispatch is None or not isinstance(dispatch, dict):
        detail = "wave-1 dispatch artifact absent at revision"
    else:
        frozen_at = parse_ts(contract.get("frozen_at"))
        dispatched_at = parse_ts(dispatch.get("wave1_dispatched_at"))
        ctime = commit_time(repo, rev, CONTRACT)
        if frozen_at is None:
            detail = "contract.frozen_at is not an aware ISO timestamp"
        elif dispatched_at is None:
            detail = "dispatch.wave1_dispatched_at is not an aware ISO timestamp"
        elif ctime is None:
            detail = "contract has no reachable commit time"
        elif frozen_at <= ctime <= dispatched_at:
            ok = True
            detail = f"frozen_at={contract['frozen_at']} <= commit={ctime.isoformat()} <= dispatch={dispatch['wave1_dispatched_at']}"
        else:
            detail = f"ordering violated frozen={frozen_at.isoformat()} commit={ctime.isoformat()} dispatch={dispatched_at.isoformat()}"
    add("contract_frozen_before_dispatch", ok, detail)

    # 2. Staged instruments match their frozen shas.
    ok = False
    detail = "staged instrument shas"
    if contract is None or stage_gate is None or stage_measure is None:
        detail = "contract or staged instruments absent at revision"
    else:
        try:
            inst = contract["instruments"]
            gate_frozen = inst["receipt-window"]["frozen_sha256"]
            measure_frozen = inst["round20-measure"]["frozen_sha256"]
            gate_sha, measure_sha = sha256(stage_gate), sha256(stage_measure)
            if gate_sha == gate_frozen and measure_sha == measure_frozen:
                ok = True
                detail = f"receipt-window={gate_sha} round20-measure={measure_sha}"
            else:
                detail = f"staged sha mismatch gate={gate_sha}/{gate_frozen} measure={measure_sha}/{measure_frozen}"
        except (KeyError, TypeError) as exc:
            detail = f"contract instruments malformed: {exc}"
    add("staged_instruments_frozen", ok, detail)

    # 3. Installed gate matches its installed sha.
    ok = False
    detail = "installed gate sha"
    if contract is None or installed is None:
        detail = "contract or installed gate absent at revision"
    else:
        try:
            want = contract["instruments"]["receipt-window"]["installed_sha256"]
            got = sha256(installed)
            ok = got == want
            detail = f"installed={got} contract={want}"
        except (KeyError, TypeError) as exc:
            detail = f"contract instruments malformed: {exc}"
    add("installed_matches_contract", ok, detail)

    # 4. Selftest receipt clean.
    ok = False
    detail = "gate selftest receipt"
    if selftest_receipt is None:
        detail = "selftest receipt absent at revision"
    else:
        doc = load_json_bytes(selftest_receipt)
        if not isinstance(doc, dict):
            detail = "selftest receipt is not JSON"
        else:
            stdout = str(doc.get("stdout", ""))
            match = re.search(r"RECEIPT_WINDOW_SELFTEST: (\d+)/(\d+) pass", stdout)
            tally = int(match.group(1)) if match else 0
            total = int(match.group(2)) if match else 0
            if doc.get("exit") == 0 and match and total >= 20 and tally == total:
                ok = True
                detail = f"exit=0 {tally}/{total}"
            else:
                detail = f"exit={doc.get('exit')} tally={tally}/{total}"
    add("selftest_receipt_clean", ok, detail)

    # 5. Final receipts are checker-clean.
    ok = False
    detail = "final receipts checker run"
    if contract_bytes is None or installed is None or final_receipts is None:
        detail = "contract, installed gate, or final receipts absent at revision"
    else:
        run = run_checker(installed, contract_bytes, final_receipts)
        ok = run.returncode == 0
        detail = f"checker exit={run.returncode} {run.stdout.strip().splitlines()[-1] if run.stdout.strip() else run.stderr.strip()[:120]}"
    add("final_receipts_clean", ok, detail)

    # 6. Historical instrument identities classified.
    ok = False
    detail = "historical instrument classification"
    if contract is None or installed is None or hist_receipts is None:
        detail = "contract, installed gate, or historical receipts absent at revision"
    else:
        try:
            historical = contract.get("historical", {})
            missing = [sha for sha, label in EXPECT_HIST.items() if historical.get(sha) != label]
            run = run_checker(installed, contract_bytes, hist_receipts)
            labels_ok = all(label in run.stdout for label in EXPECT_HIST.values())
            if not missing and run.returncode == 0 and labels_ok:
                ok = True
                detail = "4/4 identities classified: " + ", ".join(sorted(EXPECT_HIST.values()))
            else:
                detail = f"missing={missing} checker_exit={run.returncode} labels_ok={labels_ok}"
        except Exception as exc:  # noqa: BLE001
            detail = f"classification check failed: {exc}"
    add("historical_classified", ok, detail)

    corrected = sum(1 for item in items if item["status"] == "PASS")
    result = {
        "schema": "tameshi-round20-receipt-window-measure-v1",
        "revision": rev,
        "total": TOTAL,
        "corrected": corrected,
        "open": TOTAL - corrected,
        "items": items,
        "inputs": {
            CONTRACT: sha256(contract_bytes) if contract_bytes else None,
            DISPATCH: sha256(dispatch_bytes) if dispatch_bytes else None,
            STAGE_GATE: sha256(stage_gate) if stage_gate else None,
            STAGE_MEASURE: sha256(stage_measure) if stage_measure else None,
            INSTALLED: sha256(installed) if installed else None,
            FINAL_RECEIPTS: sha256(final_receipts) if final_receipts else None,
            HIST_RECEIPTS: sha256(hist_receipts) if hist_receipts else None,
            SELFTEST_RECEIPT: sha256(selftest_receipt) if selftest_receipt else None,
        },
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"MEASURE revision={rev}")
        for item in items:
            print(f"ITEM {item['id']} {item['status']} {item['detail']}")
        print(f"C1_RECEIPTS: corrected={corrected} open={TOTAL - corrected} total={TOTAL}")
    return 0 if corrected == TOTAL else 1


if __name__ == "__main__":
    sys.exit(main())


SOURCE .ufo/evidence/round-20/stage/receipt-window.py sha256=f03ae7e91607750e2690f7819c486a3d9db03ee13f0b8cf51958462834dcf7cc
#!/usr/bin/env python3
"""round-20 receipt-window validity gate (QUALITY20/21, routed defect 1).

A receipt is admissible only when it names a nonempty unique id, a lowercase
64-hex instrument sha256, and an aware ISO-8601 measurement_interval with
start <= end. The instrument sha must be one of the contract's frozen or
installed instrument shas, or a classified historical instrument sha. When an
instrument's frozen and installed shas differ, a receipt measured with the
frozen bytes must end at or before the edit window starts, and a receipt
measured with the installed bytes must start at or after the edit window ends.

Exit: 0 clean, 1 findings, 2 could-not-evaluate, 64 usage.
This file is staged evidence. It is frozen by contract.json before any wave
dispatch and is not edited in place during the round (QUALITY20)."""

import argparse
import json
import re
import sys
from datetime import datetime

SHA_RE = re.compile(r"^[0-9a-f]{64}$")
EXIT_CLEAN, EXIT_FAIL, EXIT_CE, EXIT_USAGE = 0, 1, 2, 64


class ContractError(Exception):
    pass


class ReceiptsError(Exception):
    pass


def parse_ts(value):
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is None:
        return None
    return dt


def require_interval(obj, where):
    if not isinstance(obj, dict):
        raise ValueError(f"{where}: measurement_interval must be an object")
    start = parse_ts(obj.get("start"))
    end = parse_ts(obj.get("end"))
    if start is None or end is None:
        raise ValueError(f"{where}: measurement_interval start/end must be aware ISO-8601")
    if start > end:
        raise ValueError(f"{where}: measurement_interval start is after end")
    return start, end


def load_contract(path):
    try:
        with open(path, encoding="utf-8") as fh:
            doc = json.load(fh)
    except Exception as exc:  # noqa: BLE001 - fail closed with a stable kind
        raise ContractError(f"cannot read contract: {exc}") from exc
    if not isinstance(doc, dict):
        raise ContractError("contract must be an object")
    instruments = doc.get("instruments")
    historical = doc.get("historical", {})
    if not isinstance(instruments, dict) or not instruments:
        raise ContractError("contract.instruments must be a nonempty object")
    if not isinstance(historical, dict):
        raise ContractError("contract.historical must be an object")
    index = {}
    windows = {}
    for name, entry in instruments.items():
        if not isinstance(name, str) or not name:
            raise ContractError("instrument name must be a nonempty string")
        if not isinstance(entry, dict):
            raise ContractError(f"instrument {name} must be an object")
        frozen = entry.get("frozen_sha256")
        installed = entry.get("installed_sha256")
        for label, sha in (("frozen_sha256", frozen), ("installed_sha256", installed)):
            if not isinstance(sha, str) or not SHA_RE.match(sha):
                raise ContractError(f"instrument {name}.{label} is not a lowercase 64-hex sha256")
        window = None
        if frozen != installed:
            window = entry.get("edit_interval")
            if not isinstance(window, dict):
                raise ContractError(f"instrument {name} differs frozen/installed and needs edit_interval")
            try:
                start, end = require_interval(window, f"instrument {name}.edit_interval")
            except ValueError as exc:
                raise ContractError(str(exc)) from exc
            if start >= end:
                raise ContractError(f"instrument {name}.edit_interval must be a positive window")
            windows[name] = (start, end)
        elif "edit_interval" in entry:
            try:
                require_interval(entry["edit_interval"], f"instrument {name}.edit_interval")
            except ValueError as exc:
                raise ContractError(str(exc)) from exc
        for role, sha in (("frozen", frozen), ("installed", installed)):
            prior = index.get(sha)
            if prior is not None and prior[0] != name:
                raise ContractError(f"sha {sha} is claimed by both {prior[0]} and {name}")
            if prior is None:
                index[sha] = (name, role if frozen != installed else "identity")
            elif prior[1] == "identity" or role == "identity":
                index[sha] = (name, "identity")
    for sha, label in historical.items():
        if not isinstance(sha, str) or not SHA_RE.match(sha):
            raise ContractError("historical key is not a lowercase 64-hex sha256")
        if not isinstance(label, str) or not label.strip():
            raise ContractError("historical label must be a nonempty string")
        if sha in index:
            raise ContractError(f"historical sha {sha} is also a current instrument sha")
    return {"instruments": instruments, "index": index, "windows": windows,
            "historical": historical, "round": doc.get("round")}


def load_receipts(path):
    try:
        with open(path, encoding="utf-8") as fh:
            doc = json.load(fh)
    except Exception as exc:  # noqa: BLE001
        raise ReceiptsError(f"cannot read receipts: {exc}") from exc
    if not isinstance(doc, dict) or not isinstance(doc.get("receipts"), list):
        raise ReceiptsError("receipts must be an object with a receipts array")
    return doc


def check(contract, receipts_doc):
    findings = []
    infos = []
    seen = set()
    receipts = receipts_doc["receipts"]
    if not receipts:
        findings.append({"id": "NO_RECEIPTS", "receipt": None, "detail": "receipts array is empty"})
    for pos, receipt in enumerate(receipts):
        rid = receipt.get("id") if isinstance(receipt, dict) else None
        where = f"receipts[{pos}]"
        if not isinstance(receipt, dict):
            findings.append({"id": "RECEIPT_MISSING_FIELD", "receipt": where, "detail": "receipt is not an object"})
            continue
        if not isinstance(rid, str) or not rid.strip():
            findings.append({"id": "RECEIPT_MISSING_FIELD", "receipt": where, "detail": "id must be a nonempty string"})
            continue
        if rid in seen:
            findings.append({"id": "DUPLICATE_RECEIPT_ID", "receipt": rid, "detail": "receipt id repeats"})
            continue
        seen.add(rid)
        sha = receipt.get("instrument_sha256")
        if not isinstance(sha, str) or not SHA_RE.match(sha):
            findings.append({"id": "RECEIPT_MISSING_FIELD", "receipt": rid,
                             "detail": "instrument_sha256 must be a lowercase 64-hex sha256"})
            continue
        try:
            start, end = require_interval(receipt.get("measurement_interval"), rid)
        except ValueError as exc:
            findings.append({"id": "BAD_INTERVAL", "receipt": rid, "detail": str(exc)})
            continue
        declared = receipt.get("instrument")
        if declared is not None:
            if not isinstance(declared, str) or declared not in contract["instruments"]:
                findings.append({"id": "UNKNOWN_INSTRUMENT", "receipt": rid,
                                 "detail": f"declared instrument {declared!r} is not in the contract"})
                continue
            entry = contract["instruments"][declared]
            if sha not in (entry.get("frozen_sha256"), entry.get("installed_sha256")):
                findings.append({"id": "UNKNOWN_INSTRUMENT", "receipt": rid,
                                 "detail": f"sha does not match declared instrument {declared}"})
                continue
        if sha in contract["historical"]:
            label = contract["historical"][sha]
            infos.append({"id": "HISTORICAL_INSTRUMENT", "receipt": rid,
                          "detail": f"classified {label}"})
            continue
        if sha not in contract["index"]:
            findings.append({"id": "UNKNOWN_INSTRUMENT", "receipt": rid,
                             "detail": "instrument_sha256 is neither frozen, installed, nor historical"})
            continue
        name, role = contract["index"][sha]
        if role == "identity" or name not in contract["windows"]:
            infos.append({"id": "INSTALL_IDENTITY", "receipt": rid,
                          "detail": f"{name}: frozen and installed bytes are identical"})
            continue
        edit_start, edit_end = contract["windows"][name]
        if role == "frozen" and end > edit_start:
            findings.append({"id": "FROZEN_AFTER_EDIT", "receipt": rid,
                             "detail": f"{name}: frozen-sha measurement ends after edit window starts"})
        elif role == "installed" and start < edit_end:
            findings.append({"id": "INSTALLED_BEFORE_INSTALL", "receipt": rid,
                             "detail": f"{name}: installed-sha measurement starts before install ends"})
        else:
            infos.append({"id": "WINDOW_OK", "receipt": rid, "detail": f"{name}: {role} window respected"})
    findings.sort(key=lambda f: (f["receipt"] or "", f["id"], f["detail"]))
    infos.sort(key=lambda f: (f["receipt"] or "", f["id"], f["detail"]))
    return findings, infos


def run(contract_path, receipts_path, want_json):
    try:
        contract = load_contract(contract_path)
    except ContractError as exc:
        return emit_ce("CONTRACT_INVALID", str(exc), want_json)
    try:
        receipts = load_receipts(receipts_path)
    except ReceiptsError as exc:
        return emit_ce("RECEIPTS_INVALID", str(exc), want_json)
    findings, infos = check(contract, receipts)
    if findings:
        if want_json:
            print(json.dumps({"schema": "tameshi-receipt-window-v1", "verdict": "FAIL",
                              "findings": findings, "infos": infos,
                              "receipts": len(receipts["receipts"])}, sort_keys=True))
        else:
            print(f"RECEIPT_WINDOW: FAIL (findings={len(findings)} receipts={len(receipts['receipts'])})")
            for finding in findings:
                print(f"RECEIPT_WINDOW finding={finding['id']} receipt={finding['receipt']} {finding['detail']}")
        return EXIT_FAIL
    if want_json:
        print(json.dumps({"schema": "tameshi-receipt-window-v1", "verdict": "CLEAN",
                          "findings": [], "infos": infos,
                          "receipts": len(receipts["receipts"])}, sort_keys=True))
    else:
        hist = sum(1 for i in infos if i["id"] == "HISTORICAL_INSTRUMENT")
        print(f"RECEIPT_WINDOW: CLEAN (receipts={len(receipts['receipts'])} historical={hist})")
        for info in infos:
            print(f"RECEIPT_WINDOW info={info['id']} receipt={info['receipt']} {info['detail']}")
    return EXIT_CLEAN


def emit_ce(kind, detail, want_json):
    if want_json:
        print(json.dumps({"schema": "tameshi-receipt-window-v1", "verdict": "COULD_NOT_EVALUATE",
                          "kind": kind, "detail": detail}, sort_keys=True))
    else:
        print(f"RECEIPT_WINDOW: COULD_NOT_EVALUATE ({kind}: {detail})")
    return EXIT_CE


def selftest():
    f, i = "a" * 64, "b" * 64
    e = "e" * 64
    h1, h2 = "c" * 64, "d" * 64
    contract = {
        "round": 20,
        "instruments": {
            "gate": {"frozen_sha256": f, "installed_sha256": i,
                     "edit_interval": {"start": "2026-10-21T10:00:00Z", "end": "2026-10-21T11:00:00Z"}},
            "measure": {"frozen_sha256": e, "installed_sha256": e},
        },
        "historical": {h1: "round19-ruler-wave1", h2: "witness-tool"},
    }
    # Build the contract index without the filesystem.
    index, windows = {}, {}
    for name, entry in contract["instruments"].items():
        frozen, installed = entry["frozen_sha256"], entry["installed_sha256"]
        role = "identity" if frozen == installed else None
        for sha, r in ((frozen, "frozen"), (installed, "installed")):
            if sha not in index:
                index[sha] = (name, role or r)
            elif role or r == "identity":
                index[sha] = (name, "identity")
        if frozen != installed:
            st = parse_ts(entry["edit_interval"]["start"])
            en = parse_ts(entry["edit_interval"]["end"])
            windows[name] = (st, en)
    frozen_contract = {"instruments": contract["instruments"], "index": index,
                       "windows": windows, "historical": contract["historical"], "round": 20}

    def r(rid, sha, start="2026-10-21T09:00:00Z", end="2026-10-21T09:30:00Z", **extra):
        row = {"id": rid, "instrument_sha256": sha,
               "measurement_interval": {"start": start, "end": end}}
        row.update(extra)
        return row

    def ok(rid, sha, start="2026-10-21T09:00:00Z", end="2026-10-21T09:30:00Z", **extra):
        return ({"receipts": [r(rid, sha, start, end, **extra)]}, "CLEAN", None)

    def bad(rid, sha, kind, start="2026-10-21T09:00:00Z", end="2026-10-21T09:30:00Z", **extra):
        return ({"receipts": [r(rid, sha, start, end, **extra)]}, "FAIL", kind)

    cases = [
        ("frozen receipt before the edit window is clean", ok("c1", f)),
        ("installed receipt after the edit window is clean",
         ok("c2", i, "2026-10-21T11:00:00Z", "2026-10-21T11:30:00Z")),
        ("missing instrument sha is refused", bad("c3", "", "RECEIPT_MISSING_FIELD")),
        ("unknown sha is refused", bad("c4", "9" * 64, "UNKNOWN_INSTRUMENT")),
        ("missing interval is refused", ({"receipts": [{"id": "c5", "instrument_sha256": f}]}, "FAIL", "BAD_INTERVAL")),
        ("reversed interval is refused", bad("c6", f, "BAD_INTERVAL", "2026-10-21T09:30:00Z", "2026-10-21T09:00:00Z")),
        ("naive timestamp is refused", bad("c7", f, "BAD_INTERVAL", "2026-10-21T09:00:00", "2026-10-21T09:30:00")),
        ("frozen sha after the edit starts is refused",
         bad("c8", f, "FROZEN_AFTER_EDIT", "2026-10-21T09:00:00Z", "2026-10-21T10:30:00Z")),
        ("installed sha before the edit ends is refused",
         bad("c9", i, "INSTALLED_BEFORE_INSTALL", "2026-10-21T10:30:00Z", "2026-10-21T11:30:00Z")),
        ("duplicate id is refused",
         ({"receipts": [r("c10", f), r("c10", i, "2026-10-21T11:00:00Z", "2026-10-21T11:30:00Z")]},
          "FAIL", "DUPLICATE_RECEIPT_ID")),
        ("empty receipts is refused", ({"receipts": []}, "FAIL", "NO_RECEIPTS")),
        ("historical sha is classified, not gated", ok("c12", h1, "2020-01-01T00:00:00Z", "2020-01-01T01:00:00Z")),
        ("second historical sha is classified", ok("c13", h2, "2020-01-01T00:00:00Z", "2020-01-01T01:00:00Z")),
        ("identity instrument accepts a wave-time receipt", ok("c14", e)),
        ("declared instrument mismatch is refused", bad("c15", f, "UNKNOWN_INSTRUMENT", instrument="measure")),
        ("multi-receipt one-bad row fails the file",
         ({"receipts": [r("ok", f), r("bad", "9" * 64)]}, "FAIL", "UNKNOWN_INSTRUMENT")),
        ("frozen-sha receipt ending exactly at edit start is clean",
         ok("c17", f, "2026-10-21T09:00:00Z", "2026-10-21T10:00:00Z")),
        ("installed-sha receipt starting exactly at edit end is clean",
         ok("c18", i, "2026-10-21T11:00:00Z", "2026-10-21T11:30:00Z")),
    ]
    passed = 0
    for pos, (label, (doc, want, kind)) in enumerate(cases, 1):
        findings, infos = check(frozen_contract, doc)
        got = "FAIL" if findings else "CLEAN"
        kinds = {x["id"] for x in findings}
        good = got == want and (kind is None or kind in kinds)
        if good:
            passed += 1
            print(f"PASS [{pos:2d}/{len(cases)}] {label} — {got}")
        else:
            print(f"FAIL [{pos:2d}/{len(cases)}] {label} — want {want}/{kind} got {got}/{sorted(kinds)}")
    # Contract validation cases exercise the file loader.
    import tempfile, os
    with tempfile.TemporaryDirectory(prefix="tameshi-r20-rw-selftest.") as tmp:
        bad_contract = os.path.join(tmp, "bad-contract.json")
        with open(bad_contract, "w", encoding="utf-8") as fh:
            fh.write("{not json")
        try:
            load_contract(bad_contract)
            print(f"FAIL [{len(cases) + 1:2d}/{len(cases) + 2}] malformed contract is refused — accepted")
        except ContractError:
            passed += 1
            print(f"PASS [{len(cases) + 1:2d}/{len(cases) + 2}] malformed contract is refused — CONTRACT_INVALID")
        bad_receipts = os.path.join(tmp, "bad-receipts.json")
        with open(bad_receipts, "w", encoding="utf-8") as fh:
            fh.write('{"receipts": 5}')
        try:
            load_receipts(bad_receipts)
            print(f"FAIL [{len(cases) + 2:2d}/{len(cases) + 2}] malformed receipts is refused — accepted")
        except ReceiptsError:
            passed += 1
            print(f"PASS [{len(cases) + 2:2d}/{len(cases) + 2}] malformed receipts is refused — RECEIPTS_INVALID")
    total = len(cases) + 2
    print(f"RECEIPT_WINDOW_SELFTEST: {passed}/{total} pass")
    return EXIT_CLEAN if passed == total else EXIT_FAIL


def main(argv=None):
    parser = argparse.ArgumentParser(description="round-20 receipt-window validity gate")
    parser.add_argument("--contract")
    parser.add_argument("--receipts")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--selftest", action="store_true")
    args = parser.parse_args(argv)
    if args.selftest:
        return selftest()
    if not args.contract or not args.receipts:
        parser.print_usage(sys.stderr)
        return EXIT_USAGE
    return run(args.contract, args.receipts, args.json)


if __name__ == "__main__":
    sys.exit(main())


SOURCE .ufo/evidence/round-20/coldread/measure.py sha256=48927bfeaf9c70108270e022478366bfdb2a47821724eaba1001aefe1264fe13
#!/usr/bin/env python3
"""Select the round-20 ledger using the unchanged round-18 credit algorithm.

--selftest exercises this packaged selector in isolated synthetic repositories;
the frozen implementation's own suite remains separately registered.
"""
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
IMPLEMENTATION = ROOT / '.ufo/evidence/round-18/measure.py'
spec = importlib.util.spec_from_file_location('tameshi_round18_measure', IMPLEMENTATION)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
LEDGER = '.ufo/evidence/round-20/coldread/ledger.json'
FORBIDDEN_OVERRIDES = ('--ledger-file', '--ledger-rev', '--inputs-overlay')


def forbidden_override(arguments):
    return next((arg for arg in arguments
                 if arg.startswith('--') and len(arg.split('=', 1)[0]) > 2
                 and any(flag.startswith(arg.split('=', 1)[0])
                         for flag in FORBIDDEN_OVERRIDES)), None)


def selftest():
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    env.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
               PYTHONDONTWRITEBYTECODE='1')
    outcomes = []
    with tempfile.TemporaryDirectory(prefix='tameshi-r20-selector-', dir='/tmp') as tmp:
        repo = Path(tmp) / 'repo'
        repo.mkdir()
        env['HOME'] = tmp
        def git(*args):
            return subprocess.run(['git', '-c', 'core.hooksPath=/dev/null', '-C', str(repo),
                                   *args], env=env, capture_output=True, check=True).stdout
        def put(path, text):
            target = repo / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(text, encoding='utf-8')
        git('init', '--quiet', '-b', 'master')
        put('tools/mutate-and-run.sh', module.RUNNER_TEXT)
        put('SKILL.md', '\n'.join(module.SKILL_LINES) + '\n')
        put('SHONEN.md', module.SHONEN_TEXT.replace(module.DEFAULT_LEDGER_PATH, LEDGER))
        put('corpus/SOURCES.md', module.SOURCES_TEXT)
        put(module.INPUT_FILE, module.INPUT_V1)
        put(module.TRACE_PATH, module.trace_receipt({module.INPUT_FILE: module.INPUT_V1_SHA}))
        put(LEDGER, module.ledger_json())
        put(module.DEFAULT_LEDGER_PATH, module.ledger_json())
        wrapper = '.ufo/evidence/round-20/coldread/measure.py'
        put(wrapper, Path(__file__).read_text(encoding='utf-8'))
        put('.ufo/evidence/round-18/measure.py', IMPLEMENTATION.read_text(encoding='utf-8'))
        def commit():
            git('add', '--all')
            git('-c', 'user.name=fixture', '-c', 'user.email=fixture@example.invalid',
                'commit', '--quiet', '-m', 'selector fixture')
            return git('rev-parse', 'HEAD').decode().strip()
        rev = commit()
        def invoke(*extra):
            return subprocess.run([sys.executable, str(repo / wrapper), '--rev', rev, *extra],
                                  cwd=tmp, env=env, capture_output=True, timeout=30)
        run = invoke('--repo', str(repo))
        result = json.loads(run.stdout)
        outcomes.append(('configured-default-ledger', run.returncode == 0
                         and result['coldread']['sections_covered'] == 4
                         and result['calibration_restraint_score'] == 8
                         and result['overrides_used'] is False and result['trace_gate'] == 'strict'))
        run = invoke()
        result = json.loads(run.stdout)
        outcomes.append(('relocated-package-default-repo', run.returncode == 0
                         and result['coldread']['sections_covered'] == 4))
        (repo / LEDGER).unlink()
        rev = commit()
        run = invoke('--repo', str(repo))
        result = json.loads(run.stdout)
        outcomes.append(('no-historical-ledger-fallback', run.returncode == 0
                         and result['coldread']['sections_covered'] == 0
                         and result['calibration_restraint_score'] == 6))
        for extra in (('--ledger-file', '/none'), ('--ledger-rev', 'bad:path'),
                      ('--inputs-overlay', '/none'), ('--ledger-file=/none',),
                      ('--ledger-rev=bad:path',), ('--inputs-overlay=/none',),
                      ('--i=/none',), ('--ledger-f=/none',), ('--inputs-o=/none',)):
            run = invoke(*extra)
            outcomes.append(('override-refused:' + extra[0],
                             run.returncode == 64
                             and b'SELECTOR_OVERRIDE_FORBIDDEN' in run.stderr))
    for name, ok in outcomes:
        print('CASE', name, 'PASS' if ok else 'FAIL')
    passed = sum(ok for _, ok in outcomes)
    print(f'SELECTOR_SELFTEST: {passed}/{len(outcomes)} pass')
    return 0 if passed == len(outcomes) else 1


if __name__ == '__main__':
    if sys.argv[1:] == ['--selftest']:
        sys.exit(selftest())
    rejected = forbidden_override(sys.argv[1:])
    if rejected is not None:
        print('SELECTOR_OVERRIDE_FORBIDDEN: ' + rejected, file=sys.stderr)
        sys.exit(64)
    module.DEFAULT_LEDGER_PATH = LEDGER
    module.LEDGER_PATH = LEDGER
    module.BOX3_LINK = LEDGER
    module.IGNORED_INPUTS = module.IGNORED_INPUTS | frozenset((LEDGER,))
    sys.exit(module.main())


