SOURCE tools/bash-witness-study.py sha256=8dfaa25aa2713635e7363f60effb442a474ba3656d6cf2bb171c0c22432e3a12
#!/usr/bin/env python3
"""bash-witness-study.py — declared-witness classification of the pinned
bash-surface-census mutation leg (tameshi-shokunin, round 12, seat BashWitness).

What this tool does
-------------------
declare   materialize the pinned target from the kagi git object store, extract
          the embedded defect spec from tools/mutate-and-run.sh, and write the
          frozen declared-witness TSV (one row per defect: the selftest case
          labels that the mutation should turn red, or NONE) plus
          declaration.json carrying every input digest.  Refuses to overwrite an
          existing declared.tsv.
run       refuse unless declared.tsv matches its recorded digest, then execute
          the pinned mutation CLI sweep (tools/mutate-and-run.sh, all 10
          defects, suite `bash "$MUTANT" --selftest`) and classify every defect
          killed-on-witness / accidental / survived / inconclusive.  Refuses
          unless the runner exits 0/1, prints a terminal DONE/DEGRADED line, an
          anchored CONTROL: GREEN line, and a restore line whose before/after
          target digest equals the pinned target.  Writes summary.json
          (per-defect rows, classifier digest) and a full manifest.json over
          every evidence file.
count     recompute the retained sweep from results.tsv, the mutant artifacts
          and the raw case logs, compare every row/count/status with
          summary.json, and refuse a mismatch.  Prints recomputed rows only.
rerun     re-check digests, refuse on tamper, run a fresh sweep into
          rerun-<stamp>/ with its own summary.json, preserve the committed
          summary, extend the full manifest, and compare classifications with
          the committed summary.
check     require the full manifest and validate every committed digest plus
          exact file-set equality (unlisted, missing, unsafe and malformed
          entries refuse); a modified declared.tsv (or any other covered file)
          refuses with a named error before any classification.
selftest  hermetic fixtures for the parser, classifier, result table, manifest
          and summary tamper paths.

Exit codes: 0 ok/clean · 1 failed (tamper, mismatch, inconclusive) ·
            2 cannot evaluate (missing inputs, pin mismatch, runner SETUP) ·
            64 usage.

Classification rule (declared before the sweep)
-----------------------------------------------
* killed-on-witness — the mutant's run is red with the full selftest
  denominator (16 declared cases) and at least one pre-declared witness case
  failed.
* accidental — red with the full denominator and no pre-declared witness case
  failed (including every defect declared NONE).
* survived — green with the full denominator and zero failing cases.
* inconclusive — anything else: missing SELFTEST line, denominator != 16,
  ok+bad+skip != 16, skip labels other than the two expected verbs skips,
  skip set differing from the control's, runner verdict INCONCLUSIVE.
The declared total is 16; on a host without the-janitor on PATH the two verbs
cases are recorded as skip-case rows (14 exercised + 2 skipped) — skipped
checks are never counted as executed.

Disclosure — this is a declared-witness mapping, NOT a blind preregistration
---------------------------------------------------------------------------
The mapping below was authored from the pinned target's selftest and the
embedded spec, but the author had prior exposure to recorded aggregate outcomes
of this leg before declaring: the recorded kill-rate header of
tools/mutate-and-run.sh, the corpus/README.md coverage row for
mutation-case-kagi-census.md, the SOURCES.md S033 row, and the recorded
TABLE_BASH per-defect KILLED/SURVIVED entries (surfaced by a pin grep).  No
per-defect *witness* classification of this leg existed before this run; the
mapping is hashed before execution and is never rewritten after results.

Environment scrub: every child process drops inherited `GIT_*` variables, then
sets `GIT_CONFIG_GLOBAL=/dev/null` and `GIT_CONFIG_NOSYSTEM=1`. The sweep
environment additionally removes THE_JANITOR_BIN, SQLITE3_BIN, CENSUS_BREAK,
DEEP and ONEPASSWORD_BROWSER_SUPPORT (each is read by the pinned gate and can
change behavior). The resolved `the-janitor`/`sqlite3` PATH facts are recorded
in summary.json, and a `the-janitor` found on PATH refuses the sweep so the
selftest cannot reach a real op/custody surface. REV_BASH must be an exact
40-hex git id and materialization runs `git show --end-of-options`.

Usage errors exit 64 (the probe contract), not argparse's default 2.
"""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
EVIDENCE_DEFAULT = REPO / ".ufo" / "evidence" / "round-12" / "BashWitness"
RUNNER = REPO / "tools" / "mutate-and-run.sh"
KAGI_DEFAULT = REPO.parent / "kagi-shokunin"
TARGET_GIT_PATH = "corpus/surface-census.sh"
TARGET_NAME = "pristine.sh"
SPEC_NAME = "bash-surface-census.spec"
DECLARED_NAME = "declared.tsv"
DECLARATION_NAME = "declaration.json"
SUMMARY_NAME = "summary.json"
MANIFEST_NAME = "manifest.json"
SWEEP_DIR = "sweep"
LABEL = "bash-surface-census"
SUITE = 'bash "$MUTANT" --selftest'
DECLARED_TOTAL = 16
EXPECTED_CASE_LABELS = (
    "clean", "mode-drift", "asset-gone", "runtime-absent", "undeclared-file",
    "crosscheck-disagree", "symlink-swap", "sqlite-magic",
    "sqlite-magic-prefix-only", "sqlite-unavailable", "required-table-gone",
    "row-floor", "malformed-row", "fused-shape-row", "verbs-sandboxed",
    "verbs-break-injection",
)
EXPECTED_SKIP_LABELS = ("verbs-sandboxed", "verbs-break-injection")
SCRUB_ENV = ("THE_JANITOR_BIN", "SQLITE3_BIN", "CENSUS_BREAK", "DEEP",
             "ONEPASSWORD_BROWSER_SUPPORT")
EXIT_OK, EXIT_FAIL, EXIT_CANNOT, EXIT_USAGE = 0, 1, 2, 64

# ---------------------------------------------------------------------------
# declared witness mapping (frozen; authored from the pinned selftest + spec)
# ---------------------------------------------------------------------------
# Each row: defect id -> (witness case labels or None for NONE, rationale).
# Case labels are the selftest's `(ok|bad|skip)-case NN <name>` names.
DECLARED_WITNESSES = (
    ("B1", ("undeclared-file",),
     "verify_unlisted early-return flips to `-ne 0`, so the SURFACE UNLISTED "
     "sweep is skipped whenever scan dirs exist (pristine.sh:241). Only "
     "`undeclared-file` plants an undeclared child in a declared scan dir and "
     "asserts exit 1 + token SURFACE UNLISTED; the clean tree has no unlisted "
     "child, so no other case's pass condition depends on the sweep."),
    ("B2", ("clean", "runtime-absent"),
     "rows_min `-ge`->`-gt` (pristine.sh:435) breaks the equality boundary "
     "got==floor. The intact-db cases pin that boundary (part rows 1 vs floor "
     "1): `clean` (exit 0 + SURFACE OK) and `runtime-absent` (exit 0). "
     "`row-floor` exercises 0<1, which fails under both operators, so it "
     "cannot witness this change."),
    ("B3", ("crosscheck-disagree", "clean"),
     "crosscheck `!=`->`==` (pristine.sh:229) flags agreement instead of "
     "disagreement. `crosscheck-disagree` builds baseline 644 vs census 600 "
     "and asserts exit 1 + SURFACE CROSSCHECK (mutant passes silently); "
     "`clean` carries baseline 600 == census 600 and asserts exit 0 (mutant "
     "flags it). Both cases drive the mutated branch."),
    ("B4", ("symlink-swap",),
     "the symlink guard is deleted (pristine.sh:200-204), so the declared-exec "
     "symlink falls through to the live-kind check and prints SURFACE DIVERGED "
     "(live symlink) instead of SURFACE LINK. `symlink-swap` asserts exit 1 + "
     "token SURFACE LINK. No other case creates a symlink."),
    ("B5", None,
     "the exec-bit arm is deleted (pristine.sh:214-217). NONE: no selftest case "
     "creates a declared-exec path that is a regular file without the execute "
     "bit — the only exec path (.local/bin/the-janitor) is created 755, and "
     "`symlink-swap` is intercepted by the earlier symlink guard. Fixture-"
     "absent arm: no assertion can witness this mutation."),
    ("B6", ("clean", "runtime-absent"),
     "magic compare `head -c ${#value}+1` -> `${#value}` (pristine.sh:371) "
     "makes the 15-byte read no longer match the 16-byte expected file, so the "
     "positive magic path fails on the real sqlite header (`SQLite format "
     "3\\0`): `clean` and `runtime-absent` assert exit 0 there. Note "
     "`sqlite-magic-prefix-only` (the case built for the NUL contract) still "
     "passes under the mutant — a 15-byte read still differs from the 16-byte "
     "expected — so it cannot witness this change."),
    ("B7", ("sqlite-unavailable",),
     "N_UNVERIFIED += 2 (pristine.sh:405-406) changes only the summary count; "
     "the three sqlite-dependent shape rows print unverified=6 instead of 3. "
     "`sqlite-unavailable` is the only case asserting the DRIFT line token "
     "`unverified=3`."),
    ("B8", ("malformed-row", "fused-shape-row"),
     "die() exits 1 instead of 2 (pristine.sh:85). The two refusal cases that "
     "assert exit 2 go red: `malformed-row` (bad kind) and `fused-shape-row` "
     "(too many fields). Both route through die()."),
    ("B9", ("asset-gone", "runtime-absent"),
     "the missing-path class test flips `runtime`->`asset` (pristine.sh:191), "
     "swapping GONE (failure) and ABSENT (not a failure) for missing paths. "
     "`asset-gone` asserts exit 1 + SURFACE GONE for the missing asset (mutant "
     "prints ABSENT, exit 0); `runtime-absent` asserts exit 0 for the missing "
     "runtime file (mutant prints GONE, exit 1)."),
    ("B10", None,
     "the CLEAN summary's ok= argument becomes $N_ABSENT (pristine.sh:862). "
     "NONE: no selftest case asserts the CLEAN summary line's ok= field; the "
     "`clean` case's token SURFACE OK is matched by per-path SURFACE OK lines, "
     "which the mutation does not touch."),
)

DISCLOSURE = (
    "declared-witness mapping, not a blind preregistration: before declaring, "
    "the author had seen recorded aggregate outcomes of this leg — the "
    "recorded kill-rate header of tools/mutate-and-run.sh, the "
    "corpus/README.md coverage row for mutation-case-kagi-census.md, the "
    "SOURCES.md S033 row, and the recorded TABLE_BASH per-defect "
    "KILLED/SURVIVED entries surfaced by a pin grep. No per-defect witness "
    "classification of this leg existed before this run."
)

CASE_RE = re.compile(r"^(ok-case|bad-case|skip-case)\s+(\d+)\s+(\S+)")
FINAL_RE = re.compile(r"^SELFTEST: (PASS|FAIL) \((\d+)(?:/(\d+))? cases\)\s*$")
PIN_RE = re.compile(r"^(PIN_BASH)=([0-9a-f]{64})$", re.M)
REV_RE = re.compile(r"^(REV_BASH)=([0-9a-f]{40})$", re.M)
HEREDOC_RE = re.compile(r'^\s*cat >"\$d/bash-surface-census\.spec" <<\'EOT\'$')
SPEC_LINE_RE = re.compile(r"^@(defect|old|new)(?: (.*))?$")
UNESCAPES = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\"}


class Cannot(Exception):
    """could-not-evaluate: missing input, pin mismatch, runner SETUP."""


class Fail(Exception):
    """definite negative finding: tamper, mismatch, inconclusive run."""


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise Cannot(f"unreadable {path}: {exc}") from exc


def read_text_lossy(path: Path) -> str:
    """Suite logs are target output; decode with replacement (never crash)."""
    try:
        return path.read_bytes().decode("utf-8", "replace")
    except OSError as exc:
        raise Cannot(f"unreadable {path}: {exc}") from exc


def utc_stamp() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def unescape(text: str, where: str) -> str:
    out, i = [], 0
    while i < len(text):
        ch = text[i]
        if ch != "\\":
            out.append(ch)
            i += 1
            continue
        if i + 1 >= len(text):
            raise Cannot(f"{where}: trailing backslash in spec literal")
        nxt = text[i + 1]
        if nxt not in UNESCAPES:
            raise Cannot(f"{where}: unknown escape '\\{nxt}' in spec literal")
        out.append(UNESCAPES[nxt])
        i += 2
    return "".join(out)


def runner_pins(text: str) -> dict:
    pins = {}
    for pattern in (PIN_RE, REV_RE):
        pins.update({m.group(1): m.group(2) for m in pattern.finditer(text)})
    missing = [k for k in ("PIN_BASH", "REV_BASH") if k not in pins]
    if missing:
        raise Cannot(f"runner is missing pin constant(s): {', '.join(missing)}")
    return pins


def extract_spec(runner_text: str) -> str:
    lines = runner_text.splitlines()
    start = None
    for i, line in enumerate(lines):
        if HEREDOC_RE.match(line):
            start = i + 1
            break
    if start is None:
        raise Cannot("runner has no bash-surface-census.spec heredoc")
    for j in range(start, len(lines)):
        if lines[j] == "EOT":
            return "\n".join(lines[start:j]) + "\n"
    raise Cannot("bash-surface-census.spec heredoc is unterminated")


def parse_spec(text: str) -> list:
    defects, cur = [], None
    for lineno, raw in enumerate(text.splitlines(), 1):
        if not raw or raw.startswith("#"):
            continue
        m = SPEC_LINE_RE.match(raw)
        if not m:
            raise Cannot(f"spec line {lineno}: not a directive")
        kind, rest = m.group(1), m.group(2) or ""
        if kind == "defect":
            if "|" not in rest:
                raise Cannot(f"spec line {lineno}: @defect without ' | '")
            ident, desc = rest.split("|", 1)
            cur = {"id": ident.strip(), "desc": desc.strip(), "old": None, "new": None}
            defects.append(cur)
        else:
            if cur is None:
                raise Cannot(f"spec line {lineno}: @{kind} before any @defect")
            if cur[kind] is not None:
                raise Cannot(f"spec line {lineno}: duplicate @{kind} for {cur['id']}")
            cur[kind] = unescape(rest, f"spec line {lineno}")
    for d in defects:
        if d["old"] is None or d["new"] is None:
            raise Cannot(f"spec defect {d['id']}: missing @old or @new")
    ids = [d["id"] for d in defects]
    duplicates = sorted({ident for ident in ids if ids.count(ident) > 1})
    if duplicates:
        raise Cannot(f"spec duplicate defect id(s): {', '.join(duplicates)}")
    return defects


def spec_precheck(defects: list, target_text: str) -> dict:
    """Non-blocking sanity record; the runner's own count==1 gate is authoritative."""
    non_unique = []
    for d in defects:
        count = target_text.count(d["old"])
        if count != 1:
            non_unique.append({"id": d["id"], "count": count})
    return {
        "checked": True,
        "defects": len(defects),
        "all_unique": not non_unique,
        "non_unique": non_unique,
    }


def git_clean_env() -> dict:
    """Remove inherited Git settings, then pin safe configuration sources."""
    env = {name: value for name, value in os.environ.items()
           if not name.startswith("GIT_")}
    env["GIT_CONFIG_GLOBAL"] = "/dev/null"
    env["GIT_CONFIG_NOSYSTEM"] = "1"
    return env


def materialize_target(kagi: Path, rev: str) -> bytes:
    if not re.fullmatch(r"[0-9a-f]{40}", rev or ""):
        raise Cannot(f"revision is not an exact 40-hex git id: {rev!r}")
    if not (kagi / ".git").exists() and not (kagi / ".jj").exists():
        raise Cannot(f"kagi object store not found at {kagi}")
    proc = subprocess.run(
        ["git", "-C", str(kagi), "show", "--end-of-options",
         f"{rev}:{TARGET_GIT_PATH}"],
        capture_output=True, check=False, env=git_clean_env())
    if proc.returncode != 0:
        raise Cannot(f"git show {rev}:{TARGET_GIT_PATH} failed: "
                     f"{proc.stderr.decode('utf-8', 'replace').strip()}")
    return proc.stdout


def declared_rows() -> list:
    rows = []
    for ident, witness, rationale in DECLARED_WITNESSES:
        rows.append((ident, "NONE" if witness is None else ",".join(witness), rationale))
    return rows


def declared_tsv_text(meta: dict) -> str:
    lines = [
        "# bash-witness-study — declared witness mapping (frozen before the sweep)",
        f"# seat: BashWitness · round: round-12 · leg: {LABEL} (pinned)",
        f"# target: {TARGET_NAME} sha256={meta['target_sha256']} "
        f"(kagi-shokunin@{meta['rev']} {TARGET_GIT_PATH})",
        f"# spec:   {SPEC_NAME} sha256={meta['spec_sha256']} "
        f"(heredoc of tools/mutate-and-run.sh sha256={meta['runner_sha256']})",
        f"# suite:  {SUITE} · declared total {DECLARED_TOTAL} cases "
        f"(2 verbs cases skip when the-janitor is absent)",
        "# rule: killed-on-witness iff a full-denominator red run fails >=1 declared",
        "#       case; accidental iff red with none; survived iff green with the",
        "#       full denominator; inconclusive otherwise.",
        "# kind: declared-witness mapping, NOT a blind preregistration (disclosure",
        "#       in declaration.json and the evidence README).",
        "# fields: defect<TAB>witness<TAB>rationale   (witness = comma list or NONE)",
    ]
    for ident, witness, rationale in declared_rows():
        lines.append(f"{ident}\t{witness}\t{rationale}")
    return "\n".join(lines) + "\n"


def parse_declared_tsv(text: str) -> dict:
    mapping = {}
    for lineno, raw in enumerate(text.splitlines(), 1):
        if not raw or raw.startswith("#"):
            continue
        fields = raw.split("\t")
        if len(fields) != 3:
            raise Cannot(f"declared.tsv line {lineno}: expected 3 tab fields")
        ident, witness, rationale = fields
        if witness == "NONE":
            mapping[ident] = None
        else:
            mapping[ident] = tuple(w.strip() for w in witness.split(",") if w.strip())
        if not rationale.strip():
            raise Cannot(f"declared.tsv line {lineno}: empty rationale")
    if not mapping:
        raise Cannot("declared.tsv has no rows")
    return mapping


def declared_expected() -> dict:
    return {ident: (tuple(witness) if witness is not None else None)
            for ident, witness, _ in DECLARED_WITNESSES}


# ------------------------------------------------------------------ classifier

def parse_case_lines(log_text: str) -> dict:
    ok, bad, skip = [], [], []
    numbers = []
    total = failures = None
    selftest_line = None
    last_nonempty = None
    selftest_at = None
    for index, raw in enumerate(log_text.splitlines()):
        if raw.strip():
            last_nonempty = index
        m = CASE_RE.match(raw)
        if m:
            kind, num, name = m.group(1), int(m.group(2)), m.group(3)
            {"ok-case": ok, "bad-case": bad, "skip-case": skip}[kind].append(name)
            numbers.append(num)
            continue
        m = FINAL_RE.match(raw)
        if m:
            selftest_line = raw.strip()
            selftest_at = index
            if m.group(1) == "PASS":
                total, failures = int(m.group(2)), 0
            else:
                failures = int(m.group(2))
                total = int(m.group(3)) if m.group(3) is not None else None
    return {
        "ok": ok, "bad": bad, "skip": skip, "numbers": numbers,
        "total": total, "failures": failures, "selftest_line": selftest_line,
        "selftest_terminal": selftest_at is not None and selftest_at == last_nonempty,
    }


def run_problems(runinfo: dict, control: dict) -> list:
    """Completeness problems shared by the control and every mutant run."""
    reasons = []
    if runinfo["selftest_line"] is None:
        reasons.append("no-selftest-line")
    elif not runinfo["selftest_terminal"]:
        reasons.append("selftest-line-not-terminal")
    if runinfo["total"] != DECLARED_TOTAL:
        reasons.append(f"denominator={runinfo['total']}!=declared-{DECLARED_TOTAL}")
    if runinfo["total"] is not None:
        accounted = len(runinfo["ok"]) + len(runinfo["bad"]) + len(runinfo["skip"])
        if accounted != runinfo["total"]:
            reasons.append(f"case-accounting={accounted}!=total-{runinfo['total']}")
    if runinfo["total"] is not None:
        if sorted(runinfo["numbers"]) != list(range(1, runinfo["total"] + 1)):
            reasons.append("incomplete-case-numbering")
    if runinfo["skip"] and sorted(runinfo["skip"]) != sorted(EXPECTED_SKIP_LABELS):
        reasons.append("unexpected-skip-label:" + ",".join(runinfo["skip"]))
    if sorted(runinfo["skip"]) != sorted(control["skip"]):
        reasons.append("skip-set-differs-from-control")
    observed = runinfo["ok"] + runinfo["bad"] + runinfo["skip"]
    duplicates = sorted({label for label in observed if observed.count(label) > 1})
    if duplicates:
        reasons.append("duplicate-case-label:" + ",".join(duplicates))
    if set(observed) != set(EXPECTED_CASE_LABELS):
        missing = sorted(set(EXPECTED_CASE_LABELS) - set(observed))
        extra = sorted(set(observed) - set(EXPECTED_CASE_LABELS))
        reasons.append("catalog-mismatch:missing=" + (",".join(missing) or "-")
                       + ";extra=" + (",".join(extra) or "-"))
    if runinfo["failures"] is not None:
        if runinfo["failures"] != len(runinfo["bad"]):
            reasons.append(f"failure-count={runinfo['failures']}"
                           f"!=bad-case-count={len(runinfo['bad'])}")
        exit_code = runinfo.get("exit")
        if exit_code is not None and (runinfo["failures"] > 0) != (exit_code != 0):
            reasons.append(f"exit={exit_code} inconsistent with "
                           f"failures={runinfo['failures']}")
    return reasons


def classify(defect_id, verdict, runinfo, control, witnesses) -> tuple:
    reasons = run_problems(runinfo, control)
    if reasons:
        return "inconclusive", reasons
    if verdict == "SURVIVED":
        if runinfo["failures"] != 0 or runinfo["bad"]:
            return "inconclusive", ["green-with-failing-cases"]
        return "survived", []
    if verdict == "INCONCLUSIVE":
        return "inconclusive", ["runner-inconclusive"]
    if verdict != "KILLED":
        return "inconclusive", [f"unknown-verdict:{verdict}"]
    # verdict == KILLED: red with the full denominator
    if not runinfo["bad"]:
        return "inconclusive", ["red-without-failing-cases"]
    if witnesses is None:
        return "accidental", ["declared-NONE"]
    hit = [label for label in witnesses if label in runinfo["bad"]]
    if hit:
        return "killed-on-witness", []
    return "accidental", ["no-declared-witness-failed"]


# -------------------------------------------------------------------- helpers

def load_declaration(evidence: Path) -> dict:
    path = evidence / DECLARATION_NAME
    if not path.is_file():
        raise Cannot(f"missing {path} — run `declare` first")
    try:
        return json.loads(read_text(path))
    except json.JSONDecodeError as exc:
        raise Cannot(f"unreadable {path}: {exc}") from exc


def verify_declared_digest(evidence: Path, declaration: dict) -> str:
    """Named refusal before any classification when declared.tsv was modified."""
    path = evidence / DECLARED_NAME
    if not path.is_file():
        raise Cannot(f"missing {path}")
    actual = sha256_file(path)
    committed = declaration.get("declared", {}).get("sha256")
    if actual != committed:
        raise Fail(f"TAMPER {DECLARED_NAME} sha256={actual} committed={committed}")
    return actual


def ensure_target_and_spec(evidence: Path, declaration: dict, kagi: Path) -> dict:
    inputs = declaration.get("inputs", {})
    target = evidence / TARGET_NAME
    spec = evidence / SPEC_NAME
    facts = {}

    expected_target = inputs.get("target", {}).get("sha256")
    rev = inputs.get("target", {}).get("rev")
    if target.is_file():
        actual = sha256_file(target)
        if actual != expected_target:
            raise Fail(f"TAMPER {TARGET_NAME} sha256={actual} committed={expected_target}")
    else:
        if not rev:
            raise Cannot(f"missing {TARGET_NAME} and no revision recorded")
        data = materialize_target(kagi, rev)
        actual = sha256_bytes(data)
        if actual != expected_target:
            raise Fail(f"materialized target sha256={actual} != committed={expected_target}")
        target.write_bytes(data)
    facts["target_sha256"] = actual

    expected_spec = inputs.get("spec", {}).get("sha256")
    if spec.is_file():
        actual = sha256_file(spec)
        if actual != expected_spec:
            raise Fail(f"TAMPER {SPEC_NAME} sha256={actual} committed={expected_spec}")
    else:
        actual = sha256_bytes(extract_spec(read_text(RUNNER)).encode("utf-8"))
        if actual != expected_spec:
            raise Fail(f"re-extracted spec sha256={actual} != committed={expected_spec}")
        spec.write_bytes(extract_spec(read_text(RUNNER)).encode("utf-8"))
    facts["spec_sha256"] = actual

    runner_sha = sha256_file(RUNNER)
    committed_runner = inputs.get("runner", {}).get("sha256")
    if runner_sha != committed_runner:
        raise Cannot(f"runner-drift tools/mutate-and-run.sh sha256={runner_sha} "
                     f"committed={committed_runner}")
    facts["runner_sha256"] = runner_sha

    pins = runner_pins(read_text(RUNNER))
    if pins["PIN_BASH"] != expected_target:
        raise Cannot(f"pin-mismatch PIN_BASH={pins['PIN_BASH']} "
                     f"declared-target={expected_target}")
    facts["pin_bash"] = pins["PIN_BASH"]
    facts["rev_bash"] = pins["REV_BASH"]
    return facts


def sweep_env() -> dict:
    env = git_clean_env()
    for name in SCRUB_ENV:
        env.pop(name, None)
    return env


def env_facts() -> dict:
    return {
        "scrubbed": ["GIT_*", *SCRUB_ENV],
        "the_janitor_on_path": shutil.which("the-janitor"),
        "sqlite3_on_path": shutil.which("sqlite3"),
        "path": os.environ.get("PATH", ""),
    }


def run_sweep(evidence: Path, rundir: Path, timeout: int, tail: int) -> dict:
    janitor = shutil.which("the-janitor")
    if janitor is not None:
        raise Cannot(f"the-janitor is on PATH ({janitor}) — refusing to run real "
                     f"op/custody probes; run on a host without it")
    rundir.mkdir(parents=True, exist_ok=False)
    argv = [
        "bash", str(RUNNER),
        "--target", str(evidence / TARGET_NAME),
        "--defects", str(evidence / SPEC_NAME),
        "--suite", SUITE,
        "--workdir", str(rundir),
        "--label", LABEL,
        "--timeout", str(timeout),
        "--tail", str(tail),
    ]
    proc = subprocess.run(argv, stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          env=sweep_env(), check=False)
    log = proc.stdout.decode("utf-8", "replace")
    (rundir / "cli.log").write_text(log, encoding="utf-8")
    (rundir / "cli.exit").write_text(f"{proc.returncode}\n", encoding="utf-8")
    return {
        "argv": argv,
        "exit": proc.returncode,
        "cli_log": f"{rundir.name}/cli.log",
        "cli_log_sha256": sha256_bytes(log.encode("utf-8")),
        "control_green": re.search(r"^CONTROL: GREEN ", log, re.M) is not None,
        "restore_ok": re.search(r"^MUTATE_RESTORE: OK ", log, re.M) is not None,
        "restore_line": next((l for l in log.splitlines()
                              if l.startswith("MUTATE_RESTORE: ")), None),
        "done_line": next((l for l in log.splitlines()
                           if l.startswith("MUTATE: ")), None),
    }


def collect_results(rundir: Path, declared: dict, control: dict) -> tuple:
    results = rundir / "results.tsv"
    if not results.is_file():
        raise Cannot(f"missing {results} — sweep did not produce a results table")
    lines = read_text_lossy(results).splitlines()
    header = "id\tverdict\texit\tduration-ms\tmutant-sha256\tdesc"
    if not lines or lines[0] != header:
        raise Cannot(f"{results}: unexpected header "
                     f"{lines[0] if lines else '<empty>'!r}")
    # control_record keeps the report-facing `skip_labels`; run_problems reads
    # the normalized `skip` view (same shape as parse_case_lines output).
    control = {"skip": control.get("skip", control.get("skip_labels", []))}
    known = [d[0] for d in DECLARED_WITNESSES]
    if set(declared) != set(known):
        raise Cannot("declared.tsv rows differ from the frozen DECLARED_WITNESSES ids")
    rows, seen = [], set()
    for lineno, raw in enumerate(lines, 1):
        if lineno == 1 or not raw.strip():
            continue
        fields = raw.split("\t")
        if len(fields) != 6:
            raise Cannot(f"results.tsv line {lineno}: expected 6 tab fields")
        ident, verdict, exit_code, dur_ms, mutant_sha, desc = fields
        if ident in seen:
            raise Cannot(f"results.tsv duplicate defect id {ident}")
        if ident not in known:
            raise Cannot(f"results.tsv unknown defect id {ident}")
        if ident not in declared:
            raise Cannot(f"declared.tsv has no row for defect {ident}")
        try:
            exit_int, dur_int = int(exit_code), int(dur_ms)
        except ValueError as exc:
            raise Cannot(f"results.tsv line {lineno}: non-integer field: {exc}") from exc
        expected_verdict = ("SURVIVED" if exit_int == 0 else
                            "INCONCLUSIVE" if exit_int in (124, 126, 127) else "KILLED")
        if verdict != expected_verdict:
            raise Fail(f"RESULTS {ident} verdict={verdict} but exit={exit_int} "
                       f"implies {expected_verdict}")
        mutant_path = rundir / f"mutant-{ident}.{TARGET_NAME}"
        if not mutant_path.is_file():
            raise Cannot(f"missing mutant artifact {mutant_path}")
        actual_mutant_sha = sha256_file(mutant_path)
        if actual_mutant_sha != mutant_sha:
            raise Fail(f"MUTANT {ident} sha256={actual_mutant_sha} "
                       f"results.tsv={mutant_sha}")
        log_path = rundir / "evidence" / f"{ident}.out"
        if not log_path.is_file():
            raise Cannot(f"missing raw log {log_path}")
        info = parse_case_lines(read_text_lossy(log_path))
        info["exit"] = exit_int
        witnesses = declared.get(ident)
        classification, reasons = classify(ident, verdict, info, control, witnesses)
        rows.append({
            "defect": ident,
            "desc": desc,
            "runner_verdict": verdict,
            "exit": exit_int,
            "duration_ms": dur_int,
            "mutant_sha256": mutant_sha,
            "declared_witness": list(witnesses) if witnesses else [],
            "declared_witness_none": witnesses is None,
            "failing_labels": info["bad"],
            "ok_labels": info["ok"],
            "skipped_labels": info["skip"],
            "denominator": info["total"],
            "failures": info["failures"],
            "selftest_line": info["selftest_line"],
            "exercised": len(info["ok"]) + len(info["bad"]),
            "skipped": len(info["skip"]),
            "classification": classification,
            "classification_reasons": reasons,
            "raw_log": f"{rundir.name}/evidence/{ident}.out",
            "raw_log_sha256": sha256_file(log_path),
        })
        seen.add(ident)
    missing = [ident for ident in known if ident not in seen]
    if missing:
        raise Cannot(f"results.tsv lacks declared defect(s): {', '.join(missing)}")
    if len(rows) != len(known):
        raise Cannot(f"results.tsv has {len(rows)} rows, expected {len(known)}")
    return rows, seen


def control_record(rundir: Path) -> dict:
    path = rundir / "evidence" / "control.out"
    if not path.is_file():
        raise Cannot(f"missing control log {path}")
    info = parse_case_lines(read_text_lossy(path))
    return {
        "exit": 0,
        "denominator": info["total"],
        "failures": info["failures"],
        "exercised": len(info["ok"]) + len(info["bad"]),
        "skipped": len(info["skip"]),
        "skip_labels": info["skip"],
        "ok_labels": info["ok"],
        "failing_labels": info["bad"],
        "numbers": info["numbers"],
        "selftest_line": info["selftest_line"],
        "selftest_terminal": info["selftest_terminal"],
        "raw_log": f"{rundir.name}/evidence/control.out",
        "raw_log_sha256": sha256_file(path),
    }


def control_problems(control: dict) -> list:
    view = {
        "ok": control["ok_labels"], "bad": control["failing_labels"],
        "skip": control["skip_labels"], "numbers": control["numbers"],
        "total": control["denominator"], "failures": control["failures"],
        "exit": control["exit"],
        "selftest_line": control["selftest_line"],
        "selftest_terminal": control["selftest_terminal"],
    }
    return run_problems(view, view)


def cannot_counts() -> dict:
    ids = [d[0] for d in DECLARED_WITNESSES]
    return {
        "killed_on_witness": 0, "accidental": 0, "survived": 0,
        "inconclusive": len(ids), "total": len(ids), "witness_classified": 0,
        "declared_none": [d[0] for d in DECLARED_WITNESSES if d[1] is None],
        "unresolved": ids,
    }


def counts(rows: list) -> dict:
    tally = {"killed_on_witness": 0, "accidental": 0, "survived": 0, "inconclusive": 0}
    for row in rows:
        tally[row["classification"].replace("-", "_")] += 1
    declared_none = [r["defect"] for r in rows if r["declared_witness_none"]]
    unresolved = [r["defect"] for r in rows if r["classification"] == "inconclusive"]
    tally["total"] = len(rows)
    tally["witness_classified"] = (tally["killed_on_witness"] + tally["accidental"]
                                   + tally["survived"])
    tally["declared_none"] = declared_none
    tally["unresolved"] = unresolved
    return tally


def write_json(path: Path, payload: dict) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=False) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def build_summary(evidence: Path, declaration: dict, declared_sha: str, facts: dict,
                  sweep: dict, control: dict, rows: list, status: str) -> dict:
    return {
        "study": "bash-witness-study",
        "seat": "BashWitness",
        "round": "round-12",
        "leg": LABEL,
        "generated_at": utc_stamp(),
        "status": status,
        "tool": {
            "path": str(Path(__file__).resolve()),
            "sha256": sha256_file(Path(__file__).resolve()),
        },
        "declaration": {
            "path": DECLARED_NAME,
            "sha256": declared_sha,
            "kind": declaration.get("kind"),
            "disclosure": declaration.get("disclosure"),
        },
        "inputs": declaration.get("inputs"),
        "suite": {
            "command": SUITE,
            "declared_total": DECLARED_TOTAL,
            "expected_skip_labels": list(EXPECTED_SKIP_LABELS),
        },
        "environment": env_facts(),
        "sweep": sweep,
        "control": control,
        "rows": rows,
        "counts": counts(rows),
        "classification_rule": (
            "killed-on-witness: full-denominator red with >=1 declared case failed; "
            "accidental: full-denominator red with none; survived: full-denominator "
            "green with zero failures; inconclusive: missing/odd denominator, "
            "unexpected or control-divergent skip labels, runner INCONCLUSIVE"
        ),
        "facts": facts,
    }


def manifest_files(root: Path) -> list:
    """Every regular file under root except the manifest itself and temp writes."""
    names = []
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(root).as_posix()
        if rel == MANIFEST_NAME or rel.endswith(".tmp"):
            continue
        names.append(rel)
    return names


def write_manifest(root: Path) -> dict:
    covered = manifest_files(root)
    manifest = {
        "created_at": utc_stamp(),
        "files": {name: sha256_file(root / name) for name in covered},
    }
    write_json(root / MANIFEST_NAME, manifest)
    return manifest


# ------------------------------------------------------------------- commands

def cmd_declare(args) -> int:
    evidence = Path(args.evidence)
    evidence.mkdir(parents=True, exist_ok=True)
    if (evidence / DECLARED_NAME).exists():
        raise Fail(f"{DECLARED_NAME} already exists — declarations are frozen; "
                   f"re-declaring requires a fresh evidence directory")
    runner_text = read_text(RUNNER)
    pins = runner_pins(runner_text)
    spec_text = extract_spec(runner_text)
    defects = parse_spec(spec_text)
    ids = [d["id"] for d in defects]
    if len(defects) != len(DECLARED_WITNESSES):
        raise Fail(f"spec has {len(defects)} defects, declaration has "
                   f"{len(DECLARED_WITNESSES)}")
    if ids != [d[0] for d in DECLARED_WITNESSES]:
        raise Fail(f"spec ids {ids} != declared ids "
                   f"{[d[0] for d in DECLARED_WITNESSES]}")

    data = materialize_target(Path(args.kagi), pins["REV_BASH"])
    target_sha = sha256_bytes(data)
    if target_sha != pins["PIN_BASH"]:
        raise Fail(f"materialized target sha256={target_sha} != PIN_BASH={pins['PIN_BASH']}")
    (evidence / TARGET_NAME).write_bytes(data)
    (evidence / SPEC_NAME).write_text(spec_text, encoding="utf-8")

    spec_sha = sha256_bytes(spec_text.encode("utf-8"))
    runner_sha = sha256_file(RUNNER)
    precheck = spec_precheck(defects, data.decode("utf-8"))
    meta = {"target_sha256": target_sha, "spec_sha256": spec_sha,
            "runner_sha256": runner_sha, "rev": pins["REV_BASH"]}
    tsv = declared_tsv_text(meta)
    (evidence / DECLARED_NAME).write_text(tsv, encoding="utf-8")
    declared_sha = sha256_bytes(tsv.encode("utf-8"))

    declaration = {
        "study": "bash-witness-study",
        "seat": "BashWitness",
        "round": "round-12",
        "created_at": utc_stamp(),
        "kind": "declared-witness mapping (not a blind preregistration)",
        "disclosure": DISCLOSURE,
        "declared": {
            "path": DECLARED_NAME,
            "sha256": declared_sha,
            "rows": len(DECLARED_WITNESSES),
            "none_rows": [d[0] for d in DECLARED_WITNESSES if d[1] is None],
        },
        "inputs": {
            "target": {
                "path": TARGET_NAME,
                "sha256": target_sha,
                "source": f"git -C {Path(args.kagi)} show {pins['REV_BASH']}:{TARGET_GIT_PATH}",
                "rev": pins["REV_BASH"],
                "pin": pins["PIN_BASH"],
            },
            "spec": {
                "path": SPEC_NAME,
                "sha256": spec_sha,
                "source": f"heredoc of {RUNNER} (lines around the "
                          f"bash-surface-census.spec marker), defects={len(defects)}",
                "defects": ids,
            },
            "runner": {"path": str(RUNNER), "sha256": runner_sha},
            "suite": {"command": SUITE, "declared_total": DECLARED_TOTAL,
                      "expected_skip_labels": list(EXPECTED_SKIP_LABELS)},
        },
        "spec_precheck": precheck,
        "environment_at_declare": env_facts(),
    }
    write_json(evidence / DECLARATION_NAME, declaration)
    print(f"WITNESS_DECLARE: wrote {evidence / DECLARED_NAME}")
    print(f"WITNESS_DECLARE: declared.tsv sha256={declared_sha} rows={len(DECLARED_WITNESSES)}")
    print(f"WITNESS_DECLARE: target sha256={target_sha} (pin {pins['PIN_BASH']})")
    print(f"WITNESS_DECLARE: spec sha256={spec_sha} defects={len(defects)}")
    print(f"WITNESS_DECLARE: runner sha256={runner_sha}")
    print(f"WITNESS_DECLARE: spec precheck all_unique={precheck['all_unique']} "
          f"non_unique={precheck['non_unique']}")
    print("WITNESS_DECLARE: declaration.json sha256="
          f"{sha256_file(evidence / DECLARATION_NAME)}")
    return EXIT_OK


def _prepare(args) -> tuple:
    evidence = Path(args.evidence)
    declaration = load_declaration(evidence)
    declared_sha = verify_declared_digest(evidence, declaration)
    declared = parse_declared_tsv(read_text(evidence / DECLARED_NAME))
    facts = ensure_target_and_spec(evidence, declaration, Path(args.kagi))
    return evidence, declaration, declared_sha, declared, facts


def _cannot_summary(evidence: Path, declaration: dict, declared_sha: str, facts: dict,
                    sweep: dict, control: dict, problems: list, note: str,
                    outdir: Path | None = None) -> int:
    outdir = outdir or evidence
    summary = build_summary(evidence, declaration, declared_sha, facts, sweep, control,
                            [], "could-not-evaluate")
    summary["counts"] = cannot_counts()
    summary["unresolved_reasons"] = problems
    write_json(outdir / SUMMARY_NAME, summary)
    write_manifest(outdir)
    print(f"WITNESS_RUN: could-not-evaluate — {note}: {', '.join(problems)}")
    print(f"WITNESS_RUN: summary {outdir / SUMMARY_NAME}")
    return EXIT_CANNOT


def _execute_sweep(evidence: Path, declaration: dict, declared_sha: str, declared: dict,
                   facts: dict, rundir: Path, args,
                   outdir: Path | None = None) -> int:
    outdir = outdir or evidence
    sweep = run_sweep(evidence, rundir, args.timeout, args.tail)
    if sweep["exit"] not in (0, 1):
        return _cannot_summary(evidence, declaration, declared_sha, facts, sweep,
                               {"exit": sweep["exit"], "status": "runner-refused"},
                               [f"runner-exit={sweep['exit']}"],
                               "runner did not complete (setup/usage refusal)",
                               outdir=outdir)
    done = sweep.get("done_line") or ""
    if not (done.startswith("MUTATE: DONE ") or done.startswith("MUTATE: DEGRADED ")):
        return _cannot_summary(evidence, declaration, declared_sha, facts, sweep,
                               {"exit": sweep["exit"], "status": "done-line-missing"},
                               ["done-line-missing"],
                               f"runner verdict line missing: {done or '<none>'}",
                               outdir=outdir)
    if (sweep["exit"] == 0) != done.startswith("MUTATE: DONE "):
        return _cannot_summary(evidence, declaration, declared_sha, facts, sweep,
                               {"exit": sweep["exit"], "status": "done-line-exit-mismatch"},
                               ["done-line-exit-mismatch"],
                               f"exit={sweep['exit']} with {done}", outdir=outdir)
    if not sweep["control_green"]:
        return _cannot_summary(evidence, declaration, declared_sha, facts, sweep,
                               {"exit": None, "status": "control-not-green"},
                               ["control-not-green"], "control not green",
                               outdir=outdir)
    control = control_record(rundir)
    problems = control_problems(control)
    if problems:
        return _cannot_summary(evidence, declaration, declared_sha, facts, sweep,
                               control, problems, "control incomplete", outdir=outdir)
    expected_restore = (f"MUTATE_RESTORE: OK (target-sha256 "
                        f"before={facts['target_sha256']} "
                        f"after={facts['target_sha256']} ")
    restore = sweep.get("restore_line") or ""
    if not restore.startswith(expected_restore):
        return _cannot_summary(evidence, declaration, declared_sha, facts, sweep,
                               control, ["restore-line-mismatch"],
                               f"restore proof missing/mismatched: "
                               f"{restore or '<none>'}", outdir=outdir)
    rows, _ = collect_results(rundir, declared, control)
    status = "degraded" if any(r["classification"] == "inconclusive" for r in rows) else "complete"
    summary = build_summary(evidence, declaration, declared_sha, facts, sweep, control,
                            rows, status)
    write_json(outdir / SUMMARY_NAME, summary)
    write_manifest(outdir)
    tally = summary["counts"]
    print(f"WITNESS_RUN: {status} — killed_on_witness={tally['killed_on_witness']} "
          f"accidental={tally['accidental']} survived={tally['survived']} "
          f"inconclusive={tally['inconclusive']} total={tally['total']}")
    print(f"WITNESS_RUN: control denominator={control['denominator']} "
          f"exercised={control['exercised']} skipped={control['skipped']}")
    print(f"WITNESS_RUN: summary {outdir / SUMMARY_NAME}")
    return EXIT_FAIL if status == "degraded" else EXIT_OK


def cmd_run(args) -> int:
    evidence, declaration, declared_sha, declared, facts = _prepare(args)
    rundir = evidence / SWEEP_DIR
    if rundir.exists():
        raise Fail(f"{rundir} exists — use `rerun` for a fresh sweep")
    return _execute_sweep(evidence, declaration, declared_sha, declared, facts, rundir, args)


def cmd_rerun(args) -> int:
    evidence, declaration, declared_sha, declared, facts = _prepare(args)
    committed_path = evidence / SUMMARY_NAME
    prior = json.loads(read_text(committed_path)) if committed_path.is_file() else None
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    rundir = evidence / f"rerun-{stamp}"
    if rundir.exists():
        raise Fail(f"{rundir} exists")
    rc = _execute_sweep(evidence, declaration, declared_sha, declared, facts, rundir,
                        args, outdir=rundir)
    fresh_path = rundir / SUMMARY_NAME
    if not fresh_path.is_file():
        print("WITNESS_RERUN: no fresh summary; committed summary preserved")
        return rc
    # The rerun artifacts extend the evidence set; re-anchor the full manifest.
    write_manifest(evidence)
    fresh = json.loads(read_text(fresh_path))
    print(f"WITNESS_RERUN: committed summary preserved at {committed_path}")
    if prior is None:
        print("WITNESS_RERUN: no committed summary to compare; fresh sweep retained")
        return rc
    prior_map = {r["defect"]: r["classification"] for r in prior.get("rows", [])}
    fresh_map = {r["defect"]: r["classification"] for r in fresh.get("rows", [])}
    domains = sorted(set(prior_map) | set(fresh_map))
    agree = [d for d in domains if prior_map.get(d) == fresh_map.get(d)]
    deviations = [d for d in domains if prior_map.get(d) != fresh_map.get(d)]
    print(f"WITNESS_RERUN: agreement {len(agree)}/{len(domains)} rows; "
          f"deviations={deviations or 'none'}")
    if deviations and rc == EXIT_OK:
        rc = EXIT_FAIL
    return rc


def cmd_count(args) -> int:
    evidence = Path(args.evidence)
    declaration = load_declaration(evidence)
    declared_sha = verify_declared_digest(evidence, declaration)
    declared = parse_declared_tsv(read_text(evidence / DECLARED_NAME))
    if declared != declared_expected():
        raise Fail("DECLARED mapping differs from the frozen DECLARED_WITNESSES rows")
    summary_path = evidence / SUMMARY_NAME
    if not summary_path.is_file():
        raise Cannot(f"missing {summary_path} — run the sweep first")
    try:
        summary = json.loads(read_text(summary_path))
    except json.JSONDecodeError as exc:
        raise Cannot(f"unreadable {summary_path}: {exc}") from exc
    if summary.get("declaration", {}).get("sha256") != declared_sha:
        raise Fail(f"TAMPER {SUMMARY_NAME} declaration-linkage "
                   f"sha256={summary.get('declaration', {}).get('sha256')} "
                   f"declared={declared_sha}")
    status = summary.get("status")
    if status == "could-not-evaluate":
        reasons = summary.get("unresolved_reasons", [])
        print(f"count\tcould-not-evaluate\t{', '.join(reasons) or '-'}")
        return EXIT_CANNOT
    rundir = evidence / SWEEP_DIR
    control = control_record(rundir)
    problems = control_problems(control)
    if problems:
        raise Cannot("control incomplete: " + ", ".join(problems))
    rows, _ = collect_results(rundir, declared, control)
    stored_rows = {r.get("defect"): r for r in summary.get("rows", [])}
    fresh_rows = {r["defect"]: r for r in rows}
    if set(stored_rows) != set(fresh_rows):
        raise Fail(f"COUNT summary/raw mismatch row ids: stored={sorted(stored_rows)} "
                   f"recomputed={sorted(fresh_rows)}")
    compare = ("runner_verdict", "exit", "duration_ms", "mutant_sha256",
               "declared_witness", "declared_witness_none", "failing_labels",
               "ok_labels", "skipped_labels", "denominator", "failures",
               "selftest_line", "exercised", "skipped", "classification",
               "classification_reasons", "raw_log", "raw_log_sha256")
    for ident in sorted(fresh_rows):
        for key in compare:
            stored = stored_rows[ident].get(key)
            fresh = fresh_rows[ident].get(key)
            if stored != fresh:
                raise Fail(f"COUNT summary/raw mismatch {ident}.{key}: "
                           f"stored={stored!r} recomputed={fresh!r}")
    tally = counts(rows)
    stored_counts = summary.get("counts", {})
    for key in ("killed_on_witness", "accidental", "survived", "inconclusive",
                "total", "witness_classified", "declared_none", "unresolved"):
        if stored_counts.get(key) != tally[key]:
            raise Fail(f"COUNT summary/raw mismatch counts.{key}: "
                       f"stored={stored_counts.get(key)!r} recomputed={tally[key]!r}")
    expected_status = "degraded" if tally["unresolved"] else "complete"
    if status != expected_status:
        raise Fail(f"COUNT summary/raw mismatch status: stored={status!r} "
                   f"recomputed={expected_status!r}")
    print(f"declared\t{declared_sha}\t{evidence / DECLARED_NAME}")
    print(f"control\texit={control['exit']}\tdenominator={control['denominator']}"
          f"\texercised={control['exercised']}\tskipped={control['skipped']}"
          f"\tskip={','.join(control['skip_labels']) or '-'}")
    for row in rows:
        declared_w = ",".join(row["declared_witness"]) if row["declared_witness"] else "NONE"
        failed = ",".join(row["failing_labels"]) or "-"
        print(f"row\t{row['defect']}\t{row['runner_verdict']}\texit={row['exit']}"
              f"\tdeclared={declared_w}\tfailed={failed}"
              f"\tdenominator={row['denominator']}\texercised={row['exercised']}"
              f"\tskipped={row['skipped']}\tclass={row['classification']}")
    print(f"counts\tkilled_on_witness={tally['killed_on_witness']}"
          f"\taccidental={tally['accidental']}\tsurvived={tally['survived']}"
          f"\tinconclusive={tally['inconclusive']}\ttotal={tally['total']}"
          f"\twitness_classified={tally['witness_classified']}")
    print(f"declared_none\t{','.join(tally['declared_none']) or 'none'}")
    print(f"unresolved\t{','.join(tally['unresolved']) or 'none'}")
    return EXIT_FAIL if tally["unresolved"] else EXIT_OK


def cmd_check(args) -> int:
    evidence = Path(args.evidence)
    declaration = load_declaration(evidence)
    problems = []
    covered = set()
    declared_sha = verify_declared_digest(evidence, declaration)
    covered.add(DECLARED_NAME)
    declared = parse_declared_tsv(read_text(evidence / DECLARED_NAME))
    if declared != declared_expected():
        problems.append("DECLARED mapping differs from the frozen DECLARED_WITNESSES rows")
    inputs = declaration.get("inputs", {})
    for key, name in (("target", TARGET_NAME), ("spec", SPEC_NAME)):
        path = evidence / name
        if not path.is_file():
            raise Cannot(f"missing {path}")
        actual = sha256_file(path)
        committed = inputs.get(key, {}).get("sha256")
        covered.add(name)
        if actual != committed:
            problems.append(f"TAMPER {name} sha256={actual} committed={committed}")
    try:
        runner_sha = sha256_file(RUNNER)
    except OSError as exc:
        runner_sha = None
        problems.append(f"MISSING runner {RUNNER}: {exc}")
    committed_runner = inputs.get("runner", {}).get("sha256")
    covered.add("tools/mutate-and-run.sh")
    if runner_sha is not None and runner_sha != committed_runner:
        problems.append(f"DRIFT tools/mutate-and-run.sh sha256={runner_sha} "
                        f"committed={committed_runner}")
    summary_path = evidence / SUMMARY_NAME
    summary = None
    if summary_path.is_file():
        try:
            summary = json.loads(read_text(summary_path))
        except json.JSONDecodeError as exc:
            raise Cannot(f"unreadable {summary_path}: {exc}") from exc
        covered.add(SUMMARY_NAME)
        if summary.get("declaration", {}).get("sha256") != declared_sha:
            problems.append(f"TAMPER {SUMMARY_NAME} declaration-linkage "
                            f"sha256={summary.get('declaration', {}).get('sha256')} "
                            f"declared={declared_sha}")
    else:
        problems.append(f"MISSING {SUMMARY_NAME}")
    manifest_path = evidence / MANIFEST_NAME
    if not manifest_path.is_file():
        raise Cannot(f"missing {manifest_path} — the full manifest is mandatory")
    try:
        manifest = json.loads(read_text(manifest_path))
    except json.JSONDecodeError as exc:
        raise Cannot(f"unreadable {manifest_path}: {exc}") from exc
    listed = manifest.get("files")
    if not isinstance(listed, dict) or not listed:
        raise Fail(f"{MANIFEST_NAME}: files map is empty or malformed")
    required = [DECLARATION_NAME, DECLARED_NAME, TARGET_NAME, SPEC_NAME, SUMMARY_NAME]
    if summary is not None and summary.get("status") in ("complete", "degraded"):
        required.extend([f"{SWEEP_DIR}/results.tsv",
                         f"{SWEEP_DIR}/evidence/control.out",
                         f"{SWEEP_DIR}/cli.log", f"{SWEEP_DIR}/cli.exit"])
        required.extend(f"{SWEEP_DIR}/evidence/{ident}.out" for ident in declared)
    missing_required = [name for name in required if name not in listed]
    if missing_required:
        problems.append("MANIFEST incomplete (missing required): "
                        + ", ".join(missing_required))
    present = set(manifest_files(evidence))
    for name in sorted(present - set(listed)):
        problems.append(f"UNLISTED {name}")
    root = evidence.resolve()
    for name in sorted(listed):
        digest = listed[name]
        if not isinstance(name, str) or Path(name).is_absolute():
            problems.append(f"UNSAFE {name!r}")
            continue
        path = evidence / name
        try:
            path.resolve().relative_to(root)
        except (ValueError, OSError):
            problems.append(f"UNSAFE {name}")
            continue
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            problems.append(f"MALFORMED {name} sha256={digest!r}")
            continue
        if not path.is_file():
            problems.append(f"MISSING {name} (manifest sha256={digest})")
            continue
        actual = sha256_file(path)
        if actual != digest:
            problems.append(f"TAMPER {name} sha256={actual} committed={digest}")
        covered.add(name)
    if problems:
        for problem in problems:
            print(f"WITNESS_CHECK: {problem}")
        print(f"WITNESS_CHECK: FAIL ({len(problems)} problems; "
              f"{len(covered)} files covered)")
        return EXIT_FAIL
    print(f"WITNESS_CHECK: CLEAN (declared.tsv sha256={declared_sha}, "
          f"{len(covered)} files covered, {len(listed)} manifest entries)")
    return EXIT_OK


def cmd_selftest(args) -> int:
    cases = failed = 0

    def check(name: str, ok: bool) -> None:
        nonlocal cases, failed
        cases += 1
        if ok:
            print(f"  check {name:<44} ok")
        else:
            failed += 1
            print(f"  check {name:<44} FAIL")

    private_root = Path(tempfile.mkdtemp(
        prefix="bash-witness-selftest-private.", dir="/tmp"))
    assert private_root.resolve(strict=True) == private_root
    root = None
    try:
        root = Path(tempfile.mkdtemp(
            prefix="bash-witness-selftest.", dir=private_root))
        assert root.resolve(strict=True) == root
        # A hostile inherited Git selection must not redirect either child Git
        # invocation to the canary repository. Both launch paths are exercised
        # with GIT_DIR and GIT_WORK_TREE exported and distinct fixture repos.
        def fixture_repo(name: str, contents: bytes) -> tuple:
            repo = root / name
            repo.mkdir()
            target = repo / TARGET_GIT_PATH
            target.parent.mkdir(parents=True)
            target.write_bytes(contents)
            safe_env = git_clean_env()
            subprocess.run(
                ["git", "-c", "core.hooksPath=/dev/null",
                 "-C", str(repo), "init", "--quiet"],
                check=True, env=safe_env,
                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            subprocess.run(
                ["git", "-c", "core.hooksPath=/dev/null",
                 "-C", str(repo), "add", "--", TARGET_GIT_PATH],
                check=True, env=safe_env,
                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            subprocess.run(
                ["git", "-c", "core.hooksPath=/dev/null",
                 "-C", str(repo), "-c", "user.name=fixture",
                 "-c", "user.email=fixture@example.invalid", "commit",
                 "--quiet", "-m", "fixture"],
                check=True, env=safe_env,
                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            revision = subprocess.run(
                ["git", "-C", str(repo), "rev-parse", "HEAD"],
                check=True, capture_output=True, env=safe_env,
            ).stdout.decode("ascii").strip()
            return repo, revision

        materialize_ok = sweep_ok = False
        saved_runner = RUNNER
        saved_which = shutil.which
        saved_env = {
            name: os.environ.get(name)
            for name in ("GIT_DIR", "GIT_WORK_TREE", "WITNESS_CANARY_REPO")
        }
        try:
            fixture, revision = fixture_repo(
                "git-fixture", b"fixture target bytes\n")
            canary, _ = fixture_repo("git-canary", b"canary target bytes\n")
            probe_runner = root / "git-canary-runner.sh"
            probe_runner.write_text(
                "#!/bin/bash\n"
                "set -eu\n"
                "git -C \"$WITNESS_CANARY_REPO\" rev-parse --show-toplevel\n",
                encoding="utf-8")
            os.environ["GIT_DIR"] = str(canary / ".git")
            os.environ["GIT_WORK_TREE"] = str(canary)
            os.environ["WITNESS_CANARY_REPO"] = str(fixture)

            try:
                materialize_ok = (
                    materialize_target(fixture, revision)
                    == b"fixture target bytes\n")
            except (Cannot, OSError, subprocess.SubprocessError):
                materialize_ok = False

            globals()["RUNNER"] = probe_runner
            shutil.which = lambda name: None if name == "the-janitor" else saved_which(name)
            try:
                sweep = run_sweep(root / "canary-evidence",
                                  root / "canary-sweep", 30, 4)
                sweep_ok = (
                    sweep["exit"] == 0
                    and str(fixture) in
                    (root / "canary-sweep" / "cli.log").read_text(encoding="utf-8")
                    and str(canary) not in
                    (root / "canary-sweep" / "cli.log").read_text(encoding="utf-8")
                )
            except (Cannot, OSError, subprocess.SubprocessError):
                sweep_ok = False
        except (OSError, subprocess.SubprocessError):
            materialize_ok = sweep_ok = False
        finally:
            globals()["RUNNER"] = saved_runner
            shutil.which = saved_which
            for name, value in saved_env.items():
                if value is None:
                    os.environ.pop(name, None)
                else:
                    os.environ[name] = value
        check("GIT_DIR/GIT_WORK_TREE cannot redirect materialization",
              materialize_ok)
        check("GIT_DIR/GIT_WORK_TREE cannot redirect sweep",
              sweep_ok)

        # spec extraction + parse on a synthetic runner
        runner = (
            "#!/bin/bash\n"
            "PIN_BASH=" + "a" * 64 + "\n"
            "REV_BASH=" + "b" * 40 + "\n"
            '  cat >"$d/bash-surface-census.spec" <<\'EOT\'\n'
            "@defect X1 | target.sh:10\n"
            "@old foo\n"
            "@new bar\n"
            "EOT\n"
            "  cat >\"$d/other.spec\" <<'EOT'\n@defect Z | z\n@old z\n@new y\nEOT\n"
        )
        spec = extract_spec(runner)
        check("extract_spec picks the census heredoc",
              spec == "@defect X1 | target.sh:10\n@old foo\n@new bar\n")
        defects = parse_spec(spec)
        check("parse_spec id/desc/literals",
              defects == [{"id": "X1", "desc": "target.sh:10", "old": "foo", "new": "bar"}])
        check("runner_pins reads both constants",
              runner_pins(runner) == {"PIN_BASH": "a" * 64, "REV_BASH": "b" * 40})
        short_pin = runner.replace("PIN_BASH=" + "a" * 64, "PIN_BASH=" + "a" * 40)
        try:
            runner_pins(short_pin)
            check("runner_pins refuses a short PIN_BASH", False)
        except Cannot as exc:
            check("runner_pins refuses a short PIN_BASH with a named error",
                  "PIN_BASH" in str(exc))
        check("unescape maps \\n", unescape("a\\nb", "t") == "a\nb")
        check("spec_precheck flags a non-unique literal",
              spec_precheck([{"id": "X", "old": "o", "new": ""}], "foo")["all_unique"] is False)

        catalog = EXPECTED_CASE_LABELS

        def synth_log(bad=(), skip=EXPECTED_SKIP_LABELS, omit=(), total=16,
                      summary=None):
            lines = []
            for number, name in enumerate(catalog, 1):
                if number > total or number in omit:
                    continue
                if name in skip:
                    lines.append(f"skip-case {number:02d} {name:<34} "
                                 f"substrate-absent (handler not on PATH)")
                elif name in bad:
                    lines.append(f"bad-case {number:02d} {name:<34} want exit=0 "
                                 f"token=SURFACE OK got exit=1")
                    lines.append("    | diagnostic dump: ok-case 99 nested, not a label")
                else:
                    lines.append(f"ok-case  {number:02d} {name:<34} exit=0")
            if summary is None:
                summary = (f"SELFTEST: FAIL ({len(bad)}/{total} cases)" if bad
                           else f"SELFTEST: PASS ({total} cases)")
            if summary:
                lines.append(summary)
            return "\n".join(lines) + "\n"

        control_info = parse_case_lines(synth_log())
        control = {"skip": control_info["skip"]}
        check("control log: 14 exercised + 2 expected skips + terminal 16",
              control_info["skip"] == list(EXPECTED_SKIP_LABELS)
              and len(control_info["ok"]) == 14 and control_info["total"] == 16
              and control_info["selftest_terminal"]
              and control_problems({
                  "ok_labels": control_info["ok"], "failing_labels": control_info["bad"],
                  "skip_labels": control_info["skip"], "numbers": control_info["numbers"],
                  "denominator": control_info["total"], "failures": control_info["failures"],
                  "exit": 0,
                  "selftest_line": control_info["selftest_line"],
                  "selftest_terminal": control_info["selftest_terminal"]}) == [])
        red = parse_case_lines(synth_log(bad=("clean",)))
        check("dump lines never count as labels",
              red["bad"] == ["clean"] and len(red["ok"]) == 13)
        check("killed-on-witness when a declared case fails",
              classify("B", "KILLED", red, control, ("clean",)) == ("killed-on-witness", []))
        check("accidental when no declared case fails",
              classify("B", "KILLED", parse_case_lines(synth_log(bad=("mode-drift",))),
                       control, ("clean",))[0] == "accidental")
        check("declared NONE red is accidental",
              classify("B", "KILLED", red, control, None)[0] == "accidental")
        green = parse_case_lines(synth_log())
        check("green with full denominator survives",
              classify("B", "SURVIVED", green, control, ("clean",)) == ("survived", []))
        check("no SELFTEST line is inconclusive",
              classify("B", "KILLED",
                       parse_case_lines(synth_log(bad=("clean",), summary="")),
                       control, ("clean",))[0] == "inconclusive")
        check("non-terminal SELFTEST line is inconclusive",
              classify("B", "KILLED",
                       parse_case_lines(synth_log(bad=("clean",)) + "trailing noise\n"),
                       control, ("clean",))[0] == "inconclusive")
        check("odd denominator is inconclusive",
              classify("B", "KILLED",
                       parse_case_lines(synth_log(bad=("clean",), total=15)),
                       control, ("clean",))[0] == "inconclusive")
        check("incomplete numbering is inconclusive",
              classify("B", "KILLED",
                       parse_case_lines(synth_log(bad=("clean",), omit=(7,))),
                       control, ("clean",))[0] == "inconclusive")
        check("unexpected skip label is inconclusive",
              classify("B", "KILLED",
                       parse_case_lines(synth_log(bad=("clean",),
                                                  skip=("mode-drift", "verbs-sandboxed"))),
                       control, ("clean",))[0] == "inconclusive")
        check("green with failing cases is inconclusive",
              classify("B", "SURVIVED",
                       parse_case_lines(synth_log(bad=("clean",),
                                                  summary="SELFTEST: PASS (16 cases)")),
                       control, ("clean",))[0] == "inconclusive")
        check("runner INCONCLUSIVE is inconclusive",
              classify("B", "INCONCLUSIVE", red, control, ("clean",))[0] == "inconclusive")
        try:
            parse_spec("@defect X | a\n@old o\n@new n\n"
                       "@defect X | b\n@old p\n@new q\n")
            check("duplicate spec id refuses", False)
        except Cannot as exc:
            check("duplicate spec id refuses", "duplicate" in str(exc))
        no_den = parse_case_lines(synth_log(bad=("clean",),
                                            summary="SELFTEST: FAIL (1 cases)"))
        check("FAIL without denominator is inconclusive, not a crash",
              no_den["total"] is None
              and classify("B", "KILLED", no_den, control, ("clean",))[0] == "inconclusive")
        check("unknown verdict is inconclusive",
              classify("B", "FLIPPED", red, control, ("clean",))[0] == "inconclusive")
        dup_log = synth_log().replace("SELFTEST: PASS",
                                      "bad-case 01 clean\nSELFTEST: PASS")
        dup_info = parse_case_lines(dup_log)
        check("duplicate case label is inconclusive",
              "duplicate-case-label:clean" in run_problems(dup_info, control)
              and classify("B", "KILLED", dup_info, control, ("clean",))[0]
              == "inconclusive")
        pass_red = parse_case_lines(synth_log(bad=("clean",),
                                              summary="SELFTEST: PASS (16 cases)"))
        check("PASS summary with a bad case is inconclusive",
              classify("B", "KILLED", pass_red, control, ("clean",))[0]
              == "inconclusive")
        red_exit0 = dict(red)
        red_exit0["exit"] = 0
        check("KILLED with exit 0 is inconclusive",
              classify("B", "KILLED", red_exit0, control, ("clean",))[0]
              == "inconclusive")
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                build_parser().parse_args(["no-such-mode"])
            check("usage error exits 64", False)
        except SystemExit as exc:
            check("usage error exits 64", exc.code == EXIT_USAGE)

        # declared.tsv round-trip + tamper refusal on a synthetic evidence dir
        evidence = root / "evidence"
        evidence.mkdir()
        tsv = declared_tsv_text({"target_sha256": "a" * 64, "spec_sha256": "b" * 64,
                                 "runner_sha256": "c" * 64, "rev": "d" * 64})
        (evidence / DECLARED_NAME).write_text(tsv, encoding="utf-8")
        mapping = parse_declared_tsv(tsv)
        check("declared.tsv round-trip keeps NONE rows",
              mapping.get("B5") is None and mapping.get("B1") == ("undeclared-file",))
        digest = sha256_bytes(tsv.encode("utf-8"))
        declaration = {"declared": {"sha256": digest}}
        check("untampered declared.tsv verifies",
              verify_declared_digest(evidence, declaration) == digest)
        (evidence / DECLARED_NAME).write_text(tsv + "# planted\n", encoding="utf-8")
        try:
            verify_declared_digest(evidence, declaration)
            check("planted tamper refuses", False)
        except Fail as exc:
            check("planted tamper refuses with a named error",
                  "TAMPER declared.tsv" in str(exc))

        # result-table re-evaluation fixtures
        def build_sweep(base: Path):
            ev = base / "evidence"
            ev.mkdir(parents=True, exist_ok=False)
            (ev / "control.out").write_text(synth_log(), encoding="utf-8")
            rows = ["id\tverdict\texit\tduration-ms\tmutant-sha256\tdesc"]
            for ident in declared_expected():
                mutant = base / f"mutant-{ident}.{TARGET_NAME}"
                mutant.write_text(f"mutant {ident}\n", encoding="utf-8")
                (ev / f"{ident}.out").write_text(synth_log(), encoding="utf-8")
                rows.append(f"{ident}\tSURVIVED\t0\t1\t{sha256_file(mutant)}\t"
                            f"{ident} desc")
            (base / "results.tsv").write_text("\n".join(rows) + "\n", encoding="utf-8")
            return base, control_record(base), rows

        srd, sctl, srows = build_sweep(root / "sweep-fixture")
        frows, _ = collect_results(srd, declared_expected(), sctl)
        check("collect_results recomputes ten survived rows",
              len(frows) == 10
              and all(r["classification"] == "survived" for r in frows))

        def write_rows(lines):
            (srd / "results.tsv").write_text("\n".join(lines) + "\n",
                                             encoding="utf-8")

        write_rows(srows + [srows[1]])
        try:
            collect_results(srd, declared_expected(), sctl)
            check("duplicate result id refuses", False)
        except Cannot as exc:
            check("duplicate result id refuses", "duplicate" in str(exc))
        write_rows(srows)
        unknown = list(srows)
        fields = unknown[-1].split("\t")
        fields[0] = "Z9"
        unknown[-1] = "\t".join(fields)
        write_rows(unknown)
        try:
            collect_results(srd, declared_expected(), sctl)
            check("unknown result id refuses", False)
        except Cannot as exc:
            check("unknown result id refuses", "unknown" in str(exc))
        write_rows(srows)
        flipped = list(srows)
        fields = flipped[1].split("\t")
        fields[1] = "KILLED"
        flipped[1] = "\t".join(fields)
        write_rows(flipped)
        try:
            collect_results(srd, declared_expected(), sctl)
            check("verdict/exit mismatch refuses", False)
        except Fail as exc:
            check("verdict/exit mismatch refuses", "verdict" in str(exc))
        write_rows(srows)
        (srd / f"mutant-B1.{TARGET_NAME}").write_text("tampered\n", encoding="utf-8")
        try:
            collect_results(srd, declared_expected(), sctl)
            check("mutant digest mismatch refuses", False)
        except Fail as exc:
            check("mutant digest mismatch refuses", "MUTANT B1" in str(exc))

        # full-manifest check fixture
        cev = root / "check-evidence"
        cev.mkdir()
        ctsv = declared_tsv_text({"target_sha256": "a" * 64,
                                  "spec_sha256": "b" * 64,
                                  "runner_sha256": "c" * 64,
                                  "rev": "d" * 40})
        (cev / DECLARED_NAME).write_text(ctsv, encoding="utf-8")
        cdigest = sha256_bytes(ctsv.encode("utf-8"))
        ctarget = b"#!/bin/bash\nexit 0\n"
        cspec = b"@defect B1 | x\n@old o\n@new n\n"
        (cev / TARGET_NAME).write_bytes(ctarget)
        (cev / SPEC_NAME).write_bytes(cspec)
        write_json(cev / DECLARATION_NAME, {
            "declared": {"sha256": cdigest},
            "inputs": {
                "target": {"sha256": sha256_bytes(ctarget)},
                "spec": {"sha256": sha256_bytes(cspec)},
                "runner": {"sha256": sha256_file(RUNNER)},
            },
        })
        write_json(cev / SUMMARY_NAME, {
            "status": "could-not-evaluate",
            "declaration": {"sha256": cdigest},
            "unresolved_reasons": ["fixture"],
            "counts": cannot_counts(),
            "rows": [],
        })
        write_manifest(cev)
        cns = argparse.Namespace(evidence=str(cev))

        def run_check():
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                rc = cmd_check(cns)
            return rc, buf.getvalue()

        crc, cout = run_check()
        check("check CLEAN on a full-manifest fixture",
              crc == EXIT_OK and "CLEAN" in cout)
        (cev / MANIFEST_NAME).unlink()
        try:
            run_check()
            check("missing manifest refuses", False)
        except Cannot as exc:
            check("missing manifest refuses", "mandatory" in str(exc))
        write_manifest(cev)
        manifest = json.loads(read_text(cev / MANIFEST_NAME))
        del manifest["files"][SUMMARY_NAME]
        write_json(cev / MANIFEST_NAME, manifest)
        crc, cout = run_check()
        check("pruned manifest is not CLEAN",
              crc == EXIT_FAIL and "MANIFEST incomplete" in cout
              and "UNLISTED summary.json" in cout)
        write_manifest(cev)
        (cev / SUMMARY_NAME).write_text(
            (cev / SUMMARY_NAME).read_text(encoding="utf-8") + " ",
            encoding="utf-8")
        crc, cout = run_check()
        check("summary tamper is detected",
              crc == EXIT_FAIL and "TAMPER summary.json" in cout)

        # count re-evaluation fixture
        qev = root / "count-evidence"
        qev.mkdir()
        qtsv = declared_tsv_text({"target_sha256": "a" * 64,
                                  "spec_sha256": "b" * 64,
                                  "runner_sha256": "c" * 64,
                                  "rev": "d" * 40})
        (qev / DECLARED_NAME).write_text(qtsv, encoding="utf-8")
        qdigest = sha256_bytes(qtsv.encode("utf-8"))
        write_json(qev / DECLARATION_NAME, {
            "declared": {"sha256": qdigest},
            "inputs": {},
        })
        qsweep, qctl, _ = build_sweep(qev / SWEEP_DIR)
        qrows, _ = collect_results(qsweep, declared_expected(), qctl)
        qsummary = build_summary(
            qev, {"kind": "declared-witness mapping (not a blind preregistration)",
                  "declared": {"sha256": qdigest}, "inputs": {}}, qdigest,
            {"target_sha256": "a" * 64},
            {"exit": 0, "cli_log": "sweep/cli.log"}, qctl, qrows, "complete")
        check("summary preserves top-level exposed declaration kind",
              qsummary["declaration"]["kind"] ==
              "declared-witness mapping (not a blind preregistration)")
        write_json(qev / SUMMARY_NAME, qsummary)
        qns = argparse.Namespace(evidence=str(qev))
        qbuf = io.StringIO()
        with contextlib.redirect_stdout(qbuf):
            qrc = cmd_count(qns)
        qout = qbuf.getvalue()
        check("count recomputes rows and matches summary",
              qrc == EXIT_OK and "witness_classified=10" in qout
              and "unresolved\tnone" in qout)
        qsummary["rows"][0]["classification"] = "killed-on-witness"
        qsummary["counts"] = counts(qsummary["rows"])
        write_json(qev / SUMMARY_NAME, qsummary)
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                cmd_count(qns)
            check("count refuses summary/raw mismatch", False)
        except Fail as exc:
            check("count refuses summary/raw mismatch", "mismatch" in str(exc))

        print(f"WITNESS_SELFTEST: {cases - failed}/{cases} pass")
        if failed == 0:
            print("VERDICT: PASS")
            return EXIT_OK
        print("VERDICT: FAIL")
        return EXIT_FAIL
    finally:
        if root is not None:
            assert root.resolve(strict=True) == root
            shutil.rmtree(root, ignore_errors=True)
        assert private_root.resolve(strict=True) == private_root
        shutil.rmtree(private_root, ignore_errors=True)


class UsageParser(argparse.ArgumentParser):
    """argparse's default usage exit is 2; the probe contract uses 64."""

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, f"{self.prog}: error: {message}\n")


def build_parser() -> argparse.ArgumentParser:
    parser = UsageParser(
        prog="bash-witness-study.py",
        description="declared-witness classification of the pinned "
                    "bash-surface-census mutation leg")
    parser.add_argument("--evidence", default=str(EVIDENCE_DEFAULT),
                        help=f"evidence directory (default: {EVIDENCE_DEFAULT})")
    parser.add_argument("--kagi", default=str(KAGI_DEFAULT),
                        help=f"kagi-shokunin repo (default: {KAGI_DEFAULT})")
    sub = parser.add_subparsers(dest="mode", required=True)

    def add_common(sp: argparse.ArgumentParser) -> None:
        # SUPPRESS keeps the top-level value when the subcommand omits the option,
        # so both `--evidence X declare` and `declare --evidence X` work.
        sp.add_argument("--evidence", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        sp.add_argument("--kagi", default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    for name, help_text in (
        ("declare", "freeze the declared-witness TSV + declaration.json"),
        ("run", "execute the pinned sweep and classify every defect"),
        ("rerun", "re-run a fresh sweep against the static declarations"),
        ("count", "print classified rows, counts and unresolved (read-only)"),
        ("check", "verify every committed digest; named refusal on tamper"),
        ("selftest", "hermetic fixtures for the parser and classifier"),
    ):
        sp = sub.add_parser(name, help=help_text)
        add_common(sp)
        if name in ("run", "rerun"):
            sp.add_argument("--timeout", type=int, default=300,
                            help="seconds per suite run (default: 300)")
            sp.add_argument("--tail", type=int, default=4,
                            help="runner output tail lines per run (default: 4)")
    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    handlers = {"declare": cmd_declare, "run": cmd_run, "rerun": cmd_rerun,
                "count": cmd_count, "check": cmd_check, "selftest": cmd_selftest}
    try:
        return handlers[args.mode](args)
    except Fail as exc:
        print(f"WITNESS_STUDY: {exc}", file=sys.stderr)
        return EXIT_FAIL
    except Cannot as exc:
        print(f"WITNESS_STUDY: CANNOT-EVALUATE ({exc})", file=sys.stderr)
        return EXIT_CANNOT


if __name__ == "__main__":
    sys.exit(main())


SOURCE tools/evidence-disposition.py sha256=66655a3a692b587fd0a6dc3f2cf0edd766a824eb86280753d0bd57efeecc1f44
#!/usr/bin/env python3
"""evidence-disposition.py — expectation disposition gate (tameshi-shokunin round 14).

Question answered: does one dispositions document account for every frozen
round-13 expected check exactly once, and does each disposition row bind to a
raw receipt observation that satisfies the original expectation — or, for the
one configured supersession, retain a genuinely mismatched raw observation
while both declared replacements pass?

This is a gate over declarations and retained receipt JSON. It never executes
receipt argv. Pins in the dispositions document are configured authority for
the bytes read here; they are not an authentication or preregistration claim,
and passing this gate does not prove that any recorded command was rerun.

Disposition schema `evidence-dispositions-v1`:
  {"schema": "evidence-dispositions-v1",
   "expected_file": <lane-relative path>,
   "inputs": {<lane-relative path>: <64 lowercase hex sha256>, ...},
   "rows": [effective | superseded, ...]}

  Schema `evidence-dispositions-v2` (round-17 R16-OP1) keeps every v1 field
  and adds:
    "supersedes": lane-relative path of the v1 manifest this document
      supersedes; informational, and it must itself be pinned in `inputs`.
    "historical_inputs": {<lane-relative path>: {"rev": <40-hex commit>,
      "reason": <text>}}. For each declared path the expected-input bytes are
      read with `git -C <root> cat-file blob --end-of-options <rev>:<path>`
      instead of the live file, after a repo-identity guard (realpath of
      `git -C <root> rev-parse --show-toplevel` must equal realpath(root)).
      Keys must start with `tools/` (lane instruments move by design; evidence
      never) and must appear in expected.json's `inputs`; the blob digest must
      still equal the expected pin. Every other input keeps live-tree
      integrity-first verification. The payload adds
      `expected_inputs_historical` {path: rev}.
      Failure ids (exit 2): historical_input_forbidden,
      historical_input_unknown, historical_input_unavailable,
      expected_input_digest_mismatch, historical_input_unneeded,
      historical_input_uncommitted, supersedes_mismatch.

  v2 guards (round-17 hardening):
    G1 historical_input_unneeded: a waived path whose live bytes still equal
       the expected pin must not be waived (the waiver set is derived from
       observed drift, not author choice).
    G2 historical_input_uncommitted: the live bytes of a waived path must equal
       that path in the run's committed anchor A; an uncommitted worktree edit,
       a symlink, or deletion while A still has the path is tampering. A
       committed deletion is allowed.
    G3 rev must resolve to exactly that commit id (tree/blob/HEAD/branch/abbrev
       rejected) and be an ancestor of the same anchor A, else
       historical_input_unavailable.
    Anchor A is refs/heads/<lane.branch> or an attached local branch tip when
    bound. An unbound jj workspace is refused; an unbound detached non-jj
    harness uses HEAD only when a local or remote-tracking ref contains it.
    G4 every git subprocess scrubs all inherited GIT_* variables and sets
       GIT_NO_REPLACE_OBJECTS=1, GIT_GRAFT_FILE=/dev/null,
       GIT_CONFIG_NOSYSTEM=1, GIT_CONFIG_GLOBAL=/dev/null; the root must be a
       non-shallow work tree whose --absolute-git-dir is <root>/.git.
    G5 the tree entry must be a 100644/100755 blob; bytes are read, never text.
    G6 text mode prints one `HISTORICAL <path> rev=<rev> sha256=<sha>` line per
       waiver; JSON carries expected_inputs_historical (and historical_text).
    G7 `supersedes` must name a v1 manifest with this document's expected_file
       and rows, whose inputs are pinned identically (supersedes_mismatch).

  effective row keys are exactly:
      name, state="effective", receipt, check
    name and check must be the same string; the check must exist in the named
    receipt. A different same-shaped check (e.g. pin_live -> pin_env_scrub)
    is rejected by `effective_check_name_mismatch`.

  superseded row keys are exactly:
      name, state="superseded", reason, raw_receipt, raw_check, superseded_by
    Only `producer_before` may be superseded (configured round-14 policy).
    raw_receipt/raw_check name the retained raw observation; it is re-evaluated
    against the original expectation and must genuinely mismatch. The
    replacement list must be exactly producer_before_oracle and
    producer_after_oracle; both must be effective rows with check == name and
    must pass. The producer-oracle receipt must declare
    `supersedes` starting "verification.json producer_before" and its
    `oracle_sha256` must equal expected.inputs[producer-oracle.py].

Receipt and raw_receipt values are lane-relative canonical paths that must
appear as `inputs` keys. They must live in the expected file's directory.
`inputs` must pin the expected file and the two round-13 sibling receipts
(verification.json, producer-oracle-repair.json). Every declared pin is hashed
and checked before any expectation predicate runs. expected.json's own
`inputs` map is also verified in full before predicates.

Every file is read once through an O_NOFOLLOW descriptor, lstat/fstat identity
is compared, and the same cached bytes are hashed and parsed. Absolute paths,
"..", ".", "\\", NUL, repeated or trailing separators, symlink components and
non-regular files are rejected.

Predicates use only the original expected fields: exit, contains, id, reason,
rows, statuses, result_reuse. `contains` is a literal substring of the receipt
check's stdout only (never stderr). Structured predicates parse stdout as one
JSON object:
  id/reason            exact value at the top level
  rows                 top-level rows (int or list length), counts.legs, and
                       len(legs) must all agree when present
  statuses             expected histogram compared against top-level statuses,
                       counts, and the per-leg content_status histogram;
                       an absent status counts as 0
  result_reuse         top-level and every per-leg result_reuse must agree
Receipt `expected_exit`/`exit_matches` fields are never trusted. Receipt-only
checks stay informational and never become expectations.

Exit map:
  0  clean: every expected check accounted for, all predicates pass
  1  failed semantic expectation (row graph or predicate mismatch)
  2  could-not-evaluate: missing/unreadable/malformed/tampered/path-invalid
     input, invalid schema/type, or an unexpected internal failure
  64 usage error

Output: stable finding IDs, one disposition record per expected check, and
mismatch details. `--json` emits the full document; text output is one summary
line, ROW lines and FINDING lines.

CLI:
  evidence-disposition.py --root LANE --dispositions FILE [--json]
  evidence-disposition.py --selftest
Selftest also requires `jj` for its isolated colocated-repository cases.
"""

import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from collections import defaultdict
from pathlib import Path, PurePosixPath

VERSION = "evidence-disposition.py r18 (tameshi-shokunin, 2026-10-20): branch-tip v2 historical inputs"
SELF = os.path.realpath(__file__)

SCHEMA = "evidence-dispositions-v1"
SCHEMA_V2 = "evidence-dispositions-v2"
SCHEMAS = (SCHEMA, SCHEMA_V2)
RESULT_SCHEMA = "evidence-disposition-result-v1"
HEX64 = re.compile(r"[0-9a-f]{64}")
HEX40 = re.compile(r"[0-9a-f]{40}")

EXPECTATION_FIELDS = frozenset(
    ("exit", "contains", "id", "reason", "rows", "statuses", "result_reuse")
)
EFFECTIVE_KEYS = frozenset(("name", "state", "receipt", "check"))
SUPERSEDED_KEYS = frozenset(
    ("name", "state", "reason", "raw_receipt", "raw_check", "superseded_by")
)

# Round-14 configured supersession policy. Only the routed producer_before row
# may be superseded, and only by the two oracle observations.
SUPERSEDED_POLICY = {
    "producer_before": {
        "raw_receipt": "verification.json",
        "raw_check": "producer_before",
        "replacements": ("producer_before_oracle", "producer_after_oracle"),
    }
}
REQUIRED_RECEIPTS = ("verification.json", "producer-oracle-repair.json")
ORACLE_RECEIPT = "producer-oracle-repair.json"
ORACLE_INPUT = "producer-oracle.py"
ORACLE_SUPERSEDES_PREFIX = "verification.json producer_before"

USAGE = """usage: evidence-disposition.py --root LANE --dispositions FILE [--json]
       evidence-disposition.py --selftest

Expectation-disposition gate: every frozen expected check appears exactly once
in rows; effective rows must satisfy their original expectation from a named
receipt check; the one configured producer_before supersession must retain a
genuinely mismatched raw observation and pass both oracle replacements.

exit 0   clean
exit 1   failed semantic expectation
exit 2   could-not-evaluate bad/missing/tampered input
exit 64  usage error

Receipt/raw_receipt values are lane-relative paths pinned in `inputs`. The tool
never executes receipt argv. `--selftest` builds isolated /tmp fixtures.
evidence-dispositions-v2 manifests add `supersedes` (pinned v1 manifest path)
and `historical_inputs` (tools/* expected inputs read as git blobs at the
declared rev after a repo-identity guard). A waiver is refused when the live
bytes still equal the pin (historical_input_unneeded) or differ from the
selected committed anchor (historical_input_uncommitted); revs must be commits
ancestral to that same anchor.
"""


class CouldNotEvaluate(Exception):
    """Input that prevents the disposition question from being evaluated."""

    def __init__(self, finding_id, detail):
        super().__init__(detail)
        self.finding_id = finding_id
        self.detail = detail


class UsageError(Exception):
    pass


# ------------------------------------------------------------------ utilities


def sha256_bytes(payload):
    return hashlib.sha256(payload).hexdigest()


def tool_sha256():
    try:
        with open(SELF, "rb") as handle:
            return sha256_bytes(handle.read())
    except OSError:
        return None


def _reject_duplicate_keys(pairs):
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise ValueError("duplicate JSON key: {!r}".format(key))
        seen[key] = value
    return seen


def _reject_constant(token):
    raise ValueError("non-finite JSON constant: {}".format(token))


def parse_json_object(raw, label):
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise CouldNotEvaluate(label + "_json_invalid", "not valid UTF-8")
    try:
        value = json.loads(
            text,
            object_pairs_hook=_reject_duplicate_keys,
            parse_constant=_reject_constant,
        )
    except (ValueError, json.JSONDecodeError) as exc:
        raise CouldNotEvaluate(label + "_json_invalid", "malformed JSON: {}".format(exc))
    if not isinstance(value, dict):
        raise CouldNotEvaluate(label + "_json_invalid", "top-level JSON value is not an object")
    return value


def _is_int(value):
    return type(value) is int


def _short(value, limit=180):
    text = repr(value)
    return text if len(text) <= limit else text[:limit] + "..."


# --------------------------------------------------------------- safe reading


def canonical_relative(value, label):
    if not isinstance(value, str) or not value:
        raise CouldNotEvaluate("path_rejected", "{}: empty or non-string relative path".format(label))
    if "\x00" in value:
        raise CouldNotEvaluate("path_rejected", "{}: NUL byte in path".format(label))
    if "\\" in value:
        raise CouldNotEvaluate("path_rejected", "{}: backslash in path".format(label))
    pure = PurePosixPath(value)
    if pure.is_absolute():
        raise CouldNotEvaluate("path_rejected", "{}: absolute path".format(label))
    if any(part == ".." for part in pure.parts):
        raise CouldNotEvaluate("path_rejected", "{}: parent traversal".format(label))
    if str(pure) != value:
        raise CouldNotEvaluate(
            "path_rejected", "{}: non-canonical relative path {!r}".format(label, value)
        )
    if str(pure) == ".":
        raise CouldNotEvaluate("path_rejected", "{}: empty path".format(label))
    return pure


def safe_file(lane, relative, label):
    """Resolve a declared lane-relative path without escaping or symlinks."""
    pure = canonical_relative(relative, label)
    current = lane
    for part in pure.parts:
        current = current / part
        try:
            st = os.lstat(current)
        except FileNotFoundError:
            raise CouldNotEvaluate(label + "_missing", "{}: {}: missing".format(label, relative))
        except OSError as exc:
            raise CouldNotEvaluate(
                label + "_unreadable",
                "{}: {}: {}".format(label, relative, exc.strerror or exc),
            )
        if stat.S_ISLNK(st.st_mode):
            raise CouldNotEvaluate(
                "path_rejected", "{}: symlink component in {}".format(label, relative)
            )
    try:
        st = os.lstat(current)
    except OSError as exc:
        raise CouldNotEvaluate(
            label + "_unreadable", "{}: {}: {}".format(label, relative, exc.strerror or exc)
        )
    if not stat.S_ISREG(st.st_mode):
        raise CouldNotEvaluate("path_rejected", "{}: not a regular file".format(label))
    try:
        current.resolve().relative_to(lane)
    except ValueError:
        raise CouldNotEvaluate("path_rejected", "{}: resolves outside lane root".format(label))
    return current


def read_regular(path, label):
    """O_NOFOLLOW read; lstat/fstat identity checked; exactly one read."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        before = os.lstat(path)
    except FileNotFoundError:
        raise CouldNotEvaluate(label + "_missing", "{}: missing".format(label))
    except OSError as exc:
        raise CouldNotEvaluate(label + "_unreadable", "{}: {}".format(label, exc.strerror or exc))
    if not stat.S_ISREG(before.st_mode):
        raise CouldNotEvaluate("path_rejected", "{}: not a regular file".format(label))
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        raise CouldNotEvaluate(label + "_missing", "{}: missing".format(label))
    except OSError as exc:
        raise CouldNotEvaluate(label + "_unreadable", "{}: {}".format(label, exc.strerror or exc))
    try:
        after = os.fstat(fd)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise CouldNotEvaluate("path_rejected", "{}: file changed during read".format(label))
        if not stat.S_ISREG(after.st_mode):
            raise CouldNotEvaluate("path_rejected", "{}: not a regular file".format(label))
        chunks = []
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)
    except OSError as exc:
        raise CouldNotEvaluate(label + "_unreadable", "{}: {}".format(label, exc.strerror or exc))
    finally:
        os.close(fd)


def read_dispositions(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        raise CouldNotEvaluate("dispositions_missing", str(path))
    except OSError as exc:
        raise CouldNotEvaluate("dispositions_unreadable", "{}: {}".format(path, exc.strerror or exc))
    if stat.S_ISLNK(st.st_mode):
        raise CouldNotEvaluate("path_rejected", "dispositions: symlink")
    if not stat.S_ISREG(st.st_mode):
        raise CouldNotEvaluate("path_rejected", "dispositions: not a regular file")
    return read_regular(path, "dispositions")

# ------------------------------------------------- historical input reading

# G4: every git subprocess runs without inherited GIT_* state, without replace
# refs and without grafts, so environment/replace/graft attacks cannot rewrite
# the bytes this gate reads.
GIT_ENV_OVERRIDES = {
    "GIT_NO_REPLACE_OBJECTS": "1",
    "GIT_GRAFT_FILE": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_CONFIG_GLOBAL": "/dev/null",
}


def _stderr_text(proc):
    if proc.stderr is None:
        return ""
    if isinstance(proc.stderr, bytes):
        return proc.stderr.decode("utf-8", "replace").strip()
    return str(proc.stderr).strip()


def git_environment():
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(GIT_ENV_OVERRIDES)
    return env


def git_call(lane, argv, timeout=30):
    """Hermetic git subprocess (bytes, never text)."""
    try:
        return subprocess.run(
            ["git", "-C", str(lane)] + list(argv),
            capture_output=True,
            env=git_environment(),
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "git {}: {}".format(argv[0], exc),
        )


def _git_failure(proc, action):
    return CouldNotEvaluate(
        "historical_input_unavailable",
        "{}: {}".format(action, _stderr_text(proc) or "exit {}".format(proc.returncode)),
    )


def verify_repo(lane):
    """G4 identity/topology guard: <lane> is its own non-shallow work tree."""
    proc = git_call(lane, ["rev-parse", "--absolute-git-dir", "--show-toplevel"])
    if proc.returncode != 0:
        raise _git_failure(proc, "root is not inside a git work tree")
    lines = proc.stdout.decode("utf-8", "replace").splitlines()
    if len(lines) != 2:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "rev-parse --absolute-git-dir --show-toplevel returned {!r}".format(lines),
        )
    git_dir, toplevel = lines
    lane_real = os.path.realpath(str(lane))
    if os.path.realpath(toplevel) != lane_real:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "root is not the toplevel of its own work tree "
            "(git reports {!r})".format(toplevel),
        )
    if os.path.realpath(git_dir) != os.path.join(lane_real, ".git"):
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "git dir {!r} is not <root>/.git".format(git_dir),
        )
    proc = git_call(lane, ["rev-parse", "--is-shallow-repository"])
    if proc.returncode != 0 or proc.stdout.decode("utf-8", "replace").strip() != "false":
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "root is a shallow repository; historical blobs are not provable",
        )


def _commit_of(lane, revision):
    """Return a canonical 40-hex commit id, or None when revision is unavailable."""
    proc = git_call(
        lane,
        ["rev-parse", "--verify", "--quiet", "--end-of-options", revision + "^{commit}"],
    )
    commit = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode != 0 or not HEX40.fullmatch(commit):
        return None
    return commit


def resolve_historical_anchor(lane):
    """Resolve one committed anchor shared by G2 and G3."""
    proc = git_call(lane, ["config", "--get", "lane.branch"])
    if proc.returncode not in (0, 1):
        raise _git_failure(proc, "cannot read lane.branch")
    branch = proc.stdout.decode("utf-8", "replace").strip() if proc.returncode == 0 else ""
    if not branch:
        proc = git_call(lane, ["symbolic-ref", "-q", "HEAD"])
        if proc.returncode == 0:
            ref = proc.stdout.decode("utf-8", "replace").strip()
            prefix = "refs/heads/"
            if ref.startswith(prefix):
                branch = ref[len(prefix):]
        elif proc.returncode != 1:
            raise _git_failure(proc, "cannot resolve HEAD branch")

    if branch:
        branch_ref = "refs/heads/" + branch
        proc = git_call(lane, ["check-ref-format", branch_ref])
        if proc.returncode != 0:
            raise CouldNotEvaluate(
                "historical_input_unavailable",
                "invalid local lane branch {!r}".format(branch),
            )
        commit = _commit_of(lane, branch_ref)
        if commit is None:
            raise CouldNotEvaluate(
                "historical_input_unavailable",
                "lane branch {} does not resolve to a commit".format(branch_ref),
            )
        return branch_ref, commit

    if os.path.lexists(str(lane / ".jj")):
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "jj workspace without a lane.branch binding has no authoritative tip",
        )

    commit = _commit_of(lane, "HEAD")
    if commit is None:
        raise CouldNotEvaluate(
            "historical_input_unavailable", "HEAD does not resolve to a commit"
        )
    proc = git_call(
        lane,
        [
            "for-each-ref",
            "--contains",
            commit,
            "--format=%(refname)",
            "refs/heads/",
            "refs/remotes/",
        ],
    )
    if proc.returncode != 0:
        raise _git_failure(proc, "cannot find a ref containing detached HEAD")
    containing_refs = [
        ref for ref in proc.stdout.decode("utf-8", "replace").splitlines()
        if ref and not ref.endswith("/HEAD")
    ]
    if not containing_refs:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "detached HEAD {} is on no branch or remote-tracking branch".format(commit),
        )
    return "HEAD", commit


def resolve_historical_rev(lane, rev, anchor_label, anchor_commit):
    """G3: rev is exactly that commit id and an ancestor of anchor_commit."""
    proc = git_call(lane, ["rev-parse", "--verify", "--end-of-options", rev + "^{commit}"])
    resolved = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode != 0 or resolved != rev:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "rev {!r} does not resolve to that commit (got {!r})".format(rev, resolved),
        )
    proc = git_call(
        lane,
        ["merge-base", "--is-ancestor", "--end-of-options", rev, anchor_commit],
    )
    if proc.returncode != 0:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "rev {} is not an ancestor of {} ({})".format(rev, anchor_label, anchor_commit),
        )



TREE_MODES = ("100644", "100755")


def tree_entry(lane, rev, path):
    """(mode, type, object id) for <path> at <rev>, or None when absent."""
    proc = git_call(lane, ["ls-tree", "-z", "--full-tree", rev, "--", path])
    if proc.returncode != 0:
        raise _git_failure(proc, "ls-tree {}:{}".format(rev, path))
    records = [item for item in proc.stdout.split(b"\0") if item]
    if not records:
        return None
    if len(records) != 1:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: ambiguous tree entries at {}".format(path, rev),
        )
    meta, _, name = records[0].partition(b"\t")
    fields = meta.decode("utf-8", "replace").split()
    if len(fields) != 3 or name.decode("utf-8", "replace") != path:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: unparsable tree entry at {}".format(path, rev),
        )
    return fields[0], fields[1], fields[2]


def read_blob(lane, object_id, path):
    proc = git_call(lane, ["cat-file", "blob", object_id])
    if proc.returncode != 0:
        raise _git_failure(proc, "{}: blob {} unavailable".format(path, object_id))
    return proc.stdout


def live_regular_bytes(lane, path):
    """Live bytes only when every component is a real directory/file."""
    current = Path(lane)
    for part in PurePosixPath(path).parts:
        current = current / part
        try:
            st = os.lstat(current)
        except OSError:
            return None
        if stat.S_ISLNK(st.st_mode):
            return None
    if not stat.S_ISREG(st.st_mode):
        return None
    try:
        return read_regular(current, "historical_input")
    except CouldNotEvaluate:
        return None


def check_historical_waiver(lane, path, pin, anchor_label, anchor_commit):
    """G1/G2: the waiver must be needed and committed at the shared anchor."""
    live = live_regular_bytes(lane, path)
    if live is not None and sha256_bytes(live) == pin:
        raise CouldNotEvaluate(
            "historical_input_unneeded",
            "{}: live bytes still equal the expected pin; the waiver is unnecessary".format(path),
        )
    anchor_entry = tree_entry(lane, anchor_commit, path)
    if live is None:
        if anchor_entry is not None:
            raise CouldNotEvaluate(
                "historical_input_uncommitted",
                "{}: live path is absent or not a regular file but {} has an entry".format(
                    path, anchor_label
                ),
            )
        return
    if anchor_entry is None:
        raise CouldNotEvaluate(
            "historical_input_uncommitted",
            "{}: live path is not present at {}".format(path, anchor_label),
        )
    if anchor_entry[1] != "blob":
        raise CouldNotEvaluate(
            "historical_input_uncommitted",
            "{}: {} entry is a {} not a blob".format(path, anchor_label, anchor_entry[1]),
        )
    if sha256_bytes(read_blob(lane, anchor_entry[2], path)) != sha256_bytes(live):
        raise CouldNotEvaluate(
            "historical_input_uncommitted",
            "{}: live bytes differ from {}:{}".format(path, anchor_label, path),
        )


def historical_blob(lane, rev, path):
    """G5: regular blob (100644/100755) bytes at <rev>, never text."""
    entry = tree_entry(lane, rev, path)
    if entry is None:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: absent at rev {}".format(path, rev),
        )
    mode, kind, object_id = entry
    if kind != "blob" or mode not in TREE_MODES:
        raise CouldNotEvaluate(
            "historical_input_unavailable",
            "{}: tree entry mode {} type {} is not a regular blob".format(path, mode, kind),
        )
    return read_blob(lane, object_id, path)


# ------------------------------------------------------------- schema checks


def validate_inputs(raw_inputs):
    if not isinstance(raw_inputs, dict) or not raw_inputs:
        raise CouldNotEvaluate("dispositions_field_invalid", "inputs must be a non-empty object")
    pinned = {}
    for key, digest in raw_inputs.items():
        pure = canonical_relative(key, "input")
        canonical = str(pure)
        if canonical in pinned:
            raise CouldNotEvaluate("path_rejected", "duplicate input pin for {}".format(canonical))
        if not isinstance(digest, str) or not HEX64.fullmatch(digest):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: sha256 must be 64 lowercase hex characters".format(key),
            )
        pinned[canonical] = digest
    return pinned


def validate_historical_inputs(raw):
    """v2 historical_inputs: tools/* paths read from a pinned git revision."""
    if not isinstance(raw, dict):
        raise CouldNotEvaluate(
            "dispositions_field_invalid", "historical_inputs must be an object"
        )
    historical = {}
    for key, entry in raw.items():
        canonical = str(canonical_relative(key, "historical_input"))
        if canonical in historical:
            raise CouldNotEvaluate(
                "path_rejected", "duplicate historical input {}".format(canonical)
            )
        if not canonical.startswith("tools/"):
            raise CouldNotEvaluate(
                "historical_input_forbidden",
                "{}: historical inputs must be tools/* paths".format(canonical),
            )
        if not isinstance(entry, dict):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: historical input must be an object with rev and reason".format(canonical),
            )
        rev = entry.get("rev")
        if not isinstance(rev, str) or not HEX40.fullmatch(rev):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: rev must be 40 lowercase hex characters".format(canonical),
            )
        reason = entry.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "{}: reason must be a non-empty string".format(canonical),
            )
        historical[canonical] = rev
    return historical


def receipt_canonical(value, expected_rel):
    if not isinstance(value, str) or not value:
        raise CouldNotEvaluate("dispositions_field_invalid", "receipt must be a non-empty string")
    canonical = str(canonical_relative(value, "receipt"))
    if PurePosixPath(canonical).parent != PurePosixPath(expected_rel).parent:
        raise CouldNotEvaluate(
            "receipt_out_of_scope",
            "receipt {} is not in the expected file's directory".format(canonical),
        )
    return canonical


def validate_rows(raw_rows, expected_rel, pinned):
    if not isinstance(raw_rows, list) or not raw_rows:
        raise CouldNotEvaluate("dispositions_field_invalid", "rows must be a non-empty list")
    rows = []
    for index, row in enumerate(raw_rows):
        if not isinstance(row, dict):
            raise CouldNotEvaluate("row_invalid", "rows[{}] is not an object".format(index))
        name = row.get("name")
        state = row.get("state")
        if not isinstance(name, str) or not name:
            raise CouldNotEvaluate("row_invalid", "rows[{}]: name must be a non-empty string".format(index))
        if state == "effective":
            if set(row) != EFFECTIVE_KEYS:
                raise CouldNotEvaluate(
                    "row_invalid",
                    "{}: effective row keys must be exactly {}".format(
                        name, ", ".join(sorted(EFFECTIVE_KEYS))
                    ),
                )
            receipt = row.get("receipt")
            check = row.get("check")
            if not isinstance(check, str) or not check:
                raise CouldNotEvaluate("row_invalid", "{}: check must be a non-empty string".format(name))
            receipt_rel = receipt_canonical(receipt, expected_rel)
            if receipt_rel not in pinned:
                raise CouldNotEvaluate(
                    "input_unpinned", "{}: receipt {} is not pinned in inputs".format(name, receipt_rel)
                )
            rows.append(
                {"name": name, "state": "effective", "receipt_rel": receipt_rel, "check": check}
            )
        elif state == "superseded":
            if set(row) != SUPERSEDED_KEYS:
                raise CouldNotEvaluate(
                    "row_invalid",
                    "{}: superseded row keys must be exactly {}".format(
                        name, ", ".join(sorted(SUPERSEDED_KEYS))
                    ),
                )
            reason = row.get("reason")
            raw_check = row.get("raw_check")
            replacements = row.get("superseded_by")
            if not isinstance(reason, str):
                raise CouldNotEvaluate("row_invalid", "{}: reason must be a string".format(name))
            if not isinstance(raw_check, str) or not raw_check:
                raise CouldNotEvaluate("row_invalid", "{}: raw_check must be a non-empty string".format(name))
            if not isinstance(replacements, list) or not all(
                isinstance(item, str) and item for item in replacements
            ):
                raise CouldNotEvaluate(
                    "row_invalid", "{}: superseded_by must be a list of non-empty names".format(name)
                )
            raw_rel = receipt_canonical(row.get("raw_receipt"), expected_rel)
            if raw_rel not in pinned:
                raise CouldNotEvaluate(
                    "input_unpinned", "{}: raw_receipt {} is not pinned in inputs".format(name, raw_rel)
                )
            rows.append(
                {
                    "name": name,
                    "state": "superseded",
                    "reason": reason,
                    "raw_rel": raw_rel,
                    "raw_check": raw_check,
                    "superseded_by": list(replacements),
                }
            )
        else:
            raise CouldNotEvaluate(
                "row_invalid", "{}: state must be 'effective' or 'superseded'".format(name)
            )
    return rows


def validate_expectation(name, spec):
    if not isinstance(spec, dict):
        raise CouldNotEvaluate("expectation_invalid", "{}: expectation is not an object".format(name))
    unknown = sorted(set(spec) - EXPECTATION_FIELDS)
    if unknown:
        raise CouldNotEvaluate(
            "expectation_invalid", "{}: unsupported expectation field(s) {}".format(name, ", ".join(unknown))
        )
    if "exit" not in spec or not _is_int(spec["exit"]):
        raise CouldNotEvaluate("expectation_invalid", "{}: exit must be an integer".format(name))
    for field in ("contains", "id", "reason", "result_reuse"):
        if field in spec and (not isinstance(spec[field], str) or not spec[field]):
            raise CouldNotEvaluate(
                "expectation_invalid", "{}: {} must be a non-empty string".format(name, field)
            )
    if "rows" in spec and (not _is_int(spec["rows"]) or spec["rows"] < 0):
        raise CouldNotEvaluate("expectation_invalid", "{}: rows must be a non-negative integer".format(name))
    if "statuses" in spec:
        statuses = spec["statuses"]
        if not isinstance(statuses, dict) or not statuses:
            raise CouldNotEvaluate("expectation_invalid", "{}: statuses must be a non-empty object".format(name))
        for key, count in statuses.items():
            if not isinstance(key, str) or not key:
                raise CouldNotEvaluate("expectation_invalid", "{}: status name must be a string".format(name))
            if not _is_int(count) or count < 0:
                raise CouldNotEvaluate(
                    "expectation_invalid", "{}: status {} must be a non-negative integer".format(name, key)
                )
    return spec


def validate_expected(expected):
    raw_inputs = expected.get("inputs")
    if not isinstance(raw_inputs, dict) or not raw_inputs:
        raise CouldNotEvaluate("expected_structure_invalid", "expected.inputs must be a non-empty object")
    expected_inputs = {}
    for key, digest in raw_inputs.items():
        canonical = str(canonical_relative(key, "expected_input"))
        if canonical in expected_inputs:
            raise CouldNotEvaluate(
                "expected_structure_invalid", "duplicate expected input path {}".format(canonical)
            )
        if not isinstance(digest, str) or not HEX64.fullmatch(digest):
            raise CouldNotEvaluate(
                "expected_structure_invalid",
                "{}: sha256 must be 64 lowercase hex characters".format(key),
            )
        expected_inputs[canonical] = digest
    raw_checks = expected.get("expected_checks")
    if not isinstance(raw_checks, dict) or not raw_checks:
        raise CouldNotEvaluate(
            "expected_structure_invalid", "expected.expected_checks must be a non-empty object"
        )
    checks = {}
    for name, spec in raw_checks.items():
        if not isinstance(name, str) or not name:
            raise CouldNotEvaluate(
                "expected_structure_invalid", "expected check name must be a non-empty string"
            )
        checks[name] = validate_expectation(name, spec)
    return checks, expected_inputs


def load_receipts(used_receipts, input_bytes):
    maps = {}
    docs = {}
    owners = defaultdict(list)
    for canonical in sorted(used_receipts):
        if canonical not in input_bytes:
            raise CouldNotEvaluate("internal_error", "receipt bytes unavailable: {}".format(canonical))
        doc = parse_json_object(input_bytes[canonical], "receipt")
        checks = doc.get("checks")
        if not isinstance(checks, list):
            raise CouldNotEvaluate(
                "receipt_structure_invalid", "{}: checks must be a list".format(canonical)
            )
        by_name = {}
        for check in checks:
            if not isinstance(check, dict):
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}: check entry is not an object".format(canonical)
                )
            name = check.get("name")
            if not isinstance(name, str) or not name:
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}: check name must be a non-empty string".format(canonical)
                )
            if name in by_name:
                raise CouldNotEvaluate(
                    "receipt_check_duplicate", "{}: duplicate check {!r}".format(canonical, name)
                )
            if not _is_int(check.get("exit")):
                raise CouldNotEvaluate(
                    "receipt_check_invalid",
                    "{}:{}: exit must be an integer (bool is not an exit)".format(canonical, name),
                )
            if not isinstance(check.get("stdout"), str):
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}:{}: stdout must be a string".format(canonical, name)
                )
            if "stderr" in check and not isinstance(check["stderr"], str):
                raise CouldNotEvaluate(
                    "receipt_check_invalid", "{}:{}: stderr must be a string".format(canonical, name)
                )
            by_name[name] = check
            owners[name].append(canonical)
        maps[canonical] = by_name
        docs[canonical] = doc
    for name in sorted(owners):
        if len(owners[name]) > 1:
            raise CouldNotEvaluate(
                "receipt_check_ambiguous",
                "check {!r} appears in multiple receipts: {}".format(
                    name, ", ".join(sorted(owners[name]))
                ),
            )
    return maps, docs


# ---------------------------------------------------------------- predicates


def _structured_object(stdout):
    try:
        value = json.loads(stdout, parse_constant=_reject_constant)
    except (ValueError, TypeError):
        return None
    return value if isinstance(value, dict) else None


def _row_candidates(parsed):
    candidates = []
    if "rows" in parsed:
        value = parsed["rows"]
        if _is_int(value) and value >= 0:
            candidates.append(("rows", value))
        elif isinstance(value, list):
            candidates.append(("rows.length", len(value)))
    counts = parsed.get("counts")
    if isinstance(counts, dict) and _is_int(counts.get("legs")) and counts["legs"] >= 0:
        candidates.append(("counts.legs", counts["legs"]))
    legs = parsed.get("legs")
    if isinstance(legs, list):
        candidates.append(("legs.length", len(legs)))
    return candidates


def _status_sources(parsed, expected_keys):
    sources = []
    statuses = parsed.get("statuses")
    if isinstance(statuses, dict):
        sources.append(("statuses", statuses))
    counts = parsed.get("counts")
    if isinstance(counts, dict):
        sources.append(("counts", counts))
    legs = parsed.get("legs")
    if isinstance(legs, list) and all(
        isinstance(item, dict) and isinstance(item.get("content_status"), str) for item in legs
    ):
        histogram = {
            key: sum(1 for item in legs if item["content_status"] == key) for key in expected_keys
        }
        sources.append(("legs.content_status", histogram))
    return sources


def _result_reuse_candidates(parsed):
    values = []
    if "result_reuse" in parsed:
        values.append(("result_reuse", parsed["result_reuse"]))
    legs = parsed.get("legs")
    if isinstance(legs, list) and legs:
        for index, item in enumerate(legs):
            if isinstance(item, dict) and "result_reuse" in item:
                values.append(("legs[{}].result_reuse".format(index), item["result_reuse"]))
    return values


def evaluate_expectation(name, spec, observed):
    collected = {}

    def add(finding_id, detail):
        collected.setdefault(finding_id, []).append(detail)

    if observed["exit"] != spec["exit"]:
        add(
            "expected_exit_mismatch",
            "observed exit {} expects {}".format(observed["exit"], spec["exit"]),
        )

    stdout = observed["stdout"]
    if "contains" in spec and spec["contains"] not in stdout:
        add("expected_contains_missing", "stdout lacks {}".format(_short(spec["contains"], 120)))

    structured_fields = [
        field
        for field in ("id", "reason", "rows", "statuses", "result_reuse")
        if field in spec
    ]
    parsed = None
    if structured_fields:
        parsed = _structured_object(stdout)
        if parsed is None:
            add(
                "expected_stdout_not_json",
                "fields {} require one JSON object on stdout".format(", ".join(structured_fields)),
            )

    if parsed is not None:
        if "id" in spec and parsed.get("id") != spec["id"]:
            add("expected_id_mismatch", "observed {} expects {}".format(_short(parsed.get("id")), _short(spec["id"])))
        if "reason" in spec and parsed.get("reason") != spec["reason"]:
            add(
                "expected_reason_mismatch",
                "observed {} expects {}".format(_short(parsed.get("reason")), _short(spec["reason"])),
            )
        if "rows" in spec:
            candidates = _row_candidates(parsed)
            values = sorted({value for _source, value in candidates})
            if not candidates:
                add("expected_rows_mismatch", "no observed row count source")
            elif len(values) != 1:
                add(
                    "expected_rows_mismatch",
                    "observed row counts disagree: {}".format(
                        ", ".join("{}={}".format(source, value) for source, value in candidates)
                    ),
                )
            elif values[0] != spec["rows"]:
                add(
                    "expected_rows_mismatch",
                    "observed {!r} expects {!r}".format(values[0], spec["rows"]),
                )
        if "statuses" in spec:
            sources = _status_sources(parsed, list(spec["statuses"]))
            if not sources:
                add("expected_statuses_mismatch", "no observed status histogram source")
            for key, expected_count in spec["statuses"].items():
                observed_counts = []
                for source, mapping in sources:
                    if key in mapping:
                        observed_counts.append((source, mapping[key]))
                if not observed_counts:
                    add("expected_statuses_mismatch", "status {!r} has no observed source".format(key))
                    continue
                bad = []
                for source, value in observed_counts:
                    if not _is_int(value) or value != expected_count:
                        bad.append("{}={!r}".format(source, value))
                if bad:
                    add(
                        "expected_statuses_mismatch",
                        "status {!r} expects {} observed {}".format(
                            key, expected_count, ", ".join(bad)
                        ),
                    )
        if "result_reuse" in spec:
            candidates = _result_reuse_candidates(parsed)
            if not candidates:
                add("expected_result_reuse_mismatch", "no observed result_reuse value")
            for source, value in candidates:
                if value != spec["result_reuse"]:
                    add(
                        "expected_result_reuse_mismatch",
                        "{}={!r} expects {!r}".format(source, value, spec["result_reuse"]),
                    )
    return [
        {
            "id": finding_id,
            "detail": "{}: {}".format(name, "; ".join(details)),
        }
        for finding_id, details in collected.items()
    ]


def cycle_nodes(graph):
    """Names participating in a superseded_by cycle."""
    color = {name: 0 for name in graph}
    found = set()
    path = []

    def visit(node):
        color[node] = 1
        path.append(node)
        for target in graph.get(node, ()):
            if target not in graph:
                continue
            if color[target] == 1:
                found.update(path[path.index(target):])
            elif color[target] == 0:
                visit(target)
        path.pop()
        color[node] = 2

    for name in sorted(graph):
        if color[name] == 0:
            visit(name)
    return found


# ------------------------------------------------------------------ evaluation


def add_finding(findings, findings_by_name, finding_id, expectation, detail):
    findings.append({"id": finding_id, "expectation": expectation, "detail": detail})
    if isinstance(expectation, str) and expectation:
        findings_by_name[expectation].append(finding_id)


def evaluate_dispositions(checks, rows, expected_inputs, receipt_maps, receipt_docs, expected_rel):
    expected_order = list(checks.keys())
    expected_parent = PurePosixPath(expected_rel).parent
    rows_by_name = defaultdict(list)
    for row in rows:
        rows_by_name[row["name"]].append(row)

    findings = []
    findings_by_name = defaultdict(list)

    for name in sorted(rows_by_name):
        if len(rows_by_name[name]) > 1:
            add_finding(
                findings,
                findings_by_name,
                "row_duplicate",
                name,
                "{} rows declare this name".format(len(rows_by_name[name])),
            )
    for name in sorted(rows_by_name):
        if name not in checks:
            add_finding(
                findings,
                findings_by_name,
                "row_unknown",
                name,
                "row name is not an expected_checks key",
            )
    for name in expected_order:
        if name not in rows_by_name:
            add_finding(
                findings,
                findings_by_name,
                "row_missing",
                name,
                "expected check has no disposition row",
            )

    unique_rows = {name: group[0] for name, group in rows_by_name.items() if len(group) == 1}
    records_by_name = {}
    row_outcomes = {}

    # Phase 1: effective rows.
    for name in expected_order:
        group = rows_by_name.get(name, [])
        if not group:
            records_by_name[name] = {
                "name": name,
                "state": None,
                "outcome": "missing",
                "mismatches": ["row_missing"],
            }
            continue
        if len(group) > 1:
            records_by_name[name] = {
                "name": name,
                "state": None,
                "outcome": "duplicate",
                "mismatches": ["row_duplicate"],
            }
            continue
        row = unique_rows[name]
        if row["state"] != "effective":
            continue
        spec = checks[name]
        if row["check"] != name:
            add_finding(
                findings,
                findings_by_name,
                "effective_check_name_mismatch",
                name,
                "check {!r} does not equal row name".format(row["check"]),
            )
        observed = receipt_maps.get(row["receipt_rel"], {}).get(row["check"])
        if observed is None:
            add_finding(
                findings,
                findings_by_name,
                "receipt_check_missing",
                name,
                "receipt {} has no check {!r}".format(row["receipt_rel"], row["check"]),
            )
            mismatches = [{"id": "receipt_check_missing", "detail": name}]
        else:
            mismatches = evaluate_expectation(name, spec, observed)
            for mismatch in mismatches:
                add_finding(
                    findings,
                    findings_by_name,
                    mismatch["id"],
                    name,
                    mismatch["detail"],
                )
        failed = bool(mismatches) or row["check"] != name
        row_outcomes[name] = {"failed": failed, "mismatches": mismatches}
        records_by_name[name] = {
            "name": name,
            "state": "effective",
            "receipt": row["receipt_rel"],
            "check": row["check"],
            "expected_exit": spec["exit"],
            "observed_exit": observed["exit"] if observed is not None else None,
            "outcome": "fail" if failed else "pass",
            "mismatches": sorted({mismatch["id"] for mismatch in mismatches}),
        }

    # Phase 2: superseded rows.
    superseded_graph = {}
    for name, row in unique_rows.items():
        if name in checks and row["state"] == "superseded":
            targets = []
            for target in dict.fromkeys(row["superseded_by"]):
                if target in unique_rows and unique_rows[target]["state"] == "superseded":
                    targets.append(target)
            superseded_graph[name] = targets
    for name in sorted(cycle_nodes(superseded_graph)):
        add_finding(
            findings,
            findings_by_name,
            "superseded_cycle",
            name,
            "superseded_by graph contains a cycle",
        )

    for name in expected_order:
        group = rows_by_name.get(name, [])
        if len(group) != 1:
            continue
        row = unique_rows[name]
        if row["state"] != "superseded":
            continue
        policy = SUPERSEDED_POLICY.get(name)
        raw_mismatches = []
        raw_retained = False
        raw_receipt = row["raw_rel"]
        raw_check = row["raw_check"]

        if not row["reason"].strip():
            add_finding(
                findings,
                findings_by_name,
                "superseded_reason_missing",
                name,
                "reason is empty",
            )

        if policy is None:
            add_finding(
                findings,
                findings_by_name,
                "supersession_not_permitted",
                name,
                "only producer_before may be superseded in round 14",
            )
        else:
            expected_raw = str(expected_parent / policy["raw_receipt"])
            if row["raw_rel"] != expected_raw or row["raw_check"] != policy["raw_check"]:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_raw_binding_mismatch",
                    name,
                    "raw observation must bind {}:{}".format(expected_raw, policy["raw_check"]),
                )
            else:
                observed = receipt_maps.get(row["raw_rel"], {}).get(row["raw_check"])
                if observed is None:
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_raw_missing",
                        name,
                        "raw receipt {} has no check {!r}".format(row["raw_rel"], row["raw_check"]),
                    )
                else:
                    raw_retained = True
                    raw_mismatches = evaluate_expectation(name, checks[name], observed)
                    if not raw_mismatches:
                        add_finding(
                            findings,
                            findings_by_name,
                            "supersession_unwarranted",
                            name,
                            "retained raw observation satisfies its original expectation",
                        )

            declared = list(row["superseded_by"])
            if len(set(declared)) != len(declared):
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_by_invalid",
                    name,
                    "duplicate replacement names",
                )
            required = list(policy["replacements"])
            missing = [target for target in required if target not in declared]
            extra = [target for target in declared if target not in required]
            if missing:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_required_replacement_missing",
                    name,
                    "missing required replacement(s): {}".format(", ".join(missing)),
                )
            if extra:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_replacement_not_allowed",
                    name,
                    "not an allowed replacement: {}".format(", ".join(extra)),
                )

            expected_oracle = str(expected_parent / ORACLE_RECEIPT)
            oracle_doc = receipt_docs.get(expected_oracle)
            binding_problems = []
            if oracle_doc is None:
                binding_problems.append("oracle receipt {} is not available".format(expected_oracle))
            else:
                supersedes = oracle_doc.get("supersedes")
                if not isinstance(supersedes, str) or not supersedes.startswith(
                    ORACLE_SUPERSEDES_PREFIX
                ):
                    binding_problems.append(
                        "oracle receipt does not declare {!r}".format(ORACLE_SUPERSEDES_PREFIX)
                    )
                oracle_input = str(expected_parent / ORACLE_INPUT)
                pinned_oracle = expected_inputs.get(oracle_input)
                if pinned_oracle is None or oracle_doc.get("oracle_sha256") != pinned_oracle:
                    binding_problems.append(
                        "oracle_sha256 does not equal expected.inputs[{}]".format(oracle_input)
                    )
            if binding_problems:
                add_finding(
                    findings,
                    findings_by_name,
                    "superseded_oracle_binding_missing",
                    name,
                    "; ".join(binding_problems),
                )

            for target in dict.fromkeys(declared):
                if target not in checks or target not in rows_by_name:
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_by_unknown",
                        name,
                        "replacement {!r} is not an expected row".format(target),
                    )
                    continue
                target_group = rows_by_name[target]
                if len(target_group) != 1 or target_group[0]["state"] != "effective":
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_target_not_effective",
                        name,
                        "replacement {!r} is not a unique effective row".format(target),
                    )
                    continue
                if target_group[0]["receipt_rel"] != expected_oracle:
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_replacement_not_allowed",
                        name,
                        "replacement {!r} does not bind {}".format(target, expected_oracle),
                    )
                outcome = row_outcomes.get(target)
                if outcome is not None and outcome["failed"]:
                    ids = sorted({mismatch["id"] for mismatch in outcome["mismatches"]})
                    if target_group[0]["check"] != target:
                        ids.append("effective_check_name_mismatch")
                    add_finding(
                        findings,
                        findings_by_name,
                        "superseded_replacement_failed",
                        name,
                        "replacement {!r} fails: {}".format(
                            target, ", ".join(sorted(set(ids))) or "identity mismatch"
                        ),
                    )

        records_by_name[name] = {
            "name": name,
            "state": "superseded",
            "reason": row["reason"],
            "raw_receipt": raw_receipt,
            "raw_check": raw_check,
            "raw_retained": raw_retained,
            "raw_expectation_failed": bool(raw_mismatches),
            "raw_mismatches": sorted({mismatch["id"] for mismatch in raw_mismatches}),
            "replacements": list(dict.fromkeys(row["superseded_by"])),
            "outcome": "fail" if findings_by_name.get(name) else "superseded",
            "mismatches": sorted(set(findings_by_name.get(name, []))),
        }

    # Final pass: non-predicate findings (identity, selection, policy) fail rows.
    for name, record in records_by_name.items():
        if record.get("state") == "effective" and record["outcome"] == "pass":
            extra = [item for item in findings_by_name.get(name, []) if item not in record["mismatches"]]
            if extra:
                record["outcome"] = "fail"
                record["mismatches"] = sorted(set(record["mismatches"]) | set(extra))

    records = [records_by_name[name] for name in expected_order]
    findings = sorted(
        findings,
        key=lambda item: (item["id"], item["expectation"] or "", item["detail"]),
    )

    informational = []
    for canonical in sorted(receipt_maps):
        for check_name in sorted(receipt_maps[canonical]):
            if check_name not in checks:
                informational.append({"receipt": canonical, "check": check_name})

    return records, findings, informational


# --------------------------------------------------------------------- output


def base_payload(status, exit_code):
    return {
        "schema": RESULT_SCHEMA,
        "tool": VERSION,
        "tool_sha256": tool_sha256(),
        "status": status,
        "exit": exit_code,
    }


def emit_could_not_evaluate(exc, as_json):
    payload = base_payload("could_not_evaluate", 2)
    payload["id"] = exc.finding_id
    payload["error"] = {"kind": exc.finding_id, "message": exc.detail}
    payload["findings"] = [
        {"id": exc.finding_id, "expectation": None, "detail": exc.detail}
    ]
    if as_json:
        sys.stdout.write(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    else:
        sys.stdout.write(
            "EVIDENCE_DISPOSITION: could_not_evaluate exit=2 id={} detail={}\n".format(
                exc.finding_id, exc.detail
            )
        )
    return 2


def emit_result(payload, as_json):
    if as_json:
        sys.stdout.write(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        return payload["exit"]
    counts = payload["counts"]
    sys.stdout.write(
        "EVIDENCE_DISPOSITION: {} exit={} expected={} effective={} superseded={} "
        "passed={} failed={} findings={}\n".format(
            payload["status"],
            payload["exit"],
            counts["expected_checks"],
            counts["effective"],
            counts["superseded"],
            counts["passed"],
            counts["failed"],
            counts["findings"],
        )
    )
    for record in payload["rows"]:
        sys.stdout.write(
            "ROW {} state={} outcome={} receipt={} check={} mismatches={}\n".format(
                record["name"],
                record.get("state"),
                record["outcome"],
                record.get("receipt", record.get("raw_receipt", "-")),
                record.get("check", record.get("raw_check", "-")),
                ",".join(record.get("mismatches", [])) or "-",
            )
        )
    for finding in payload["findings"]:
        sys.stdout.write(
            "FINDING {} expectation={} {}\n".format(
                finding["id"], finding["expectation"] or "-", finding["detail"]
            )
        )
    for line in payload.get("historical_text", ()):
        sys.stdout.write(line + "\n")
    return payload["exit"]


# ----------------------------------------------------------------- run mode


def check_supersedes_lineage(dispositions, supersedes_rel, expected_rel, pinned, input_bytes):
    """G7: `supersedes` must name a v1 manifest this document actually extends."""
    doc = parse_json_object(input_bytes[supersedes_rel], "supersedes")
    problems = []
    if doc.get("schema") != SCHEMA:
        problems.append("superseded document schema is not {!r}".format(SCHEMA))
    if doc.get("expected_file") != expected_rel:
        problems.append("superseded expected_file differs")
    if doc.get("rows") != dispositions.get("rows"):
        problems.append("superseded rows differ from this document's rows")
    superseded_inputs = doc.get("inputs")
    if not isinstance(superseded_inputs, dict):
        problems.append("superseded inputs is not an object")
    else:
        for key, digest in superseded_inputs.items():
            if pinned.get(key) != digest:
                problems.append("superseded input {} is not pinned identically".format(key))
    if problems:
        raise CouldNotEvaluate("supersedes_mismatch", "; ".join(problems))




def run_mode(root, dispositions_path, as_json):
    lane = Path(root).resolve()
    if not lane.is_dir():
        raise CouldNotEvaluate("root_unavailable", "lane root is not a directory: {}".format(root))

    dispositions_file = Path(dispositions_path)
    raw_dispositions = read_dispositions(dispositions_file)
    dispositions = parse_json_object(raw_dispositions, "dispositions")
    schema = dispositions.get("schema")
    if schema not in SCHEMAS:
        # v1-visible text: this detail must stay byte-identical to r14.
        raise CouldNotEvaluate(
            "schema_mismatch",
            "dispositions schema must be {!r}".format(SCHEMA),
        )

    supersedes_rel = None
    historical = {}
    if schema == SCHEMA_V2:
        supersedes_value = dispositions.get("supersedes")
        if not isinstance(supersedes_value, str):
            raise CouldNotEvaluate(
                "dispositions_field_invalid",
                "supersedes must be a lane-relative path string",
            )
        supersedes_rel = str(canonical_relative(supersedes_value, "supersedes"))
        historical = validate_historical_inputs(dispositions.get("historical_inputs"))

    expected_rel = str(canonical_relative(dispositions.get("expected_file"), "expected_file"))
    pinned = validate_inputs(dispositions.get("inputs"))
    if expected_rel not in pinned:
        raise CouldNotEvaluate(
            "input_unpinned", "expected file {} is not pinned in inputs".format(expected_rel)
        )
    expected_parent = PurePosixPath(expected_rel).parent
    for basename in REQUIRED_RECEIPTS:
        canonical = str(expected_parent / basename)
        if canonical not in pinned:
            raise CouldNotEvaluate(
                "input_unpinned", "required receipt {} is not pinned in inputs".format(canonical)
            )
    if schema == SCHEMA_V2 and supersedes_rel not in pinned:
        raise CouldNotEvaluate(
            "input_unpinned",
            "supersedes document {} is not pinned in inputs".format(supersedes_rel),
        )

    rows = validate_rows(dispositions.get("rows"), expected_rel, pinned)

    used_receipts = set()
    for row in rows:
        if row["state"] == "effective":
            used_receipts.add(row["receipt_rel"])
        else:
            used_receipts.add(row["raw_rel"])
    for basename in REQUIRED_RECEIPTS:
        used_receipts.add(str(expected_parent / basename))

    # INTEGRITY FIRST: hash every declared pin exactly once, before any
    # expectation predicate. The cached bytes are parsed below, never re-read.
    input_bytes = {}
    for canonical in sorted(pinned):
        label = "expected_file" if canonical == expected_rel else "input"
        path = safe_file(lane, canonical, label)
        data = read_regular(path, label)
        actual = sha256_bytes(data)
        if actual != pinned[canonical]:
            raise CouldNotEvaluate(
                "input_digest_mismatch",
                "{}: observed {} expects {}".format(canonical, actual, pinned[canonical]),
            )
        input_bytes[canonical] = data

    if schema == SCHEMA_V2:
        check_supersedes_lineage(
            dispositions, supersedes_rel, expected_rel, pinned, input_bytes
        )

    expected = parse_json_object(input_bytes[expected_rel], "expected")
    checks, expected_inputs = validate_expected(expected)

    # Every original expected.inputs digest is verified in full before any
    # predicate runs; a changed historical input is not evaluation material.
    # v2 historical_inputs are classified BEFORE any live read of those paths:
    # a waived path is never opened through safe_file/read_regular here.
    historical_unknown = sorted(set(historical) - set(expected_inputs))
    if historical_unknown:
        raise CouldNotEvaluate(
            "historical_input_unknown",
            "not in expected.inputs: {}".format(", ".join(historical_unknown)),
        )
    historical_shas = {}
    if historical:
        verify_repo(lane)
        anchor_label, anchor_commit = resolve_historical_anchor(lane)
        for rev in sorted(set(historical.values())):
            resolve_historical_rev(lane, rev, anchor_label, anchor_commit)
        for canonical in sorted(historical):
            check_historical_waiver(
                lane,
                canonical,
                expected_inputs[canonical],
                anchor_label,
                anchor_commit,
            )
    for canonical in sorted(expected_inputs):
        if canonical in historical:
            data = historical_blob(lane, historical[canonical], canonical)
        else:
            path = safe_file(lane, canonical, "expected_input")
            data = read_regular(path, "expected_input")
        actual = sha256_bytes(data)
        if actual != expected_inputs[canonical]:
            raise CouldNotEvaluate(
                "expected_input_digest_mismatch",
                "{}: observed {} expects {}".format(canonical, actual, expected_inputs[canonical]),
            )
        if canonical in historical:
            historical_shas[canonical] = actual

    receipt_maps, receipt_docs = load_receipts(used_receipts, input_bytes)
    records, findings, informational = evaluate_dispositions(
        checks,
        rows,
        expected_inputs,
        receipt_maps,
        receipt_docs,
        expected_rel,
    )

    exit_code = 1 if findings else 0
    status = "failed" if findings else "clean"
    payload = base_payload(status, exit_code)
    payload["root"] = str(lane)
    payload["dispositions"] = str(dispositions_file)
    payload["expected_file"] = expected_rel
    payload["counts"] = {
        "expected_checks": len(checks),
        "effective": sum(1 for record in records if record.get("state") == "effective"),
        "superseded": sum(1 for record in records if record.get("state") == "superseded"),
        "passed": sum(1 for record in records if record["outcome"] == "pass"),
        "failed": sum(
            1 for record in records if record["outcome"] in ("fail", "missing", "duplicate")
        ),
        "findings": len(findings),
    }
    payload["rows"] = records
    payload["findings"] = findings
    payload["informational"] = {"receipt_only_checks": informational}
    payload["inputs_verified"] = sorted(pinned)
    payload["expected_inputs_verified"] = sorted(expected_inputs)
    if schema == SCHEMA_V2:
        payload["supersedes"] = supersedes_rel
        payload["expected_inputs_historical"] = {
            canonical: historical[canonical] for canonical in sorted(historical)
        }
        payload["historical_text"] = [
            "HISTORICAL {} rev={} sha256={}".format(
                canonical, historical[canonical], historical_shas[canonical]
            )
            for canonical in sorted(historical)
        ]
    return emit_result(payload, as_json)


# ------------------------------------------------------------------- selftest

SELFTEST_ORACLE_PY = b"# tameshi round-14 oracle fixture (never executed)\n"
SELFTEST_FIXTURE_INPUT = b"pinned-input\n"
SELFTEST_TOOL_REL = "tools/pinned-tool.py"
SELFTEST_TOOL_V1 = b"# pinned tool fixture v1\n"
SELFTEST_TOOL_V2 = b"# pinned tool fixture v2 (drifted live)\n"
SELFTEST_TOOL_OTHER = b"# pinned tool fixture other rev (unexpected bytes)\n"
SELFTEST_TOOL_CRLF = b"#!/bin/sh\r\necho crlf-fixture\r\n"
SELFTEST_V1_REL = "docs/v1-manifest.json"
SELFTEST_V1_DOC = b'{"schema": "evidence-dispositions-v1"}\n'


def _json_bytes(value):
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")


def _write_bytes(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(payload)


def _sha(payload):
    return sha256_bytes(payload)


def _build_lane(lane, marker, variant):
    lane.mkdir(parents=True, exist_ok=True)
    evidence = lane / ".ufo" / "evidence" / "round-13"
    evidence.mkdir(parents=True, exist_ok=True)
    fixture_input = lane / "fixtures" / "input.txt"
    _write_bytes(fixture_input, SELFTEST_FIXTURE_INPUT)
    tool_bytes = variant.get("tool_bytes", SELFTEST_TOOL_V1)
    _write_bytes(lane / "tools" / "pinned-tool.py", tool_bytes)
    oracle_py = evidence / "producer-oracle.py"
    _write_bytes(oracle_py, SELFTEST_ORACLE_PY)
    oracle_input_digest = _sha(SELFTEST_ORACLE_PY)

    expected_checks = {
        "alpha": {"exit": 0, "contains": "ALPHA_OK"},
        "beta": {"exit": 1, "id": "beta_bad", "reason": "beta_reason"},
        "gamma": {"exit": 0, "contains": "GAMMA_OK", "id": "gamma_ok", "reason": "ok"},
        "pin_live": {
            "exit": 0,
            "rows": 2,
            "statuses": {"changed": 1, "unchanged": 1, "unavailable": 0},
            "result_reuse": "not_established",
        },
        "producer_before": {"exit": 1, "contains": "kind FAIL"},
        "producer_before_oracle": {"exit": 1, "contains": "kind FAIL"},
        "producer_after_oracle": {"exit": 0, "contains": "41/41 pass"},
    }
    for name, override in variant.get("expected_checks", {}).items():
        expected_checks[name] = override

    expected = {
        "schema": "tameshi-round13-evidence-v1",
        "baseline": "0" * 40,
        "inputs": {
            "fixtures/input.txt": _sha(SELFTEST_FIXTURE_INPUT),
            ".ufo/evidence/round-13/producer-oracle.py": oracle_input_digest,
            "tools/pinned-tool.py": _sha(tool_bytes),
        },
        "expected_checks": expected_checks,
    }
    expected_bytes = _json_bytes(expected)
    _write_bytes(evidence / "expected.json", expected_bytes)

    alpha_exit = variant.get("alpha_exit", 0)
    alpha_stdout = variant.get("alpha_stdout", "ALPHA_OK\n")
    verification_checks = [
        {
            "name": "alpha",
            "argv": ["python3", "-c", "print('ALPHA_OK')"],
            "exit": alpha_exit,
            "stdout": alpha_stdout,
            "stderr": "",
        },
        {
            "name": "beta",
            "argv": ["python3", "-c", "raise SystemExit(1)"],
            "exit": 1,
            "stdout": json.dumps(
                {
                    "id": variant.get("beta_id", "beta_bad"),
                    "reason": variant.get("beta_reason", "beta_reason"),
                    "exit": 1,
                }
            )
            + "\n",
            "stderr": "",
        },
        {
            "name": "gamma",
            "argv": ["python3", "-c", "raise SystemExit(0)"],
            "exit": 0,
            "stdout": json.dumps(
                {"id": "gamma_ok", "reason": "ok", "exit": 0, "marker": "GAMMA_OK"}
            )
            + "\n",
            "stderr": "",
        },
        {
            "name": "pin_live",
            "argv": ["python3", "tools/pin-disposition.py", "--manifest", "fixture"],
            "exit": 0,
            "stdout": json.dumps(
                {
                    "counts": variant.get(
                        "pin_counts",
                        {"legs": 2, "changed": 1, "unchanged": 1, "unavailable": 0},
                    ),
                    "legs": variant.get(
                        "pin_legs",
                        [
                            {
                                "leg": "a",
                                "content_status": "changed",
                                "result_reuse": "not_established",
                            },
                            {
                                "leg": "b",
                                "content_status": "unchanged",
                                "result_reuse": "not_established",
                            },
                        ],
                    ),
                    "result_reuse": variant.get("pin_result_reuse", "not_established"),
                }
            )
            + "\n",
            "stderr": "",
        },
        {
            "name": "producer_before",
            "argv": ["python3", ".ufo/evidence/round-13/producer-before.py", "selftest"],
            "exit": variant.get("producer_before_exit", 1),
            "stdout": variant.get("producer_before_stdout", "  check something ok\n"),
            "stderr": "Traceback (most recent call last):\nFileNotFoundError\n",
        },
        {
            "name": "argv_marker",
            "argv": ["sh", "-c", "touch " + str(marker)],
            "exit": 0,
            "stdout": "",
            "stderr": "",
        },
    ]
    if variant.get("duplicate_alpha_check"):
        verification_checks.append(
            {
                "name": "alpha",
                "argv": ["python3", "-c", "print('ALPHA_OK')"],
                "exit": 0,
                "stdout": "ALPHA_OK\n",
                "stderr": "",
            }
        )
    if variant.get("drop_producer_before_check"):
        verification_checks = [
            check for check in verification_checks if check["name"] != "producer_before"
        ]
    verification = {
        "schema": "tameshi-round13-verification-v1",
        "checks": verification_checks,
    }
    verification_bytes = _json_bytes(verification)
    _write_bytes(evidence / "verification.json", verification_bytes)

    oracle_checks = [
        {
            "name": "producer_before_oracle",
            "argv": ["python3", "producer-oracle.py", "--source", "producer-before.py"],
            "exit": 1,
            "stdout": variant.get(
                "oracle_before_stdout",
                "  check summary preserves top-level exposed declaration kind FAIL\n",
            ),
            "stderr": "",
        },
        {
            "name": "producer_after_oracle",
            "argv": ["python3", "producer-oracle.py", "--source", "bash-witness-study.py"],
            "exit": 0,
            "stdout": variant.get(
                "oracle_after_stdout",
                "  check summary preserves top-level exposed declaration kind ok\n"
                "WITNESS_SELFTEST: 41/41 pass\n",
            ),
            "stderr": "",
        },
    ]
    oracle_checks.extend(variant.get("extra_oracle_checks", []))
    oracle = {
        "schema": "tameshi-round13-producer-oracle-repair-v1",
        "supersedes": variant.get(
            "oracle_supersedes",
            "verification.json producer_before: fixture crash is NOT red-before evidence",
        ),
        "oracle_sha256": oracle_input_digest,
        "checks": oracle_checks,
    }
    oracle_bytes = _json_bytes(oracle)
    _write_bytes(evidence / "producer-oracle-repair.json", oracle_bytes)

    return {
        "lane": lane,
        "expected_rel": ".ufo/evidence/round-13/expected.json",
        "ver_rel": ".ufo/evidence/round-13/verification.json",
        "oracle_rel": ".ufo/evidence/round-13/producer-oracle-repair.json",
        "fixture_rel": "fixtures/input.txt",
        "tool_rel": SELFTEST_TOOL_REL,
    }


def _effective(name, receipt_rel, check=None):
    return {
        "name": name,
        "state": "effective",
        "receipt": receipt_rel,
        "check": check or name,
    }


def _superseded(name, reason, replacements, raw_receipt, raw_check):
    return {
        "name": name,
        "state": "superseded",
        "reason": reason,
        "raw_receipt": raw_receipt,
        "raw_check": raw_check,
        "superseded_by": replacements,
    }


def _rows(fx, producer_state="superseded", **variant):
    ver = fx["ver_rel"]
    oracle = fx["oracle_rel"]
    rows = [
        _effective("alpha", ver),
        _effective("beta", ver),
        _effective("gamma", ver, variant.get("gamma_check", "gamma")),
        _effective("pin_live", ver),
    ]
    if producer_state == "effective":
        rows.append(_effective("producer_before", ver))
    else:
        rows.append(
            _superseded(
                "producer_before",
                variant.get(
                    "reason",
                    "raw path-layout crash before the kind assertion; exit1 records a setup failure",
                ),
                variant.get(
                    "replacements",
                    ["producer_before_oracle", "producer_after_oracle"],
                ),
                variant.get("raw_receipt", ver),
                variant.get("raw_check", "producer_before"),
            )
        )
    rows.extend(
        [
            _effective("producer_before_oracle", oracle),
            _effective("producer_after_oracle", oracle),
        ]
    )
    drop = set(variant.get("drop", ()))
    rows = [row for row in rows if row["name"] not in drop]
    rows.extend(variant.get("extra_rows", []))
    return rows


def _dispositions(fx, rows):
    lane = fx["lane"]
    inputs = {
        fx["expected_rel"]: _sha((lane / fx["expected_rel"]).read_bytes()),
        fx["ver_rel"]: _sha((lane / fx["ver_rel"]).read_bytes()),
        fx["oracle_rel"]: _sha((lane / fx["oracle_rel"]).read_bytes()),
    }
    return {
        "schema": "evidence-dispositions-v1",
        "expected_file": fx["expected_rel"],
        "inputs": inputs,
        "rows": rows,
    }


def _dispositions_v2(fx, rows, historical=None, supersedes_rel=None, pin_supersedes=True,
                     supersedes_doc=None):
    """v2 manifest: v1 fields plus `supersedes` and `historical_inputs`."""
    document = _dispositions(fx, rows)
    document["schema"] = SCHEMA_V2
    if supersedes_rel is not None:
        if supersedes_rel == SELFTEST_V1_REL:
            doc = supersedes_doc if supersedes_doc is not None else _dispositions(fx, rows)
            _write_bytes(fx["lane"] / SELFTEST_V1_REL, _json_bytes(doc))
        if pin_supersedes:
            document["inputs"][supersedes_rel] = _sha(
                (fx["lane"] / supersedes_rel).read_bytes()
            )
    document["supersedes"] = supersedes_rel
    document["historical_inputs"] = historical or {}
    return document


def _selftest_git_env():
    # Fixture git calls never inherit GIT_* (an exported GIT_DIR would commit
    # into a foreign repo) and never depend on the caller's global identity.
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_GLOBAL="/dev/null",
        GIT_AUTHOR_NAME="selftest",
        GIT_AUTHOR_EMAIL="selftest@invalid",
        GIT_COMMITTER_NAME="selftest",
        GIT_COMMITTER_EMAIL="selftest@invalid",
    )
    return env


def _git(lane, *argv):
    proc = subprocess.run(
        ["git", "-C", str(lane)] + list(argv),
        capture_output=True,
        timeout=30,
        env=_selftest_git_env(),
    )
    if proc.returncode != 0:
        raise RuntimeError(
            "git {} failed: {}".format(argv[0], _stderr_text(proc))
        )
    return proc.stdout


def _git_raw(argv):
    proc = subprocess.run(argv, capture_output=True, timeout=120, env=_selftest_git_env())
    if proc.returncode != 0:
        raise RuntimeError("{} failed: {}".format(argv, _stderr_text(proc)))
    return proc.stdout

def _jj(lane, *argv):
    env = _selftest_git_env()
    env["HOME"] = str(lane.parent)
    env["XDG_CONFIG_HOME"] = str(lane.parent / "jj-config")
    env.pop("JJ_CONFIG", None)
    proc = subprocess.run(
        ["jj"] + list(argv),
        cwd=str(lane),
        capture_output=True,
        timeout=120,
        env=env,
    )
    if proc.returncode != 0:
        raise RuntimeError("jj {} failed: {}".format(" ".join(argv), _stderr_text(proc)))
    return proc.stdout


def _git_head(lane):
    return _git(lane, "rev-parse", "HEAD").decode("ascii").strip()


def _git_commit_all(lane, message):
    _git(lane, "add", "-A")
    _git(
        lane,
        "-c",
        "user.email=selftest@example.invalid",
        "-c",
        "user.name=selftest",
        "commit",
        "-qm",
        message,
    )
    return _git_head(lane)


def _git_init_commit(lane, message="fixture commit"):
    _git(lane, "init", "-q")
    return _git_commit_all(lane, message)


def _setup_hist_clean(fx):
    """Pinned bytes at rev A, then the instrument move committed at HEAD."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "round-16 committed instrument move")
    fx["hist_rev"] = rev_a


def _setup_hist_other(fx):
    """Unexpected committed bytes at rev B (the declared historical rev)."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_OTHER)
    rev_b = _git_commit_all(lane, "unexpected committed bytes")
    fx["hist_rev"] = rev_b


def _setup_hist_unneeded(fx):
    """Live bytes still equal the pin: the waiver must be refused."""
    fx["hist_rev"] = _git_init_commit(fx["lane"], "round-13 pinned tools")


def _setup_hist_uncommitted(fx):
    """Worktree edit of a waived path, never committed."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    fx["hist_rev"] = rev_a


def _setup_hist_missing_object(fx):
    """Rev D deleted the path; HEAD later restored it as a moved tool."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    os.remove(lane / SELFTEST_TOOL_REL)
    rev_d = _git_commit_all(lane, "delete pinned tool")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "restore as a moved tool")
    fx["hist_rev"] = rev_d


def _setup_hist_dangling(fx):
    """A commit that exists but is not an ancestor of HEAD."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    tree = _git(lane, "rev-parse", "HEAD^{tree}").decode().strip()
    dangling = _git(lane, "commit-tree", tree, "-m", "forged: not on master").decode().strip()
    fx["hist_rev"] = dangling


def _setup_hist_tree(fx):
    """A tree object id is not a commit."""
    lane = fx["lane"]
    _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    fx["hist_rev"] = _git(lane, "rev-parse", "HEAD^{tree}").decode().strip()

def _setup_hist_tag(fx):
    """An annotated tag object peeling to an ancestor commit is not a commit id."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "round-16 committed instrument move")
    _git(lane, "tag", "-a", "selftest-pinned", "-m", "annotated pin", rev_a)
    fx["hist_rev"] = _git(
        lane, "rev-parse", "refs/tags/selftest-pinned"
    ).decode("ascii").strip()


def _setup_hist_symlink(fx):
    """A symlink blob whose link text equals the pin is not a regular tool blob."""
    lane = fx["lane"]
    tool = lane / SELFTEST_TOOL_REL
    tool.unlink()
    os.symlink(SELFTEST_TOOL_V1.decode("utf-8"), tool)
    rev_a = _git_init_commit(lane, "symlink-pinned tool")
    tool.unlink()
    _write_bytes(tool, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "regular moved tool")
    fx["hist_rev"] = rev_a


def _jj_init_fixture_repo(fx, record_lane_branch):
    lane = fx["lane"]
    _git(lane, "init", "-q", "-b", "master")
    rev_a = _git_commit_all(lane, "round-13 pinned tools")
    if record_lane_branch:
        _git(lane, "config", "lane.branch", "master")
    _jj(lane, "git", "init", "--colocate", ".")
    _jj(
        lane, "--ignore-working-copy", "config", "set", "--repo",
        "snapshot.auto-track", '"none()"',
    )
    _jj(lane, "--ignore-working-copy", "config", "set", "--repo", "user.name", "selftest")
    _jj(
        lane, "--ignore-working-copy", "config", "set", "--repo",
        "user.email", "selftest@example.invalid",
    )
    return rev_a


def _jj_commit_tool(lane, payload, message):
    _write_bytes(lane / SELFTEST_TOOL_REL, payload)
    _jj(lane, "file", "track", "--", SELFTEST_TOOL_REL)
    _jj(lane, "commit", "-m", message)
    return _jj(lane, "log", "--no-graph", "-r", "@-", "-T", "commit_id").decode(
        "ascii"
    ).strip()


def _setup_hist_jj_prebookmark(fx):
    """A JJ content commit moves HEAD while the lane bookmark still has old bytes."""
    lane = fx["lane"]
    rev_a = _jj_init_fixture_repo(fx, record_lane_branch=True)
    _jj(lane, "new", rev_a)
    _jj_commit_tool(lane, SELFTEST_TOOL_V2, "waived tool move")
    head = _git_head(lane)
    branch_tip = _git(lane, "rev-parse", "refs/heads/master").decode("ascii").strip()
    head_ref = subprocess.run(
        ["git", "-C", str(lane), "symbolic-ref", "-q", "HEAD"],
        capture_output=True,
        env=_selftest_git_env(),
        timeout=30,
    )
    if head_ref.returncode != 1 or head == branch_tip or branch_tip != rev_a:
        raise RuntimeError(
            "JJ pre-bookmark fixture mismatch: HEAD={}, master={}, HEAD-ref-exit={}".format(
                head, branch_tip, head_ref.returncode
            )
        )
    fx["hist_rev"] = rev_a


def _setup_hist_jj_branch_tip(fx):
    """A JJ HEAD at an older commit has a distinct branch tip containing the pin rev."""
    lane = fx["lane"]
    rev_a = _jj_init_fixture_repo(fx, record_lane_branch=True)
    _jj(lane, "new", rev_a)
    moved = _jj_commit_tool(lane, SELFTEST_TOOL_V2, "waived tool move")
    _jj(lane, "bookmark", "set", "master", "-r", moved)
    historical = _jj_commit_tool(lane, SELFTEST_TOOL_V1, "pinned input revision")
    branch_tip = _jj_commit_tool(lane, SELFTEST_TOOL_V2, "branch-tip tool move")
    _jj(lane, "bookmark", "set", "master", "-r", branch_tip)
    _jj(lane, "--ignore-working-copy", "edit", historical)
    head = _git_head(lane)
    actual_tip = _git(lane, "rev-parse", "refs/heads/master").decode("ascii").strip()
    head_ref = subprocess.run(
        ["git", "-C", str(lane), "symbolic-ref", "-q", "HEAD"],
        capture_output=True,
        env=_selftest_git_env(),
        timeout=30,
    )
    if head_ref.returncode != 1 or head == actual_tip or actual_tip != branch_tip:
        raise RuntimeError(
            "JJ branch-tip fixture mismatch: HEAD={}, master={}, HEAD-ref-exit={}".format(
                head, actual_tip, head_ref.returncode
            )
        )
    if _git(lane, "show", "HEAD:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V2:
        raise RuntimeError("JJ HEAD fixture does not carry the moved tool bytes")
    if _git(lane, "show", "refs/heads/master:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V2:
        raise RuntimeError("JJ branch tip does not carry the moved tool bytes")
    if _git(lane, "show", historical + ":" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V1:
        raise RuntimeError("JJ historical fixture does not carry the pinned bytes")
    fx["hist_rev"] = historical


def _setup_hist_jj_unbound(fx):
    """A detached colocated JJ workspace without lane.branch has no anchor."""
    lane = fx["lane"]
    rev_a = _jj_init_fixture_repo(fx, record_lane_branch=False)
    _git(lane, "checkout", "--detach", rev_a)
    fx["hist_rev"] = rev_a


def _setup_hist_registry_clone(fx):
    """A detached harness clone anchors at HEAD, not its later remote tip."""
    lane = fx["lane"]
    _git(lane, "init", "-q", "-b", "master")
    pin_rev = _git_commit_all(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    checked_out_rev = _git_commit_all(lane, "registry checked-out rev")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_OTHER)
    _git_commit_all(lane, "waived tool moved after checked-out rev")

    source = lane.parent / (lane.name + "-source")
    os.rename(str(lane), str(source))
    _git_raw(
        ["git", "clone", "--no-hardlinks", "--quiet", str(source), str(lane)]
    )
    _git(lane, "checkout", "--quiet", "--detach", checked_out_rev)
    _git(lane, "branch", "-D", "master")
    if _git(lane, "show", "HEAD:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_V2:
        raise RuntimeError("registry clone HEAD does not carry checked-out tool bytes")
    if _git(lane, "show", "refs/remotes/origin/master:" + SELFTEST_TOOL_REL) != SELFTEST_TOOL_OTHER:
        raise RuntimeError("registry clone remote tip does not carry later tool bytes")
    fx["hist_rev"] = pin_rev


def _setup_hist_no_published_ref(fx):
    """Detached non-jj HEAD without a containing ref is unavailable."""
    lane = fx["lane"]
    _git(lane, "init", "-q", "-b", "master")
    rev_a = _git_commit_all(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    tip = _git_commit_all(lane, "committed instrument move")
    _git(lane, "checkout", "--detach", tip)
    _git(lane, "branch", "-D", "master")
    fx["hist_rev"] = rev_a

def _setup_hist_replace(fx):
    """A replace ref rewrites HEAD; only GIT_NO_REPLACE_OBJECTS restores truth."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    fake_tree = _git(lane, "rev-parse", rev_a + "^{tree}").decode().strip()
    fake = _git(lane, "commit-tree", fake_tree, "-m", "replace fake").decode().strip()
    _git(lane, "replace", "HEAD", fake)
    fx["hist_rev"] = rev_a


def _setup_committed_deletion(fx):
    """Pinned bytes at rev A; HEAD holds a committed deletion of the path."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "round-13 pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_V2)
    _git_commit_all(lane, "committed instrument move")
    os.remove(lane / SELFTEST_TOOL_REL)
    _git_commit_all(lane, "committed deletion of the moved tool")
    fx["hist_rev"] = rev_a


def _setup_gitdir_env(fx):
    """A foreign GIT_DIR/GIT_WORK_TREE exported into the tool's environment."""
    _setup_hist_clean(fx)
    lane = fx["lane"]
    foreign = lane.parent / (lane.name + "-foreign")
    _write_bytes(foreign / "seed.txt", b"foreign\n")
    _git_init_commit(foreign, "foreign repo")
    fx["env_extra"] = {
        "GIT_DIR": str(foreign / ".git"),
        "GIT_WORK_TREE": str(lane),
    }


def _setup_shallow(fx):
    """A shallow clone: historical blobs are not provable."""
    lane = fx["lane"]
    src = lane.parent / (lane.name + "-src")
    os.rename(str(lane), str(src))
    rev = _git_init_commit(src, "shallow source")
    _git_raw(["git", "clone", "--depth", "1", "--quiet", "file://" + str(src), str(lane)])
    fx["hist_rev"] = rev


def _setup_crlf(fx):
    """Pinned CRLF bytes at rev A; HEAD holds different committed bytes."""
    lane = fx["lane"]
    rev_a = _git_init_commit(lane, "crlf pinned tools")
    _write_bytes(lane / SELFTEST_TOOL_REL, SELFTEST_TOOL_OTHER)
    _git_commit_all(lane, "committed instrument move")
    fx["hist_rev"] = rev_a


def _status_for(exit_code):
    return {0: "clean", 1: "failed", 2: "could_not_evaluate"}.get(exit_code)


def selftest():
    """Isolated /tmp fixtures; invokes this CLI via subprocess only."""
    scratch = Path(tempfile.mkdtemp(prefix="tameshi-r14-evidence-disposition-selftest.", dir="/tmp"))
    marker = scratch / "argv-marker"
    passed = 0
    failed = []

    def record(name, ok, detail):
        nonlocal passed
        if ok:
            passed += 1
            print("SELFTEST_CASE {} PASS ({})".format(name, detail))
        else:
            failed.append(name)
            print("SELFTEST_CASE {} FAIL ({})".format(name, detail))

    def run_cli(lane, dispositions_path, env_extra=None):
        env = None
        if env_extra:
            env = dict(os.environ)
            env.update(env_extra)
        return subprocess.run(
            [
                sys.executable,
                SELF,
                "--root",
                str(lane),
                "--dispositions",
                str(dispositions_path),
                "--json",
            ],
            capture_output=True,
            text=True,
            timeout=120,
            env=env,
            cwd=str(lane),
        )

    def case(name, expected_exit, expected_ids, variant=None, rows_kwargs=None,
             rows_override=None, raw_dispositions=None, mutate=None,
             informational_checks=None, git_setup=None):
        lane = scratch / ("case-" + name)
        try:
            fx = _build_lane(lane, marker, variant or {})
            if git_setup is not None:
                git_setup(fx)
            rows = rows_override if rows_override is not None else _rows(fx, **(rows_kwargs or {}))
            if raw_dispositions is not None:
                produced = raw_dispositions(fx)
                dispositions_bytes = (
                    produced if isinstance(produced, (bytes, bytearray)) else _json_bytes(produced)
                )
            else:
                dispositions_bytes = _json_bytes(_dispositions(fx, rows))
            dispositions_path = lane / ".ufo" / "evidence" / "round-13" / "dispositions.json"
            _write_bytes(dispositions_path, dispositions_bytes)
            if mutate is not None:
                mutate(fx)
            proc = run_cli(lane, dispositions_path, fx.get("env_extra"))
        except Exception as exc:  # fixture setup or process failure
            record(name, False, "setup/process error: {}: {}".format(type(exc).__name__, exc))
            return
        checks = [(proc.returncode == expected_exit, "exit={} expects={}".format(proc.returncode, expected_exit))]
        payload = None
        try:
            payload = json.loads(proc.stdout)
        except ValueError:
            checks.append((False, "stdout is not JSON: {!r}".format(proc.stdout[:200])))
        if payload is not None:
            ids = sorted(finding["id"] for finding in payload.get("findings", []))
            checks.append((ids == sorted(expected_ids), "ids={!r} expects={!r}".format(ids, sorted(expected_ids))))
            checks.append((payload.get("exit") == expected_exit, "payload exit={!r}".format(payload.get("exit"))))
            checks.append(
                (
                    payload.get("status") == _status_for(expected_exit),
                    "status={!r} expects={!r}".format(payload.get("status"), _status_for(expected_exit)),
                )
            )
            if informational_checks is not None:
                observed = sorted(
                    item["check"] for item in payload.get("informational", {}).get("receipt_only_checks", [])
                )
                checks.append((observed == sorted(informational_checks), "informational={!r}".format(observed)))
        ok = all(flag for flag, _detail in checks)
        detail = "{} literal checks".format(len(checks)) if ok else "; ".join(
            detail for flag, detail in checks if not flag
        )
        record(name, ok, detail)

    def historical_case(name, expected_exit, expected_ids, git_setup):
        case(
            name,
            expected_exit,
            expected_ids,
            git_setup=git_setup,
            raw_dispositions=lambda fx: _dispositions_v2(
                fx,
                _rows(fx),
                historical=_hist(
                    fx, {SELFTEST_TOOL_REL: {"rev": None, "reason": hist_reason}}
                ),
                supersedes_rel=SELFTEST_V1_REL,
