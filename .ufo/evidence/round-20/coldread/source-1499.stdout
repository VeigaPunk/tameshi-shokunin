SOURCE .ufo/evidence/round-12/BashWitness/rerun-20261020T035435Z/summary.json sha256=6726421fde88e8d2aff4c9d0ff4a4fdce9b1d4651da50b89f2bf29f65a22a5f0
{
  "study": "bash-witness-study",
  "seat": "BashWitness",
  "round": "round-12",
  "leg": "bash-surface-census",
  "generated_at": "2026-10-20T03:54:47Z",
  "status": "complete",
