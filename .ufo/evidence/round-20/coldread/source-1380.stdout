#
@defect G1 | unknown argument fail-open — exit 2 -> 0  # predict S (hole)
@old     *) printf 'checklist-run: unknown argument: %s\\n' "$1" >&2; exit 2 ;;
@new     *) printf 'checklist-run: unknown argument: %s\\n' "$1" >&2; exit 0 ;;
EOT
