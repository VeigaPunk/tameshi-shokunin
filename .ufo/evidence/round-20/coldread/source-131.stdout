@new ((hits > 2)) && defect "DUPLICATE-ITEM
#
@defect D1 | floor_of truncates instead of ceiling (odd item counts)  # predict S (hole)
@old floor_of() { printf '%s' "$(((($1 + FLOOR_DEN - 1)) / FLOOR_DEN))"; }
@new floor_of() { printf '%s' "$((($1) / FLOOR_DEN))"; }
#
