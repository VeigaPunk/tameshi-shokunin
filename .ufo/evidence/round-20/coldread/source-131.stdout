@old     [[ "$exexit" =~ ^[0-9]+(\\|[0-9]+)*$ ]]
@new     [[ "$exexit" =~ ^[0-9]+$ ]]
#
@defect C1 | UNMATCHED-ITEM never reported (condition 0 -> -1)  # predict S (hole)
@old ((hits == 0)) && defect "UNMATCHED-ITEM
@new ((hits == -1)) && defect "UNMATCHED-ITEM
#
