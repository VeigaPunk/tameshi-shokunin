@old FLOOR_DEN=2   # floor = ceil(items / FLOOR_DEN)
@new FLOOR_DEN=1   # floor = ceil(items / FLOOR_DEN)
#
@defect E1 | exit-set membership becomes exact equality (A|B arms never accepted)  # predict K
@old       [[ "|$want|" == *"|$rc|"* ]] || {
@new       [[ "$want" == "$rc" ]] || {
#
