      "valid_attribution": false,
      "enters_witness_rate": false,
      "enters_aggregate_rate": false,
      "epistemic_status": "Attribution rejected: baseline exhibits exit or stream divergence. Failure cannot be distinguished from ambient harness instability."
    },
    {
      "c1_finding": "controls_mismatch",
      "c1_exit": 1,
      "c2_outcome": "survived",
      "joint_verdict": "FRAGILE_SURVIVOR",
      "valid_attribution": false,
      "enters_witness_rate": false,
      "enters_aggregate_rate": false,
      "epistemic_status": "Unreliable survival: baseline is unstable. Suite passing is conditional on non-deterministic state."
    },
    {
      "c1_finding": "controls_mismatch",
      "c1_exit": 1,
      "c2_outcome": "inconclusive",
      "joint_verdict": "UNSTABLE_INCONCLUSIVE",
